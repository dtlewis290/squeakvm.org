#!/bin/sh
#
# Thu Aug 22 19:11:27 EDT 2019 dtl
# The portable Squeak VM sources have traditionally been maintained in
# a Subversion repository at squeakvm.org. The version string used for
# identifying a compiled VM is derived partly from the version level
# of the source files. In a Subversion repository, this version level
# is identified using the "svn info" command. As of this writing, the
# current and latest version in the repository is revision 3772.
#
# If the sources are converted from the Subversion master repository
# to a git repository, the Subversion revision number is no longer
# available. This script attempts to synthesize a version number based
# that matches revision 3772 at that commit level, and that increments
# the version number by one for each additional commit to the git master
# branch.
#
# Assumptions:
#   - The git repository is on the master branch.
#   - The git repository is up to date with Subversion revision 3772.
#   - Subversion revision 3772 corresponds to git commit count 2294.
#   - No attempt will be made to synchronized Subversion and git beyond 3772.
#   - If subsequent commits are made to Subversion and git, the version
#     numbers will be inconsistent, and this script will need to be
#     updated accordingly.
#

baselineSubversionRevisionNumber=3772
baselineGitCommitCount=2294
offsetAtSyncPoint=`echo ${baselineSubversionRevisionNumber} - ${baselineGitCommitCount} | bc`

if ! test ${unix}
then
    # Assume this script is in platforms/unix/cmake
    unix=`dirname $0`/..
fi

if test -d ${unix}/../../.git
then
    # This is a git repository
    commits=`git log --oneline | wc -l`
    svnversion=`echo ${commits} + ${offsetAtSyncPoint} | bc`
    echo "${svnversion}" > "${unix}/svnversion"
elif test -d "${unix}/../.svn" -o -d "${unix}/../../.svn"; then
    # This is a Subversion repository
    echo SUBVERSION
    svnversion=`svn info "${unix}/ChangeLog" | fgrep Revision: | awk '{print $2}'`
    echo "${svnversion}" > "${unix}/svnversion"
else
    # This is a copy of the platform sources, with no .git or .svn
    # metadata. Someone has previously saved the version number in
    # a file.
    svnversion=`cat "${unix}/svnversion"`
fi

echo $svnversion

