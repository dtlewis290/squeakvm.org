teAt: i)) 				bitAnd: 255) + 1) bitXor: (newCrc bitShift: -8).	].	^newCrc! !!Trait method!updateCrc: oldCrc from: start to: stop in: aCollection	| newCrc |	<primitive: 'primitiveUpdateGZipCrc32' module: 'ZipPlugin'>	newCrc := oldCrc.	start to: stop do:[:i|		newCrc := (self crcTable at: ((newCrc bitXor: (aCollection byteAt: i)) 				bitAnd: 255) + 1) bitXor: (newCrc bitShift: -8).	].	^newCrc! !!Trait method!updateCrc: oldCrc from: start to: stop in: aCollection	| newCrc |	<primitive: 'primitiveUpdateGZipCrc32' module: 'ZipPlugin'>	newCrc := oldCrc.	start to: stop do:[:i|		newCrc := (self crcTable at: ((newCrc bitXor: (aCollection byteAt: i)) 				bitAnd: 255) + 1) bitXor: (newCrc bitShift: -8).	].	^newCrc! !!Trait method!byteStream	self requirement! !!Trait method!writeArray: anArray	"PRIVATE -- Write the contents of an Array."	self byteStream nextNumber: 4 put: anArray size.	self nextPutAll: anArray.! !!Trait method!writeBitmap: aBitmap	"PRIVATE -- Write the contents of a Bitmap."	aBitmap writeOn: self byteStream	"Note that this calls (byteStream nextPutAll: aBitmap) which knows enough to put 4-byte quantities on the stream!!  Reader must know that size is in long words."! !!Trait method!writeBoolean: aBoolean    "PRIVATE -- Write the contents of a Boolean.     This method is now obsolete."    self  byteStream nextPut: (aBoolean ifTrue: [1] ifFalse: [0])! !!Trait method!writeByteArray: aByteArray	"PRIVATE -- Write the contents of a ByteArray."	self byteStream nextNumber: 4 put: aByteArray size.	"May have to convert types here..."	self byteStream nextPutAll: aByteArray.! !!Trait method!writeClass: aClass	"Write out a DiskProxy for the class.  It will look up the class's name in Smalltalk in the new sustem.  Never write classes or methodDictionaries as objects.  For novel classes, front part of file is a fileIn of the new class."	"This method never executed because objectToStoreOnDataStream returns a DiskProxy.  See DataStream.nextPut:"    ^ self error: 'Write a DiskProxy instead'! !!Trait method!writeFalse: aFalse    "PRIVATE -- Write the contents of a False."! !!Trait method!writeFloat: aFloat	"PRIVATE -- Write the contents of a Float.	  We support 8-byte Floats here."	self byteStream nextNumber: 4 put: (aFloat at: 1).	self byteStream nextNumber: 4 put: (aFloat at: 2).! !!Trait method!writeFloatString: aFloat    "PRIVATE -- Write the contents of a Float string.     This is the slow way to write a Float--via its string rep'n."    self writeByteArray: (aFloat printString)! !!Trait method!writeInstance: anObject    "PRIVATE -- Write the contents of an arbitrary instance."    ^ anObject storeDataOn: self! !!Trait method!writeInteger: anInteger	"PRIVATE -- Write the contents of a SmallInteger."	self byteStream nextInt32Put: anInteger	"signed!!!!!!!!!!"! !!Trait method!writeNil: anUndefinedObject    "PRIVATE -- Write the contents of an UndefinedObject."! !!Trait method!writeRectangle: anObject    "Write the contents of a Rectangle.  See if it can be a compact Rectangle (type=15).  Rectangles with values outside +/- 2047 were stored as normal objects (type=9).  17:22 tk"	| ok right bottom top left acc |	ok := true.	(right := anObject right) > 2047 ifTrue: [ok := false].	right < -2048 ifTrue: [ok := false].	(bottom := anObject bottom) > 2047 ifTrue: [ok := false].	bottom < -2048 ifTrue: [ok := false].	(top := anObject top) > 2047 ifTrue: [ok := false].	top < -2048 ifTrue: [ok := false].	(left := anObject left) > 2047 ifTrue: [ok := false].	left < -2048 ifTrue: [ok := false].	ok := ok & left isInteger & right isInteger & top isInteger & bottom isInteger.	ok ifFalse: [		self byteStream skip: -1; nextPut: 9; skip: 0. "rewrite type to be normal instance"	    ^ anObject storeDataOn: self].	acc := ((left bitAnd: 16rFFF) bitShift: 12) + (top bitAnd: 16rFFF).	self byteStream nextNumber: 3 put: acc.	acc := ((right bitAnd: 16rFFF) bitShift: 12) + (bottom bitAnd: 16rFFF).	self byteStream nextNumber: 3 put: acc.! !!Trait method!writeString: aString	"PRIVATE -- Write the contents of a String."	self byteStream nextStringPut: aString.! !!Trait method!writeStringOld: aString	"PRIVATE -- Write the contents of a String."	| length |	aString size < 16384 		ifTrue: [			(length := aString size) < 192				ifTrue: [self byteStream nextPut: length]				ifFalse: 					[self byteStream nextPut: (length // 256 + 192).					self byteStream nextPut: (length \\ 256)].			aString do: [:char | self byteStream nextPut: char asciiValue]]		ifFalse: [self writeByteArray: aString].	"takes more space"! !!Trait method!writeSymbol: aSymbol    "PRIVATE -- Write the contents of a Symbol."    self writeString: aSymbol! !!Trait method!writeTrue: aTrue    "PRIVATE -- Write the contents of a True."! !!Trait method!writeUser: anObject    "Write the contents of an arbitrary User instance (and its devoted class)."    " 7/29/96 tk"	"If anObject is an instance of a unique user class, will lie and say it has a generic class"    ^ anObject storeDataOn: self! !!Trait method!writeWordLike: aWordArray	"Note that we put the class name before the size."	self nextPut: aWordArray class name.	aWordArray writeOn: self byteStream	"Note that this calls (byteStream nextPutAll: aBitmap) which knows enough to put 4-byte quantities on the stream!!  Reader must know that size is in long words or double-bytes."! !!Trait method!binary" switch to binary mode "self explicitRequirement! !!Trait method!binary" switch to binary mode "self explicitRequirement! !!Trait method!fileOutChangeSet: aChangeSetOrNil andObject: theObject	"Write a file that has both the source code for the named class and an object as bits.  Any instance-specific object will get its class written automatically."	"An experimental version to fileout a changeSet first so that a project can contain its own classes"	self setFileTypeToObject.		"Type and Creator not to be text, so can attach correctly to an email msg"	self header; timeStamp.	aChangeSetOrNil ifNotNil: [		aChangeSetOrNil fileOutPreambleOn: self.		aChangeSetOrNil fileOutOn: self.		aChangeSetOrNil fileOutPostscriptOn: self.	].	self trailer.	"Does nothing for normal files.  HTML streams will have trouble with object data"	"Append the object's raw data"	(NSSmartRefStream on: self)		nextPut: theObject;  "and all subobjects"		close.		"also closes me"! !!Trait method!fileOutChangeSet: aChangeSetOrNil andObject: theObject	"Write a file that has both the source code for the named class and an object as bits.  Any instance-specific object will get its class written automatically."	"An experimental version to fileout a changeSet first so that a project can contain its own classes"	self setFileTypeToObject.		"Type and Creator not to be text, so can attach correctly to an email msg"	self header; timeStamp.	aChangeSetOrNil ifNotNil: [		aChangeSetOrNil fileOutPreambleOn: self.		aChangeSetOrNil fileOutOn: self.		aChangeSetOrNil fileOutPostscriptOn: self.	].	self trailer.	"Does nothing for normal files.  HTML streams will have trouble with object data"	"Append the object's raw data"	(NSSmartRefStream on: self)		nextPut: theObject;  "and all subobjects"		close.		"also closes me"! !!Trait method!fileOutChanges	"Append to the receiver a description of all class changes."	Cursor write showWhile:		[self header; timeStamp.		ChangeSet current fileOutOn: self.		self trailer; close]! !!Trait method!fileOutChanges	"Append to the receiver a description of all class changes."	Cursor write showWhile:		[self header; timeStamp.		ChangeSet current fileOutOn: self.		self trailer; close]! !!Trait method!fileOutClass: extraClass andObject: theObject	"Write a file that has both the source code for the named class and an object as bits.  Any instance-specific object will get its class written automatically."	| class srefStream |	self setFileTypeToObject.		"Type and Creator not to be text, so can attach correctly to an email msg"	self text.	self header; timeStamp.	extraClass ifNotNil: [		class := extraClass.	"A specific class the user wants written"		class hasSharedPools ifTrue:			[class shouldFileOutPools				ifTrue: [class fileOutSharedPoolsOn: self]].		class fileOutOn: self moveSource: false toFile: 0].	self trailer.	"Does nothing for normal files.  HTML streams will have trouble with object data"	self binary.	"Append the object's raw data"	srefStream := NSSmartRefStream on: self.	srefStream nextPut: theObject.  "and all subobjects"	srefStream close.		"also closes me"! !!Trait method!fileOutClass: extraClass andObject: theObject	"Write a file that has both the source code for the named class and an object as bits.  Any instance-specific object will get its class written automatically."	| class srefStream |	self setFileTypeToObject.		"Type and Creator not to be text, so can attach correctly to an email msg"	self text.	self header; timeStamp.	extraClass ifNotNil: [		class := extraClass.	"A specific class the user wants written"		class hasSharedPools ifTrue:			[class shouldFileOutPools				ifTrue: [class fileOutSharedPoolsOn: self]].		class fileOutOn: self moveSource: false toFile: 0].	self trailer.	"Does nothing for normal files.  HTML streams will have trouble with object data"	self binary.	"Append the object's raw data"	srefStream := NSSmartRefStream on: self.	srefStream nextPut: theObject.  "and all subobjects"	srefStream close.		"also closes me"! !!Trait method!fileOutClass: extraClass andObject: theObject blocking: anIdentDict	"Write a file that has both the source code for the named class and an object as bits.  Any instance-specific object will get its class written automatically.  Accept a list of objects to map to nil or some other object (blockers).  In addition to teh choices in each class's objectToStoreOnDataStream"	| class srefStream |	self setFileTypeToObject.		"Type and Creator not to be text, so can attach correctly to an email msg"	self header; timeStamp.	extraClass ifNotNil: [		class := extraClass.	"A specific class the user wants written"		class hasSharedPools ifTrue:			[class shouldFileOutPools				ifTrue: [class fileOutSharedPoolsOn: self]].		class fileOutOn: self moveSource: false toFile: 0].	self trailer.	"Does nothing for normal files.  HTML streams will have trouble with object data"	"Append the object's raw data"	srefStream := NSSmartRefStream on: self.	srefStream blockers: anIdentDict.	srefStream nextPut: theObject.  "and all subobjects"	srefStream close.		"also closes me"! !!Trait method!fileOutClass: extraClass andObject: theObject blocking: anIdentDict	"Write a file that has both the source code for the named class and an object as bits.  Any instance-specific object will get its class written automatically.  Accept a list of objects to map to nil or some other object (blockers).  In addition to teh choices in each class's objectToStoreOnDataStream"	| class srefStream |	self setFileTypeToObject.		"Type and Creator not to be text, so can attach correctly to an email msg"	self header; timeStamp.	extraClass ifNotNil: [		class := extraClass.	"A specific class the user wants written"		class hasSharedPools ifTrue:			[class shouldFileOutPools				ifTrue: [class fileOutSharedPoolsOn: self]].		class fileOutOn: self moveSource: false toFile: 0].	self trailer.	"Does nothing for normal files.  HTML streams will have trouble with object data"	"Append the object's raw data"	srefStream := NSSmartRefStream on: self.	srefStream blockers: anIdentDict.	srefStream nextPut: theObject.  "and all subobjects"	srefStream close.		"also closes me"! !!Trait method!header	"If the stream requires a standard header, override this message.  See HtmlFileStream"	self explicitRequirement ! !!Trait method!header	"If the stream requires a standard header, override this message.  See HtmlFileStream"	self explicitRequirement ! !!Trait method!setFileTypeToObject"On the Macintosh, set the file type and creator of this file to be a Squeak object file. On other platforms, do nothing. Setting the file type allows Squeak object files to be sent as email attachments and launched by double-clicking. On other platforms, similar behavior is achieved by creating the file with the '.sqo' file name extension."self explicitRequirement! !!Trait method!setFileTypeToObject"On the Macintosh, set the file type and creator of this file to be a Squeak object file. On other platforms, do nothing. Setting the file type allows Squeak object files to be sent as email attachments and launched by double-clicking. On other platforms, similar behavior is achieved by creating the file with the '.sqo' file name extension."self explicitRequirement! !!Trait method!trailer	"If the stream requires a standard trailer, override this message.  See HtmlFileStream"	self explicitRequirement ! !!Trait method!trailer	"If the stream requires a standard trailer, override this message.  See HtmlFileStream"	self explicitRequirement ! !!Trait method!copyMethodChunkFrom: aStream	"Copy the next chunk from aStream (must be different from the receiver)."	| chunk |	chunk := aStream nextChunkText.	chunk runs values size = 1 "Optimize for unembellished text"		ifTrue: [self nextChunkPut: chunk asString]		ifFalse: [self nextChunkPutWithStyle: chunk]! !!Trait method!copyMethodChunkFrom: aStream	"Copy the next chunk from aStream (must be different from the receiver)."	| chunk |	chunk := aStream nextChunkText.	chunk runs values size = 1 "Optimize for unembellished text"		ifTrue: [self nextChunkPut: chunk asString]		ifFalse: [self nextChunkPutWithStyle: chunk]! !!Trait method!copyMethodChunkFrom: aStream	"Copy the next chunk from aStream (must be different from the receiver)."	| chunk |	chunk := aStream nextChunkText.	chunk runs values size = 1 "Optimize for unembellished text"		ifTrue: [self nextChunkPut: chunk asString]		ifFalse: [self nextChunkPutWithStyle: chunk]! !!Trait method!copyMethodChunkFrom: aStream at: pos	"Copy the next chunk from aStream (must be different from the receiver)."	| chunk |	aStream position: pos.	chunk := aStream nextChunkText.	chunk runs values size = 1 "Optimize for unembellished text"		ifTrue: [self nextChunkPut: chunk asString]		ifFalse: [self nextChunkPutWithStyle: chunk]! !!Trait method!copyMethodChunkFrom: aStream at: pos	"Copy the next chunk from aStream (must be different from the receiver)."	| chunk |	aStream position: pos.	chunk := aStream nextChunkText.	chunk runs values size = 1 "Optimize for unembellished text"		ifTrue: [self nextChunkPut: chunk asString]		ifFalse: [self nextChunkPutWithStyle: chunk]! !!Trait method!copyMethodChunkFrom: aStream at: pos	"Copy the next chunk from aStream (must be different from the receiver)."	| chunk |	aStream position: pos.	chunk := aStream nextChunkText.	chunk runs values size = 1 "Optimize for unembellished text"		ifTrue: [self nextChunkPut: chunk asString]		ifFalse: [self nextChunkPutWithStyle: chunk]! !!Trait method!copyPreamble: preamble from: aStream at: pos	"Look for a changeStamp for this method by peeking backward.	Write a method preamble, with that stamp if found."	| terminator last50 stamp i |	terminator := $!!.	"Look back to find stamp in old preamble, such as...	Polygon methodsFor: 'private' stamp: 'di 6/25/97 21:42' prior: 34957598!! "	aStream position: pos.		aStream backChunk.				"to beginning of method"		last50 := aStream backChunk.	"to get preamble"	aStream position: pos.	stamp := String new.	(i := last50 findLastOccurrenceOfString: 'stamp:' startingAt: 1) > 0 ifTrue:		[stamp := (last50 copyFrom: i+8 to: last50 size) copyUpTo: $'].	"Write the new preamble, with old stamp if any."	self cr; nextPut: terminator.	self nextChunkPut: (String streamContents:		[:strm |		strm nextPutAll: preamble.		stamp size > 0 ifTrue:			[strm nextPutAll: ' stamp: '; print: stamp]]).	self cr! !!Trait method!copyPreamble: preamble from: aStream at: pos	"Look for a changeStamp for this method by peeking backward.	Write a method preamble, with that stamp if found."	| terminator last50 stamp i |	terminator := $!!.	"Look back to find stamp in old preamble, such as...	Polygon methodsFor: 'private' stamp: 'di 6/25/97 21:42' prior: 34957598!! "	aStream position: pos.		aStream backChunk.				"to beginning of method"		last50 := aStream backChunk.	"to get preamble"	aStream position: pos.	stamp := String new.	(i := last50 findLastOccurrenceOfString: 'stamp:' startingAt: 1) > 0 ifTrue:		[stamp := (last50 copyFrom: i+8 to: last50 size) copyUpTo: $'].	"Write the new preamble, with old stamp if any."	self cr; nextPut: terminator.	self nextChunkPut: (String streamContents:		[:strm |		strm nextPutAll: preamble.		stamp size > 0 ifTrue:			[strm nextPutAll: ' stamp: '; print: stamp]]).	self cr! !!Trait method!copyPreamble: preamble from: aStream at: pos	"Look for a changeStamp for this method by peeking backward.	Write a method preamble, with that stamp if found."	| terminator last50 stamp i |	terminator := $!!.	"Look back to find stamp in old preamble, such as...	Polygon methodsFor: 'private' stamp: 'di 6/25/97 21:42' prior: 34957598!! "	aStream position: pos.		aStream backChunk.				"to beginning of method"		last50 := aStream backChunk.	"to get preamble"	aStream position: pos.	stamp := String new.	(i := last50 findLastOccurrenceOfString: 'stamp:' startingAt: 1) > 0 ifTrue:		[stamp := (last50 copyFrom: i+8 to: last50 size) copyUpTo: $'].	"Write the new preamble, with old stamp if any."	self cr; nextPut: terminator.	self nextChunkPut: (String streamContents:		[:strm |		strm nextPutAll: preamble.		stamp size > 0 ifTrue:			[strm nextPutAll: ' stamp: '; print: stamp]]).	self cr! !!Trait method!crself explicitRequirement ! !!Trait method!cr	self nextPut: Character cr! !!Trait method!cr	self nextPut: Character cr! !!Trait method!nextChunkPut: aString	"Append the argument, aString, to the receiver, doubling embedded terminators."	| i remainder terminator |	terminator := $!!.	remainder := aString.	[(i := remainder indexOf: terminator) = 0] whileFalse:		[self nextPutAll: (remainder copyFrom: 1 to: i).		self nextPut: terminator.  "double imbedded terminators"		remainder := remainder copyFrom: i+1 to: remainder size].	self nextPutAll: remainder.	aString includesUnifiedCharacter ifTrue: [		self nextPut: terminator.		self nextPutAll: ']lang['.		aString writeLeadingCharRunsOn: self.	].	self nextPut: terminator.! !!Trait method!nextChunkPut: aString	"Append the argument, aString, to the receiver, doubling embedded terminators."	| i remainder terminator |	terminator := $!!.	remainder := aString.	[(i := remainder indexOf: terminator) = 0] whileFalse:		[self nextPutAll: (remainder copyFrom: 1 to: i).		self nextPut: terminator.  "double imbedded terminators"		remainder := remainder copyFrom: i+1 to: remainder size].	self nextPutAll: remainder.	aString includesUnifiedCharacter ifTrue: [		self nextPut: terminator.		self nextPutAll: ']lang['.		aString writeLeadingCharRunsOn: self.	].	self nextPut: terminator.! !!Trait method!nextChunkPut: aString	"Append the argument, aString, to the receiver, doubling embedded terminators."	| i remainder terminator |	terminator := $!!.	remainder := aString.	[(i := remainder indexOf: terminator) = 0] whileFalse:		[self nextPutAll: (remainder copyFrom: 1 to: i).		self nextPut: terminator.  "double imbedded terminators"		remainder := remainder copyFrom: i+1 to: remainder size].	self nextPutAll: remainder.	aString includesUnifiedCharacter ifTrue: [		self nextPut: terminator.		self nextPutAll: ']lang['.		aString writeLeadingCharRunsOn: self.	].	self nextPut: terminator.! !!Trait method!nextChunkPutWithStyle: aStringOrText	"Append the argument, aText, to the receiver, doubling embedded terminators.  Put out one chunk for the string and one for the style runs.  Mark the style with ]style[."	aStringOrText isString ifTrue: [^ self nextChunkPut: aStringOrText].	aStringOrText runs coalesce.	aStringOrText unembellished ifTrue: [^ self nextChunkPut: aStringOrText asString].	self nextChunkPut: aStringOrText asString.	self cr; nextPutAll: ']style['.	self nextChunkPut: 		(String streamContents: [:strm | 			aStringOrText runs writeScanOn: strm]).! !!Trait method!nextChunkPutWithStyle: aStringOrText	"Append the argument, aText, to the receiver, doubling embedded terminators.  Put out one chunk for the string and one for the style runs.  Mark the style with ]style[."	aStringOrText isString ifTrue: [^ self nextChunkPut: aStringOrText].	aStringOrText runs coalesce.	aStringOrText unembellished ifTrue: [^ self nextChunkPut: aStringOrText asString].	self nextChunkPut: aStringOrText asString.	self cr; nextPutAll: ']style['.	self nextChunkPut: 		(String streamContents: [:strm | 			aStringOrText runs writeScanOn: strm]).! !!Trait method!nextChunkPutWithStyle: aStringOrText	"Append the argument, aText, to the receiver, doubling embedded terminators.  Put out one chunk for the string and one for the style runs.  Mark the style with ]style[."	aStringOrText isString ifTrue: [^ self nextChunkPut: aStringOrText].	aStringOrText runs coalesce.	aStringOrText unembellished ifTrue: [^ self nextChunkPut: aStringOrText asString].	self nextChunkPut: aStringOrText asString.	self cr; nextPutAll: ']style['.	self nextChunkPut: 		(String streamContents: [:strm | 			aStringOrText runs writeScanOn: strm]).! !!Trait method!nextPut: anObjectself explicitRequirement ! !!Trait method!nextPut: atObjelr 	self requirement! !!Trait method!nextPut: atObjelr 	self requirement! !!Trait method!nextPutAll: aCollectionself explicitRequirement ! !!Trait method!nextPutAll: aCoiielrnot 	self requirement! !!Trait method!nextPutAll: aCoiielrnot 	self requirement! !!Trait method!timeStamp	"Append the current time to the receiver as a String."	self nextChunkPut:	"double string quotes and !!s"		(String streamContents: [:s | SmalltalkImage current timeStamp: s]) printString.	self cr! !!Trait method!timeStamp	"Append the current time to the receiver as a String."	self nextChunkPut:	"double string quotes and !!s"		(String streamContents: [:s | SmalltalkImage current timeStamp: s]) printString.	self cr! !!Trait method!timeStamp	"Append the current time to the receiver as a String."	self nextChunkPut:	"double string quotes and !!s"		(String streamContents: [:s | SmalltalkImage current timeStamp: s]) printString.	self cr! !"Nile-All"!"Nile-Base"!"Nile-Tests"!"Nile-Clients"!!AutomaticMethodCategorizer commentStamp: 'DF 9/10/2006 11:39' prior: 0!Instances of this class can be used to categorize methods in a class based on a set of rules.Example:myCategorizationRule := MethodCategorizationRule whenSelectorMatches: 'initialize*' categorizeIn: #initialization.(AutomaticMethodCategorizer using: myCategorizationRule) categorizeAllMethodsOf: MyClassSee also:AutomaticMethodCategorizerTest for more examplesAutomaticMethodCategorizer defaultCategorizationRules!!AutomaticMethodCategorizerApplier commentStamp: 'DF 9/10/2006 21:10' prior: 0!Instances of this class observes the changes notified by a SystemChangeNotifier and applies categories to methods using an instance of AutomaticMethodCategorizer.You can use this class to autocategorize methods after compilation.Example:AutomaticMethodCategorizerApplier install!!MethodCategoriesFinderBehavior commentStamp: 'DF 9/10/2006 21:11' prior: 0!This abstract class defines the protocol of an object that given a MethodReference returns a bagof the possible categories for that method.The returned bag contains categories and their occurrences (if it's applicable).!!FixedResultMethodCategoriesFinder commentStamp: 'DF 9/10/2006 11:58' prior: 0!Instances of this class always returns a given category for a method.!!SuperClassMethodCategoriesFinder commentStamp: 'DF 9/10/2006 12:10' prior: 0!Instances of this class returns all the categories found in the super-classes of a method.!!MethodCategorizationRuleBehavior commentStamp: 'DF 6/7/2006 21:26' prior: 0!This abstract class defines the protocol that must implement a rule to be used in the AutomaticMethodCategorizer.!!MethodCategorizationRule commentStamp: 'DF 9/10/2006 21:11' prior: 0!Instances of this class represents a categorization rule.This class is very flexible and can be used to define different rules, see the instance creation methods for examples.!!NullMethodCategorizationRule commentStamp: 'DF 6/7/2006 21:27' prior: 0!This is a null rule that does nothing.See also:Search on the web for "Null Object Pattern".!!ClassOrganizer methodsFor: '*AutomaticMethodCategorizer-testing' stamp: 'DF 9/10/2006 16:00'!hasCategoryFor: aSelector 	^(self subject selectors includes: aSelector) and: [(self uncategorizedSelectors includes: aSelector) not]! !!ClassOrganizer methodsFor: '*AutomaticMethodCategorizer-accessing' stamp: 'DF 9/10/2006 16:01'!uncategorizedSelectors	^self listAtCategoryNamed: self class default! !!OBCodeBrowser methodsFor: '*AutomaticMethodCategorizerOB-Model' stamp: 'DF 12/28/2007 13:49'!cmdAutoCategorizeWithAMC	^OBCmdAutoCategorizeWithAMC! !!OBCodeBrowser methodsFor: '*AutomaticMethodCategorizerOB-Model' stamp: 'DF 12/28/2007 13:35'!obsoleteAutoCategorizeCommand	^#cmdAutoCategorizeCat! !!AutomaticMethodCategorizer commentStamp: 'DF 9/10/2006 11:39' prior: 37601949!Instances of this class can be used to categorize methods in a class based on a set of rules.Example:myCategorizationRule := MethodCategorizationRule whenSelectorMatches: 'initialize*' categorizeIn: #initialization.(AutomaticMethodCategorizer using: myCategorizationRule) categorizeAllMethodsOf: MyClassSee also:AutomaticMethodCategorizerTest for more examplesAutomaticMethodCategorizer defaultCategorizationRules!!AutomaticMethodCategorizer class methodsFor: 'accessing' stamp: 'DF 1/7/2008 17:37'!categorizationRules	| rulesAccessSelector rulesGlobal rulesGlobalName |	rulesGlobalName := Preferences 		valueOfPreference: #rulesGlobalName		ifAbsent: self name.			rulesAccessSelector := Preferences 		valueOfPreference: #rulesAccessSelector		ifAbsent: #defaultCategorizationRules.			rulesGlobal := Smalltalk 		at: rulesGlobalName asSymbol		ifAbsent: [ self ].	^ rulesGlobal perform: rulesAccessSelector asSymbol! !!AutomaticMethodCategorizer class methodsFor: 'defaults' stamp: 'DF 9/11/2006 01:34'!defaultCategorizationRules	"The order is relevant, the categorizer uses the first rule matching - DF"	^OrderedCollection new		add: MethodCategorizationRule forAccessors;		add: (MethodCategorizationRule whenSelectorMatches: 'initialize*' categorizeIn: #initialization);		add: (MethodCategorizationRule whenSelectorMatches: 'is*' categorizeIn: #testing);		add: (MethodCategorizationRule whenSelectorMatches: 'has*' categorizeIn: #testing);		add: (MethodCategorizationRule whenSelectorMatches: '=' categorizeIn: #comparing);		add: (MethodCategorizationRule whenSelectorMatches: 'hash' categorizeIn: #comparing);		add: (MethodCategorizationRule whenSelectorMatches: 'default*' categorizeIn: #defaults);		add: (MethodCategorizationRule whenSelectorMatches: 'printOn:' categorizeIn: #printing);		add: (MethodCategorizationRule whenSelectorMatches: 'accept:' categorizeIn: #'visitor accepting');		add: (MethodCategorizationRule whenSelectorMatches: 'visit*:' categorizeIn: #visiting);		add: (MethodCategorizationRule whenSelectorMatches: 'value' categorizeIn: #evaluating);		add: (MethodCategorizationRule 					whenSelectorMatches: 'test*'					andClassInheritsFrom: TestCase					categorizeIn: #tests);		add: MethodCategorizationRule usingMostUsedCategoryInSuperClasses;		add: MethodCategorizationRule usingMostUsedCategoryInImage;		yourself! !!AutomaticMethodCategorizer class methodsFor: 'accessing' stamp: 'DF 1/7/2008 17:32'!firstInstallationInstructions	^ '"Hey!! thanks to load the automatic method categorizer ;-)This small tool allows you to categorize methods based on rules, i.e.: all methods beginning with ''test'' should go into the ''tests'' category.There are different ways to use to this tool:- Using Smalltalk code (useful for bulk re-categorization of methods). For examples, evaluate:"Browser newOnClass: AutomaticMethodCategorizerTest."- Installing a hook to detect changes and categorize uncategorized methods on save.To install the hook, evaluate:"AutomaticMethodCategorizerApplier install."This adds an observer for SystemChangeNotifier, so each time that a method is saved from a browser the categorizer is called.If you have any problem, you can remove that observer evaluating:"AutomaticMethodCategorizerApplier uninstall."- Using a browser compatible with the Services FrameworkYou need to install the AutomaticMethodCategorizerServices package.Then in the world menu select Preferences & Services and them Rebuild Services Registry.A new option to categorize methods should appear in the contextual menu for the categories panel.- Using OmnibrowserYou need to install the AutomaticMethodCategorizerOB package.Once installed the categorize automatically option is replaced with a new implementation that uses the categorization rules.To customize the categorization rules:1. Create a class method similar to: AutomaticMethodCategorizer class>>defaultCategorizationRulesFor example see: CategorizationRulesExample class.2. Then open the Preferences browser and modify the preferences rulesGlobalName andrulesAccessSelector under the ''method categorization'' category.  Diego Fernandezdiegof79@gmail.com"'! !!AutomaticMethodCategorizer class methodsFor: 'initialization' stamp: 'DF 1/7/2008 17:03'!initialize	self initializePreferences.	"This is the worst place to put this kind of thing... but the MC scripts are not working 	(or at least the MC Browser gives me DNU each time that I want to add a postscript) - DF"	self showFirstInstallationInstructions! !!AutomaticMethodCategorizer class methodsFor: 'initialization' stamp: 'DF 1/7/2008 17:37'!initializePreferences	"	Preferences removePreference: #rulesGlobalName.	Preferences removePreference: #rulesAccessSelector.	self initialize.	"	(Preferences preferenceAt: #rulesGlobalName) 			ifNil: 				[Preferences 					addTextPreference: #rulesGlobalName					categories: #(#'method categorization rules' )					default: self name asString					balloonHelp: 'Specifies a global where the categorization rules are stored.'].	(Preferences preferenceAt: #rulesAccessSelector) 			ifNil: 				[Preferences 					addTextPreference: #rulesAccessSelector					categories: #(#'method categorization rules' )					default: #defaultCategorizationRules asString					balloonHelp: 'Specifies the message sent to the object at rulesGlobalName to get the categorization rules.'].! !!AutomaticMethodCategorizer class methodsFor: 'instance creation' stamp: 'DF 1/7/2008 16:58'!new	^ self usingAll: self categorizationRules! !!AutomaticMethodCategorizer class methodsFor: 'initialization' stamp: 'DF 1/7/2008 17:01'!showFirstInstallationInstructions	Workspace new		acceptContents: self firstInstallationInstructions;		openLabel: 'Automatic Method categorizer loaded!!'.! !!AutomaticMethodCategorizer class methodsFor: 'instance creation' stamp: 'DF 3/19/2006 23:30'!using: aMethodCategorizationRule		^self usingAll: (Array with: aMethodCategorizationRule)! !!AutomaticMethodCategorizer class methodsFor: 'instance creation' stamp: 'DF 3/19/2006 23:30'!usingAll: aCollection		^super new initializeUsingAll: aCollection! !!AutomaticMethodCategorizer methodsFor: 'accessing' stamp: 'DF 6/7/2006 19:57'!categorizationRuleFor: aMethodReference	^categorizationRules detect: [:eachRule | eachRule appliesTo: aMethodReference] ifNone: [NullMethodCategorizationRule new]! !!AutomaticMethodCategorizer methodsFor: 'applying categories' stamp: 'DF 9/10/2006 16:31'!categorizeAllMethodsOf: aClass 	| methodReferences |	methodReferences := aClass selectors collect: [:eachSelector | MethodReference class: aClass selector: eachSelector].	self categorizeAllMethodsReferencedBy: methodReferences! !!AutomaticMethodCategorizer methodsFor: 'applying categories' stamp: 'DF 9/10/2006 15:30'!categorizeAllMethodsReferencedBy: aCollectionOfMethodReferences 	aCollectionOfMethodReferences do: [:eachMethodReference | self categorizeMethodReferencedBy: eachMethodReference]! !!AutomaticMethodCategorizer methodsFor: 'applying categories' stamp: 'DF 9/10/2006 17:15'!categorizeAllUncategorizedMethodsOf: aClass 	| referencesToUncategorizedMethods |	referencesToUncategorizedMethods := aClass organization uncategorizedSelectors 		collect: [:eachSelector | MethodReference class: aClass selector: eachSelector].	self categorizeAllMethodsReferencedBy: referencesToUncategorizedMethods! !!AutomaticMethodCategorizer methodsFor: 'applying categories' stamp: 'DF 9/11/2006 00:37'!categorizeMethodReferencedBy: aMethodReference		^(self categorizationRuleFor: aMethodReference) categorizeMethodReferencedBy: aMethodReference! !!AutomaticMethodCategorizer methodsFor: 'initialization' stamp: 'DF 3/19/2006 23:29'!initializeUsingAll: aCollection 	categorizationRules := aCollection! !!AutomaticMethodCategorizerApplier commentStamp: 'DF 9/10/2006 21:10' prior: 37602452!Instances of this class observes the changes notified by a SystemChangeNotifier and applies categories to methods using an instance of AutomaticMethodCategorizer.You can use this class to autocategorize methods after compilation.Example:AutomaticMethodCategorizerApplier install!!AutomaticMethodCategorizerApplier class methodsFor: 'initialization' stamp: 'DF 1/7/2008 17:01'!initialize	installedApplier := nil.! !!AutomaticMethodCategorizerApplier class methodsFor: 'installing / uninstalling' stamp: 'DF 6/7/2006 23:26'!install	installedApplier notNil ifTrue: [^self].	installedApplier := self using: AutomaticMethodCategorizer new onChangesNotifiedBy: SystemChangeNotifier uniqueInstance.! !!AutomaticMethodCategorizerApplier class methodsFor: 'installing / uninstalling' stamp: 'DF 9/10/2006 21:58'!reinstall	"AutomaticMethodCategorizerApplier reinstall"	self uninstall;		install! !!AutomaticMethodCategorizerApplier class methodsFor: 'installing / uninstalling' stamp: 'DF 9/10/2006 23:13'!uninstall	"AutomaticMethodCategorizerApplier uninstall"	installedApplier isNil ifTrue: [^self].	SystemChangeNotifier uniqueInstance noMoreNotificationsFor: installedApplier.	installedApplier := nil.! !!AutomaticMethodCategorizerApplier class methodsFor: 'instance creation' stamp: 'DF 3/19/2006 16:24'!using: anAutomaticMethodCategorizer onChangesNotifiedBy: aSystemChangeNotifier	^self new initializeUsing: anAutomaticMethodCategorizer onChangesNotifiedBy: aSystemChangeNotifier! !!AutomaticMethodCategorizerApplier methodsFor: 'event handling - private' stamp: 'DF 9/15/2006 14:44'!applyCategorizationFrom: anEvent 	| oldCategory newCategory |	oldCategory := anEvent itemClass organization 				categoryOfElement: anEvent itemSelector.	newCategory := automaticMethodCategorizer 				categorizeMethodReferencedBy: (MethodReference class: anEvent itemClass						selector: anEvent itemSelector).	(newCategory isNil or: [oldCategory = newCategory]) ifTrue: [^ self].	self handleSelectionOf: newCategory		inMethodModificationNotifiedWith: anEvent! !!AutomaticMethodCategorizerApplier methodsFor: 'event handling - private' stamp: 'DF 9/11/2006 01:10'!handleSelectionOf: newCategory inMethodModificationNotifiedWith: anEvent 	"This is an ugly hack to reselect the category in the browser, because when the method is recategorized	the browser updates the category list but deselects the current method (very annoing).	This hack appears to fixit... but is ugly an can fail with other kind of browsers, if some browser guru	knowns a better way to solve it, please let me known :) - DF"	| morphClass browserClass browser |	"these are to no add Morph or Browser as required classes"	morphClass := Smalltalk at: #Morph ifAbsent: [^self].	browserClass := Smalltalk at: #Browser ifAbsent: [^self].	((anEvent itemRequestor isKindOf: morphClass) 		and: [anEvent itemRequestor model isKindOf: browserClass]) 			ifFalse: [^self]. 		"uncomment the following lines to debug this method, it's convenient to uninstall this otherwise	each time that a method is saved the compilation is halted""	self class uninstall.	self halt."		browser := anEvent itemRequestor model.	browser changed: #messageCategoryList.	browser selectMessageCategoryNamed: newCategory.	browser selectedMessageName: anEvent itemSelector.! !!AutomaticMethodCategorizerApplier methodsFor: 'initialization' stamp: 'DF 3/20/2006 21:10'!initializeUsing: anAutomaticMethodCategorizer onChangesNotifiedBy: aSystemChangeNotifier	automaticMethodCategorizer := anAutomaticMethodCategorizer.	changeNotifier := aSystemChangeNotifier.		self registerForNotifications! !!AutomaticMethodCategorizerApplier methodsFor: 'event handling' stamp: 'DF 6/7/2006 21:43'!methodAdditionNotifiedWith: anAddedEvent 	^self methodModificationNotifiedWith: anAddedEvent! !!AutomaticMethodCategorizerApplier methodsFor: 'event handling' stamp: 'DF 9/15/2006 14:16'!methodModificationNotifiedWith: anEvent 	(self shouldApplyCategorizationFrom: anEvent) ifFalse: [^ self].	self applyCategorizationFrom: anEvent! !!AutomaticMethodCategorizerApplier methodsFor: 'initialization' stamp: 'DF 3/20/2006 21:15'!registerForNotifications		changeNotifier 		notify: self 			ofSystemChangesOfItem: AbstractEvent methodKind 			change: AddedEvent changeKind using: #methodAdditionNotifiedWith:;		notify: self 			ofSystemChangesOfItem: AbstractEvent methodKind 			change: ModifiedEvent changeKind using: #methodModificationNotifiedWith:! !!AutomaticMethodCategorizerApplier methodsFor: 'testing' stamp: 'DF 1/3/2008 00:22'!shouldApplyCategorizationFrom: anEvent 	^ (anEvent itemClass organization hasCategoryFor: anEvent itemSelector) not! !!AutomaticMethodCategorizerMockClass methodsFor: 'test support' stamp: 'DF 9/10/2006 22:18'!accessor	^accessor! !!AutomaticMethodCategorizerMockClass methodsFor: 'test support' stamp: 'DF 9/10/2006 16:58'!otherSelectorForTesting	"This method is classified and unclassified by the tests, don't remove it.	If you classify it in another category.. it doesn't matter the classification will be lost each time	that you run the tests - DF"! !!AutomaticMethodCategorizerMockClass methodsFor: 'test support' stamp: 'DF 9/10/2006 16:41'!selectorForTesting	"This method is classified and unclassified by the tests, don't remove it.	If you classify it in another category.. it doesn't matter the classification will be lost each time	that you run the tests - DF"! !!AutomaticMethodCategorizerMockParentClass class methodsFor: 'test setup' stamp: 'DF 9/10/2006 22:26'!categorizeAllMethods		self selectors do: [:eachSelector |		self organization classify: eachSelector under: #'test support' ]! !!AutomaticMethodCategorizerMockParentClass class methodsFor: 'test setup' stamp: 'DF 9/10/2006 17:35'!uncategorizeAllMethods		"Removes all methods from categories, to be used in test setup - DF"	self selectors do: [:eachSelector | self organization classify: eachSelector under: ClassOrganizer default suppressIfDefault: false ]! !!AutomaticMethodCategorizerMockParentClass methodsFor: 'test support' stamp: 'DF 9/10/2006 17:19'!selectorForTesting	"This method is classified and unclassified by the tests, don't remove it.	If you classify it in another category.. it doesn't matter the classification will be lost each time	that you run the tests - DF"! !!CategorizationRulesExample class methodsFor: 'as yet unclassified' stamp: 'DF 1/7/2008 17:33'!oneRule	"Each rule is an instance of MethodCategorizationRule.	The categorizer expects a collection of rules."	^OrderedCollection with:		(MethodCategorizationRule whenSelectorMatches: 'example*' categorizeIn: #example)! !!CategorizationRulesExample class methodsFor: 'as yet unclassified' stamp: 'DF 1/7/2008 17:35'!rulesWithDefaults	"AutomaticMethodCategorizer defaultCategorizationRules returns an OrderedCollection with	som default rules. You can add more rules by adding instances of MethodCategorizationRule	to that collection"	^AutomaticMethodCategorizer defaultCategorizationRules,		(MethodCategorizationRule whenSelectorMatches: 'example*' categorizeIn: #example)! !!MethodCategoriesFinderBehavior commentStamp: 'DF 9/10/2006 21:11' prior: 37602814!This abstract class defines the protocol of an object that given a MethodReference returns a bagof the possible categories for that method.The returned bag contains categories and their occurrences (if it's applicable).!!FixedResultMethodCategoriesFinder commentStamp: 'DF 9/10/2006 11:58' prior: 37603118!Instances of this class always returns a given category for a method.!!FixedResultMethodCategoriesFinder class methodsFor: 'instance creation' stamp: 'DF 6/7/2006 22:08'!returning: aSymbol 	^self new initializeReturning: aSymbol! !!FixedResultMethodCategoriesFinder methodsFor: 'finding categories' stamp: 'DF 9/10/2006 22:54'!findCategoriesFor: aMethodReference 	^Bag with: category! !!FixedResultMethodCategoriesFinder methodsFor: 'initialization' stamp: 'DF 9/10/2006 22:51'!initializeReturning: aSymbol 	category := aSymbol! !!ImageMethodCategoriesFinder methodsFor: 'finding categories' stamp: 'DF 9/10/2006 22:54'!findCategoriesFor: aMethodReference	| selector |	selector := aMethodReference methodSymbol.	^(Smalltalk allClasses		select: [:eachClass | eachClass organization hasCategoryFor: selector]		thenCollect: [:eachClass | eachClass organization categoryOfElement: selector]) asBag! !!MethodCategoriesFinderBehavior methodsFor: 'finding categories' stamp: 'DF 9/10/2006 22:54'!findCategoriesFor: aMethodReference 	self subclassResponsibility! !!SuperClassMethodCategoriesFinder commentStamp: 'DF 9/10/2006 12:10' prior: 37603268!Instances of this class returns all the categories found in the super-classes of a method.!!SuperClassMethodCategoriesFinder methodsFor: 'finding categories' stamp: 'DF 9/10/2006 22:54'!findCategoriesFor: aMethodReference 	| selector superClasses |	selector := aMethodReference methodSymbol.	superClasses := aMethodReference actualClass allSuperclasses.	^(superClasses 		select: [:eachClass | eachClass organization hasCategoryFor: selector]		thenCollect: [:eachClass | eachClass organization categoryOfElement: selector]) asBag! !!MethodCategorizationRuleBehavior commentStamp: 'DF 6/7/2006 21:26' prior: 37603438!This abstract class defines the protocol that must implement a rule to be used in the AutomaticMethodCategorizer.!!MethodCategorizationRule commentStamp: 'DF 9/10/2006 21:11' prior: 37603624!Instances of this class represents a categorization rule.This class is very flexible and can be used to define different rules, see the instance creation methods for examples.!!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 9/10/2006 22:42'!forAccessors	^self when: [:aMethodReference | 			(aMethodReference actualClass compiledMethodAt: aMethodReference methodSymbol) isReturnField 				or: [(aMethodReference methodSymbol occurrencesOf: $:) = 1					and: [aMethodReference actualClass instVarNames includes: (aMethodReference methodSymbol copyUpToLast: $:) ]]		] 		categorizeIn: 'accessing'! !!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 9/10/2006 23:14'!usingMostUsedCategoryInImage	^self 		when: [:aMethodReference | (SystemNavigation default allImplementorsOf: aMethodReference methodSymbol) size > 1]		selectFromCategoriesReturnedBy: ImageMethodCategoriesFinder new		using: MostUsedMethodCategorySelectionStrategy new! !!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 9/10/2006 21:54'!usingMostUsedCategoryInSuperClasses	^ self 		when: 			[:aMethodReference | 			aMethodReference actualClass superclass 				canUnderstand: aMethodReference methodSymbol]		selectFromCategoriesReturnedBy: SuperClassMethodCategoriesFinder new		using: MostUsedMethodCategorySelectionStrategy new! !!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 9/10/2006 18:06'!when: aOneArgBlock categorizeIn: aSymbol 	^self 		when: aOneArgBlock		selectFromCategoriesReturnedBy: (FixedResultMethodCategoriesFinder returning: aSymbol)		using: MostUsedMethodCategorySelectionStrategy new! !!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 9/10/2006 18:06'!when: aOneArgBlock selectFromCategoriesReturnedBy: aMethodCategoriesFinder using: aMethodCategorySelectionStrategy 	^ self new 		initializeWhen: aOneArgBlock		selectFromCategoriesReturnedBy: aMethodCategoriesFinder		using: aMethodCategorySelectionStrategy! !!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 6/7/2006 20:49'!whenSelectorMatches: aSelectorPatternString andClassInheritsFrom: aClass categorizeIn: aSymbol 	^self 		when: [:aMethodReference |			(aSelectorPatternString match: aMethodReference methodSymbol asString)				and: [aMethodReference actualClass inheritsFrom: aClass] ]		categorizeIn: aSymbol! !!MethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 6/7/2006 20:50'!whenSelectorMatches: aSelectorPatternString categorizeIn: aSymbol 		^self when: [:aMethodReference | aSelectorPatternString match: aMethodReference methodSymbol asString ] 		  categorizeIn: aSymbol! !!MethodCategorizationRule methodsFor: 'testing' stamp: 'DF 6/7/2006 22:11'!appliesTo: aMethodReference	^(conditionBlock value: aMethodReference) and: [ self canSelectCategoryFor: aMethodReference]! !!MethodCategorizationRule methodsFor: 'testing - private' stamp: 'DF 9/10/2006 21:02'!canSelectCategoryFor: aMethodReference 	| categorySearchResult |	categorySearchResult := categoriesFinder 				findCategoriesFor: aMethodReference.	^ selectionStrategy canSelectCategoryFor: aMethodReference		from: categorySearchResult! !!MethodCategorizationRule methodsFor: 'evaluating' stamp: 'DF 9/11/2006 00:38'!categorizeMethodReferencedBy: aMethodReference 	| category |		category := self categoryFor: aMethodReference.		aMethodReference actualClass organization 		classify: aMethodReference methodSymbol		under: category.			^category! !!MethodCategorizationRule methodsFor: 'accessing - private' stamp: 'DF 9/10/2006 21:02'!categoryFor: aMethodReference 	| categorySearchResult |	categorySearchResult := categoriesFinder 				findCategoriesFor: aMethodReference.	^ selectionStrategy selectCategoryFor: aMethodReference		from: categorySearchResult! !!MethodCategorizationRule methodsFor: 'initialization' stamp: 'DF 9/10/2006 21:02'!initializeWhen: aOneArgBlock selectFromCategoriesReturnedBy: aMethodCategoriesFinder using: aMethodCategorySelectionStrategy 	conditionBlock := aOneArgBlock.	categoriesFinder := aMethodCategoriesFinder.	selectionStrategy := aMethodCategorySelectionStrategy! !!MethodCategorizationRuleBehavior methodsFor: 'testing' stamp: 'DF 6/7/2006 20:13'!appliesTo: aMethodReference	self subclassResponsibility! !!MethodCategorizationRuleBehavior methodsFor: 'evaluating' stamp: 'DF 6/7/2006 21:04'!categorizeMethodReferencedBy: aMethodReference	self subclassResponsibility! !!NullMethodCategorizationRule commentStamp: 'DF 6/7/2006 21:27' prior: 37603878!This is a null rule that does nothing.See also:Search on the web for "Null Object Pattern".!!NullMethodCategorizationRule class methodsFor: 'initialization' stamp: 'DF 6/7/2006 23:04'!initialize	self initializeUniqueInstance! !!NullMethodCategorizationRule class methodsFor: 'initialization' stamp: 'DF 12/31/2005 03:05'!initializeUniqueInstance	uniqueInstance := super new! !!NullMethodCategorizationRule class methodsFor: 'instance creation' stamp: 'DF 12/31/2005 03:05'!new	^self uniqueInstance! !!NullMethodCategorizationRule class methodsFor: 'initialization' stamp: 'DF 12/31/2005 03:05'!uniqueInstance	uniqueInstance isNil ifTrue: [ self initializeUniqueInstance ].		^uniqueInstance! !!NullMethodCategorizationRule methodsFor: 'testing' stamp: 'DF 6/7/2006 21:03'!appliesTo: aMethodReference	^true! !!NullMethodCategorizationRule methodsFor: 'evaluating' stamp: 'DF 9/11/2006 00:40'!categorizeMethodReferencedBy: aMethodReference	^nil! !!MethodCategorySelectionStrategyBehavior methodsFor: 'testing' stamp: 'DF 9/10/2006 22:56'!canSelectCategoryFor: aMethodReference from: aBag	self subclassResponsibility! !!MethodCategorySelectionStrategyBehavior methodsFor: 'selecting categories' stamp: 'DF 9/10/2006 22:55'!selectCategoryFor: aMethodReference from: aBag	self subclassResponsibility! !!MostUsedMethodCategorySelectionStrategy methodsFor: 'testing' stamp: 'DF 9/10/2006 22:56'!canSelectCategoryFor: aMethodReference from: aBag	^aBag notEmpty! !!MostUsedMethodCategorySelectionStrategy methodsFor: 'selecting categories' stamp: 'DF 9/11/2006 00:08'!selectCategoryFor: aMethodReference from: aBag	^aBag sortedCounts first value! !!MockSystemChangeNotifier methodsFor: 'initialization' stamp: 'DF 3/20/2006 00:43'!initialize	eventSource := SystemEventManager new! !!MockSystemChangeNotifier methodsFor: 'system change notifier protocol' stamp: 'DF 3/20/2006 01:19'!methodAdded: aMethod selector: aSymbol inClass: aClass	self trigger: (AddedEvent				method: aMethod 				selector: aSymbol				class: aClass)! !!MockSystemChangeNotifier methodsFor: 'system change notifier protocol' stamp: 'DF 3/20/2006 21:14'!methodChangedFrom: oldMethod to: newMethod selector: aSymbol inClass: aClass	self trigger: (ModifiedEvent					methodChangedFrom: oldMethod					to: newMethod					selector: aSymbol 					inClass: aClass)! !!MockSystemChangeNotifier methodsFor: 'system change notifier protocol' stamp: 'DF 3/20/2006 00:44'!notify: anObject ofEvents: eventsCollection using: oneArgumentSelector	eventsCollection do: [:eachEvent | eventSource when: eachEvent send: oneArgumentSelector to: anObject]! !!MockSystemChangeNotifier methodsFor: 'system change notifier protocol' stamp: 'DF 3/20/2006 00:44'!notify: anObject ofSystemChangesOfItem: itemKind change: changeKind using: oneArgumentSelector 	self 		notify: anObject		ofEvents: (Bag with: (self systemEventsForItem: itemKind change: changeKind))		using: oneArgumentSelector! !!MockSystemChangeNotifier methodsFor: 'system change notifier protocol' stamp: 'DF 3/20/2006 00:47'!systemEventsForItem: itemKind change: changeKind 	^AbstractEvent eventSelectorBlock value: itemKind value: changeKind! !!MockSystemChangeNotifier methodsFor: 'system change notifier protocol' stamp: 'DF 3/20/2006 01:19'!trigger: event	event trigger: eventSource! !!OBCmdAutoCategorizeWithAMC methodsFor: 'execution' stamp: 'DF 1/3/2008 00:30'!execute	AutomaticMethodCategorizer new categorizeAllUncategorizedMethodsOf: target theClass! !!AutomaticMethodCategorizerApplierTest methodsFor: 'accessing - private' stamp: 'DF 3/20/2006 01:04'!categoryForTesting	^#category! !!AutomaticMethodCategorizerApplierTest methodsFor: 'test support' stamp: 'DF 9/10/2006 20:57'!mockClass	^AutomaticMethodCategorizerMockClass! !!AutomaticMethodCategorizerApplierTest methodsFor: 'running' stamp: 'DF 9/10/2006 18:15'!setUp	self mockClass uncategorizeAllMethods.	mockSystemChangeNotifier := MockSystemChangeNotifier new.	self setUpAutomaticMethodCategorizer	! !!AutomaticMethodCategorizerApplierTest methodsFor: 'running' stamp: 'DF 9/10/2006 18:15'!setUpAutomaticMethodCategorizer	| categorizationRule |		categorizationRule := MethodCategorizationRule 				whenSelectorMatches: #selectorForTesting asString				categorizeIn: self categoryForTesting.	automaticMethodCategorizer := AutomaticMethodCategorizer using: categorizationRule! !!AutomaticMethodCategorizerApplierTest methodsFor: 'running' stamp: 'DF 9/10/2006 21:47'!tearDown	self mockClass categorizeAllMethods	! !!AutomaticMethodCategorizerApplierTest methodsFor: 'tests' stamp: 'DF 9/10/2006 21:22'!testCategorizeOnMethodModification	AutomaticMethodCategorizerApplier 		using: automaticMethodCategorizer		onChangesNotifiedBy: mockSystemChangeNotifier.	self deny: (self mockClass organization hasCategoryFor: #selectorForTesting).	mockSystemChangeNotifier 		methodChangedFrom: self mockClass >> #selectorForTesting		to: self mockClass >> #selectorForTesting		selector: #selectorForTesting		inClass: self mockClass.	self 		assert: (self mockClass organization categoryOfElement: #selectorForTesting) = self categoryForTesting! !!AutomaticMethodCategorizerApplierTest methodsFor: 'tests' stamp: 'DF 9/10/2006 21:23'!testCategorizeOnNewMethod		AutomaticMethodCategorizerApplier 		using: automaticMethodCategorizer		onChangesNotifiedBy: mockSystemChangeNotifier.	self deny: (self mockClass organization hasCategoryFor: #selectorForTesting).	mockSystemChangeNotifier 		methodAdded: self mockClass >> #selectorForTesting		selector: #selectorForTesting		inClass: self mockClass.	self assert: (self mockClass organization categoryOfElement: #selectorForTesting) = self categoryForTesting! !!AutomaticMethodCategorizerTest methodsFor: 'test support' stamp: 'DF 1/7/2008 17:44'!assertCategorizationOfAllMethodsWith: anAutomaticMethodCategorizer 	| mockClassOrganization |	mockClassOrganization := self mockClass organization.	mockClassOrganization 		classify: #selectorForTesting		under: 'any'.	self assert: (mockClassOrganization categoryOfElement: #selectorForTesting) = 'any'.	anAutomaticMethodCategorizer categorizeAllMethodsOf: self mockClass.	self assert: (mockClassOrganization categoryOfElement: #selectorForTesting) = self categoryForTesting! !!AutomaticMethodCategorizerTest methodsFor: 'test support' stamp: 'DF 1/7/2008 17:59'!categorizationRules		^categorizationRules! !!AutomaticMethodCategorizerTest methodsFor: 'test support' stamp: 'DF 9/10/2006 16:53'!categoryForTesting	^#'categorizer test'! !!AutomaticMethodCategorizerTest methodsFor: 'test support' stamp: 'DF 1/7/2008 17:53'!globalWithTestingRules	^'AutoMethodCatTestGlobal'! !!AutomaticMethodCategorizerTest methodsFor: 'test support' stamp: 'DF 9/10/2006 16:48'!mockClass	^AutomaticMethodCategorizerMockClass! !!AutomaticMethodCategorizerTest methodsFor: 'running' stamp: 'DF 1/7/2008 17:57'!setUp	Smalltalk at: self globalWithTestingRules asSymbol put: self.	self mockClass uncategorizeAllMethods.	self setUpCategorizationRules! !!AutomaticMethodCategorizerTest methodsFor: 'running' stamp: 'DF 9/10/2006 17:08'!setUpCategorizationRules	categorizationRules := OrderedCollection new		add: (MethodCategorizationRule whenSelectorMatches: #selectorForTesting asString categorizeIn: self categoryForTesting);		add: (MethodCategorizationRule whenSelectorMatches: #otherSelectorForTesting asString categorizeIn: self categoryForTesting);		yourself! !!AutomaticMethodCategorizerTest methodsFor: 'running' stamp: 'DF 1/7/2008 17:58'!tearDown	Smalltalk removeKey: self globalWithTestingRules asSymbol! !!AutomaticMethodCategorizerTest methodsFor: 'tests' stamp: 'DF 9/10/2006 17:14'!testCategorizationRuleFor	"Get a categorization rule for a given method reference - DF"	| returnedCategorizationRule methodCategorizer |		methodCategorizer := AutomaticMethodCategorizer usingAll: categorizationRules.		returnedCategorizationRule := methodCategorizer categorizationRuleFor: (MethodReference class: self mockClass selector: #selectorForTesting).	self assert: categorizationRules first = returnedCategorizationRule.		returnedCategorizationRule := methodCategorizer categorizationRuleFor: (MethodReference class: self mockClass selector: #otherSelectorForTesting).	self assert: (categorizationRules at: 2) = returnedCategorizationRule.		returnedCategorizationRule := methodCategorizer categorizationRuleFor: (MethodReference class: self mockClass selector: #printString).	self assert: returnedCategorizationRule = NullMethodCategorizationRule new! !!AutomaticMethodCategorizerTest methodsFor: 'tests' stamp: 'DF 1/7/2008 17:44'!testCategorizeAll	"Categorize all methods (including those already categorized) - DF"	self assertCategorizationOfAllMethodsWith: (AutomaticMethodCategorizer usingAll: categorizationRules)! !!AutomaticMethodCategorizerTest methodsFor: 'tests' stamp: 'DF 9/10/2006 17:12'!testCategorizeAllUncategorized	"Categorize only the uncategorized methods - DF"	| mockClassOrganization |	mockClassOrganization := self mockClass organization.	mockClassOrganization classify: #otherSelectorForTesting under: 'any'.	self		assert: (mockClassOrganization hasCategoryFor: #otherSelectorForTesting);		deny: (mockClassOrganization hasCategoryFor: #selectorForTesting).	(AutomaticMethodCategorizer usingAll: categorizationRules) 		categorizeAllUncategorizedMethodsOf: self mockClass.	self		assert: (mockClassOrganization hasCategoryFor: #selectorForTesting);		assert: (mockClassOrganization hasCategoryFor: #otherSelectorForTesting);		assert: (mockClassOrganization categoryOfElement: #selectorForTesting) = self categoryForTesting;		assert: (mockClassOrganization categoryOfElement: #otherSelectorForTesting) = 'any'! !!AutomaticMethodCategorizerTest methodsFor: 'tests' stamp: 'DF 1/7/2008 17:55'!testCategorizeUsingRulesDefinedInPreferences	"This test could fail if the Preferences are modified during the execution. - DF"		| previousRuleGlobalName previousRulesAccessSelector |	previousRuleGlobalName := Preferences valueOfPreference: #rulesGlobalName.	previousRulesAccessSelector := Preferences valueOfPreference: #rulesAccessSelector.		[		Preferences setPreference: #rulesGlobalName toValue: self globalWithTestingRules.		Preferences setPreference: #rulesAccessSelector toValue: 'categorizationRules'.		self assertCategorizationOfAllMethodsWith: AutomaticMethodCategorizer new	] ensure: [		Preferences setPreference: #rulesGlobalName toValue: previousRuleGlobalName.		Preferences setPreference: #rulesAccessSelector toValue: previousRulesAccessSelector	]	! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 1/12/2006 22:38'!categoryForTesting	^#'test category'! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 9/10/2006 17:24'!mockClass	^AutomaticMethodCategorizerMockClass! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 9/10/2006 22:18'!referenceToAccessorMethod		^MethodReference class: self mockClass selector: #accessor! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 9/10/2006 17:22'!referenceToMethodForTesting		^MethodReference class: self mockClass selector: #selectorForTesting! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 9/10/2006 17:23'!referenceToOtherMethodForTesting		^MethodReference class: self mockClass selector: #otherSelectorForTesting! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 9/10/2006 17:29'!selectorForTesting	"Used in tests (see local senders of this method) - DF"! !!MethodCategorizationRuleTest methodsFor: 'running' stamp: 'DF 9/10/2006 17:35'!setUp	self mockClass uncategorizeAllMethods.	self mockClass superclass uncategorizeAllMethods.! !!MethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 6/7/2006 22:23'!superClassCategory	^#'category in super class'! !!MethodCategorizationRuleTest methodsFor: 'running' stamp: 'DF 9/10/2006 21:47'!tearDown	self mockClass categorizeAllMethods.	self mockClass superclass categorizeAllMethods.! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 17:22'!testAppliesTo	| rule |	rule := MethodCategorizationRule 		when: [:aMethodReference | aMethodReference = self referenceToMethodForTesting]			categorizeIn: self categoryForTesting.	self		assert: (rule appliesTo: self referenceToMethodForTesting);		deny: (rule appliesTo: self referenceToOtherMethodForTesting)! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 22:18'!testAppliesToAccessors	| rule |	rule := MethodCategorizationRule forAccessors.	self		assert: (rule appliesTo: self referenceToAccessorMethod);		deny: (rule appliesTo: self referenceToMethodForTesting)! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 17:25'!testAppliesToWhenCreatedForSelector		| ruleForSelector |		ruleForSelector := MethodCategorizationRule 				whenSelectorMatches: #selectorForTesting				categorizeIn: self categoryForTesting.	self		assert: (ruleForSelector appliesTo: self referenceToMethodForTesting);		deny: (ruleForSelector appliesTo: self referenceToOtherMethodForTesting)! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 17:37'!testAppliesToWhenCreatedForSelectorAndClassInheritsFrom	| ruleForSelector |	ruleForSelector := MethodCategorizationRule 				whenSelectorMatches: #selectorForTesting				andClassInheritsFrom: self mockClass superclass 				categorizeIn: self categoryForTesting.	self		assert: (ruleForSelector appliesTo: self referenceToMethodForTesting);		deny: (ruleForSelector appliesTo: self referenceToOtherMethodForTesting);		deny: (ruleForSelector appliesTo: (MethodReference class: self class selector: #selectorForTesting))! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 22:07'!testAppliesToWhenUsingSuperClassCategory	| rule |	rule := MethodCategorizationRule usingMostUsedCategoryInSuperClasses.	self mockClass superclass organization classify: #selectorForTesting under: self superClassCategory.		self		assert: (rule appliesTo: self referenceToMethodForTesting);		deny: (rule appliesTo: self referenceToOtherMethodForTesting).	self mockClass superclass uncategorizeAllMethods.	self deny: (rule appliesTo: self referenceToMethodForTesting)		description: 'The rule applies only when the super class method is classified'! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 17:39'!testCategorize	| rule |	rule := MethodCategorizationRule 				when: [:aMethodReference | aMethodReference = self referenceToMethodForTesting ]				categorizeIn: self categoryForTesting.	rule categorizeMethodReferencedBy: self referenceToMethodForTesting.	self assert: (self mockClass organization categoryOfElement: #selectorForTesting) = self categoryForTesting! !!MethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 22:16'!testCategorizeWhenUsingSuperClassCategory	| rule |	rule := MethodCategorizationRule usingMostUsedCategoryInSuperClasses.	self mockClass superclass organization classify: #selectorForTesting under: self superClassCategory.		rule categorizeMethodReferencedBy: self referenceToMethodForTesting.		self assert: (self mockClass organization categoryOfElement: #selectorForTesting) = self superClassCategory! !!NullMethodCategorizationRuleTest methodsFor: 'test support' stamp: 'DF 9/10/2006 18:09'!mockClass	^AutomaticMethodCategorizerMockClass! !!NullMethodCategorizationRuleTest methodsFor: 'running' stamp: 'DF 9/10/2006 21:47'!setUp	rule := NullMethodCategorizationRule new! !!NullMethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 18:08'!testAppliesTo	self assert: (rule appliesTo: (MethodReference class: self mockClass selector: #selectorForTesting)) 		description: 'Always returns true'! !!NullMethodCategorizationRuleTest methodsFor: 'tests' stamp: 'DF 9/10/2006 18:08'!testCategorize	self shouldnt: [ rule categorizeMethodReferencedBy: (MethodReference class: self mockClass selector: #selectorForTesting) ] raise: Exception	! !!OBCmdAutoCategorizeWithAMCTest methodsFor: 'tests' stamp: 'DF 1/7/2008 16:08'!testOBAutocategorizeCommandOverride	| browser |		browser := OBSystemBrowser onClass: String.	self assert: (browser cmdFactories includes: OBCmdAutoCategorizeWithAMC).	self deny: (browser cmdFactories includes: OBCmdAutoCategorize).	! !"AutomaticMethodCategorizer"!"AutomaticMethodCategorizerOB"!!JoystickMorph commentStamp: 'StephaneDucasse 8/20/2009 10:29' prior: 0!A widget that simulates a joystick. Mosly used in etoy sopenInWorld: 		JoystickMorph new openInHand explore	Explore the morph and you will see that you can get the direction, strength and !!StarMorph commentStamp: 'wiz 9/6/2005 12:30' prior: 0!I am a very flexible star..Grab me from the supplies flap or from the graphic objects.Add my handles and you can move and resize me.The up and down arrows increase or reduce the number of my sides.The right and left arrows cycle thru different amounts of  pointiness.Use the arrows right and left of my center or get stars with a specific amount of pointyness.  The left side goes from fat to thin and then cycles around again. The right goes from thin to fat. Hold down the shift key if you wish to stop the cycling at the extremes.Use the arrows up and down to change the number of sides if you would like a different number of points.To add or remove just one side hold the shift key down as you use the arrows or use the menu items for that purpose.If you add or remove just one point I will have an odd number of sides.  When that happens I can only look like a regular polygon. The right and left arrows will have no effect.  Add or remove just one more side and you can shift drag the outer handle or use the arrows to restore my pointiness. That was too complicated. It is gone. You can get regular polygon shapes by adjusting my pointiness. For example the extreme of a five pointed star is a dodecahedron (10 sided regular polygon) and one step less extreme is a pentagon (5 sided regular polygon).At some time you will probably shift drag the outer handle thru the center handle.While I looked round as you shrunk me, I will look very much like an asterisk as you pull me away.  What happens is that inside bend shrunk on the way down because it can never be larger than the outer point (or it wouldn't be the innerbend would it).But on the way out it is perfectly happy to remain small. So I look like an asterisk.To fatten me up  (if you haven't already figured this out by fooling around)  hold the shift down an move the outer handle towards the center (but not quite all the way) then let the shift up and move the outer handle away.  A couple of cycles like this and I'll be looking fat and jolly again. Or you can now just use the right arrow to make me fatter.This is also the reason I don't let the inside bend get larger than the outer point.If I did the same process that fattened me when I was an asterisk would also grow an asterisk so large squeak would complain about not having enough memory.Historical note:The former star had two bugs that are fixed here.The outer handle now no longer jumps from one point to another.The other bug prevented some higher order stars from looking right. Which is why the former star didn't allow you to change the number of points. !!DoubleClickExample commentStamp: 'StephaneDucasse 8/19/2009 22:55' prior: 0!Illustrates the double-click capabilities of Morphic.DoubleClickExample new openInWorld 	If you have a kind of morph you wish to have respond specially to a double-click, it should:(1)  Respond "true" to #handlesMouseDown:(2)  In its mouseDown: method, send #waitForClicksOrDrag:event: to the hand.(3)  Reimplement #click: to react to single-clicked mouse-down.(4)  Reimplement #doubleClick: to make the appropriate response to a double-click.(5)  Reimplement #drag: to react to non-clicks.  This message is sent continuously until the button is released.  You can check the event argument to react differently on the first, intermediate, and last calls.!!HeadingMorph commentStamp: 'StephaneDucasse 8/19/2009 23:00' prior: 0!A HeadingMorph displays an arrow on a grid as well as its decomposition on x and y axis.Clicking on it changes the direction of the main arrow.	HeadingMorph new openInWorld!!StarWithABallMorph commentStamp: 'StephaneDucasse 8/20/2009 09:40' prior: 0!This is a example of how to use a morph. It consists of only two methods, initialize and step.DoIt:StarWithABall new openInWorld.!!StickyPadMorph commentStamp: 'StephaneDucasse 8/20/2009 10:16' prior: 0!A custom item for the  Squeakland Supplies bin, as defined by Kim Rose and BJ Con.A parts bin will deliver up translucent, borderless Rectangles in a sequence of 6 colors.  It offers some complication to the parts-bin protocols in two ways::* The multi-colored icon seen in the parts bin is not a thumbnail of any actual instance, all of which are monochrome* New instances need to be given default names that are not the same as the name seen in the parts bin.StickyPadMorph minimics the stickyPad 	StickyPadMorph new openInWorld 	!!ClipboardMorph commentStamp: 'StephaneDucasse 8/20/2009 16:02' prior: 0!A morph that always displays the current contents of the text clipboard.	ClipboardMorph new openInWorld!!AnimatedImageMorph commentStamp: 'StephaneDucasse 8/20/2009 10:40' prior: 0!I am an ImageMorph that can hold more than one image. Each image has its own delay time.If you have an animated gif close to the image named 	(AnimatedImageMorph fromGIFFileNamed: 'animated.gif') openInWorld !!ImageMorphWithSpotlight commentStamp: 'StephaneDucasse 8/19/2009 23:34' prior: 0!This class implements an image that appears one way or another depending upon whether it lies within a spotlight shape that moves with the cursor.  As delivered, the shape is a simple circle, the spotlighted appearance is that of a ColorForm, and the non-highlighted apperarance is a derived gray-scale form.	(ImageMorphWithSpotlight new image: (Form fromUser)) openInWorld 	The implementation will space-efficient if supplied with a ColorForm, because the gray-scale derived form will share the same bitmap.In general, any two images can be used -- one could be blurred, the other sharp -- and the masking form can be any shape.At some point this class should be merged somehow with ScreeningMorph.-- Note from Stephane Ducasse - August 2009: Does not seem to work with ColorForm!!MagnifierMorph commentStamp: 'TestRunner 11/14/2009 16:57' prior: 0!MagnifierMorph instances are magnifying lenses that magnify the morphs below them (if grabbed or if trackPointer is false) or the area around the mouse pointer.	MagnifierMorph newShowingPointer openInWorld 		MagnifierMorph new openInWorld	Instance variables:magnification	<Number> The magnification to use. If non-integer, smooths the magnified form.trackPointer		<Boolean> If set, magnifies the area around the Hand. If not, magnfies the area underneath the magnifier center.showPointer		<Boolean> If set, display a small reversed rectangle in the center of the lens. Also enables the display of Morphs in the Hand itself.srcExtent		<Rectangle> The extent of the source rectangle.		Class variables:RecursionLock	<MagnifierMorph|nil> Used to avoid infinite recursion when getting the source patch to display.!!FishEyeMorph commentStamp: 'StephaneDucasse 8/19/2009 23:43' prior: 0!A FishEyeMorph is an extreme-wide-angle lens MagnifierMorph	FishEyeMorph new openInWorld!!AtomMorph commentStamp: 'tbn 11/25/2004 09:06' prior: 0!AtomMorph represents an atom used in the simulation ofan ideal gas. It's container is typically a BouncingAtomsMorph.Try:	BouncingAtomsMorph  new openInWorldto open the gas simulation or:	AtomMorph exampleto open an instance in the current world!!Flasher commentStamp: 'StephaneDucasse 8/19/2009 22:56' prior: 0!A simple example - a circle that flashes.	Flasher new openInWorld The "onColor" instance variable indicates the color to use when "on",  A darker color is used to represent "off".The #step method, called every 500ms. by default, alternatively makes the flasher show its "on" and its "off" color.!!MovingEyeMorph commentStamp: 'StephaneDucasse 8/20/2009 09:40' prior: 0!A MovingEyeMorph is a morph representing an eye whose iris is following the mouse cursor.!!WatchMorph commentStamp: '<historical>' prior: 0!This class is a representation of a watch.The labels' font is changeble. Labels' font size increase or decrease when resizing me.WatchMorph new openInWorld(WatchMorph fontName: 'ComicPlain' bgColor: Color transparent centerColor: Color transparent) openInWorld		" transparent "(WatchMorph fontName: 'ComicBold' bgColor: Color white centerColor: Color black) openInWorldStructure:	fontName		String -- the labels' font name	cColor			Color -- center color	handsColor		Color	romanNumerals	Boolean	antialias		Boolean!!ClockMorph commentStamp: 'StephaneDucasse 8/19/2009 22:54' prior: 0!A ClockMorph is oneline clock	ClockMorph new openInWorld 	ClockMorph new openInHand!!FrameRateMorph commentStamp: 'StephaneDucasse 8/19/2009 22:59' prior: 0!A little Morph to show the speed of frame rate of the system.	FrameRateMorph new openInWorld.	FrameRateMorph new openInHand.!!InfoStringMorph commentStamp: 'StephaneDucasse 8/19/2009 23:37' prior: 0!A generalization of the clock morphTry	InfoStringMorph new openInWorldor	(InfoStringMorph on: [SmalltalkImage current  vmParameterAt: 9])		stepTime: 50;		openInWorld!!BackgroundMorph commentStamp: 'StephaneDucasse 8/20/2009 15:52' prior: 0!This morph incorporates tiling and regular motion with the intent of supporting, eg, panning of endless (toroidal) backgrounds.The idea is that embedded morphs get displayed at a moving offset relative to my position.  Moreover this display is tiled according to the bounding box of the submorphs (subBounds), as much as necesary to fill the rest of my bounds.	(BackgroundMorph new addMorph: (ImageMorph new image: Form fromUser)) openInWorld!!BouncingAtomsMorph commentStamp: '<historical>' prior: 0!This morph shows how an ideal gas simulation might work. When it gets step messages, it makes all its atom submorphs move along their velocity vectors, bouncing when they hit a wall. It also exercises the Morphic damage reporting and display architecture. Here are some things to try:  1. Resize this morph as the atoms bounce around.  2. In an inspector on this morph, evaluate "self addAtoms: 10."  3. Try setting quickRedraw to false in invalidRect:. This gives the     default damage reporting and incremental redraw. Try it for     100 atoms.  4. In the drawOn: method of AtomMorph, change drawAsRect to true.  5. Create a HeaterCoolerMorph and embed it in the simulation. Extract	it and use an inspector on it to evaluate "self velocityDelta: -5", then     re-embed it. Note the effect on atoms passing over it.!!LedCharacterMorph commentStamp: '<historical>' prior: 0!char 36 is SPACE!!LedDigitMorph commentStamp: '<historical>' prior: 0!I am a 7-segment LED that can display a decimal digit!!LedMorph commentStamp: 'StephaneDucasse 8/20/2009 10:49' prior: 0!I am a collection of LED digits that can display a decimal value.  The display can be set to flash by sending flash: true.LedMorph can now display characters:	LedMorph new  string:'0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'; openInWorldLowercase letters will be converted to Uppercase. Carachters not in the examleabove will be shown as SPACE which is char 36 in LedCharacterMorph.	LedMorph new  chars: 10; string:'           I must get a life';flash:true;scrollLoop:true; openInWorldThe number of letters is set by chars. If chars is not specified it will be set to the string size. When the string size is bigger than charsthe string will scroll across the led. WOW!!scrollLoop let's you set the scrolling to start over once its finished.Enjoy.!!JoystickMorph commentStamp: 'StephaneDucasse 8/20/2009 10:29' prior: 37643756!A widget that simulates a joystick. Mosly used in etoy sopenInWorld: 		JoystickMorph new openInHand explore	Explore the morph and you will see that you can get the direction, strength and !!JoystickMorph class methodsFor: 'parts bin' stamp: 'sw 8/2/2001 16:40'!descriptionForPartsBin	^ self partName: 	'Joystick'		categories:		#('Useful')		documentation:	'A joystick-like control'! !!JoystickMorph class methodsFor: 'new-morph participation' stamp: 'sw 4/26/1999 16:02'!includeInNewMorphMenu	^ true! !!JoystickMorph class methodsFor: 'initialization' stamp: 'asm 4/10/2003 13:10'!initialize	self registerInFlapsRegistry.! !!JoystickMorph class methodsFor: 'initialization' stamp: 'asm 4/14/2003 20:32'!registerInFlapsRegistry	"Register the receiver in the system's flaps registry"	self environment		at: #Flaps		ifPresent: [:cl | cl registerQuad: #(JoystickMorph		authoringPrototype		'Joystick'	'A joystick-like control') 						forFlapNamed: 'PlugIn Supplies'.						cl registerQuad: #(JoystickMorph		authoringPrototype		'Joystick'	'A joystick-like control') 						forFlapNamed: 'Scripting'.						cl registerQuad: #(JoystickMorph		authoringPrototype		'Joystick'	'A joystick-like control') 						forFlapNamed: 'Supplies']! !!JoystickMorph class methodsFor: 'initialization' stamp: 'asm 4/11/2003 12:36'!unload	"Unload the receiver from global registries"	self environment at: #Flaps ifPresent: [:cl |	cl unregisterQuadsWithReceiver: self] ! !!JoystickMorph methodsFor: 'menu' stamp: 'sw 4/29/2004 20:00'!addCustomMenuItems: aCustomMenu hand: aHandMorph	"Add custom items to the menu"	super addCustomMenuItems: aCustomMenu hand: aHandMorph.	aCustomMenu addLine.	aCustomMenu add: 'set X range' translated action: #setXRange.	aCustomMenu add: 'set Y range' translated action: #setYRange.	aCustomMenu addLine.	aCustomMenu addUpdating: #autoCenterString target: self action: #toggleAutoCenter.	aCustomMenu balloonTextForLastItem: 'When auto-center is on, every time you let go of the Joystick knob, it springs back to the neutral position at the center of the device' translated. 	aCustomMenu addUpdating: #realJoystickString target: self action: #toggleRealJoystick.	aCustomMenu balloonTextForLastItem: 'Governs whether this joystick should track the motions of a real, physical joystick attached to the computer.' translated. 	aCustomMenu addUpdating: #joystickNumberString enablementSelector: #realJoystickInUse target: self selector: #chooseJoystickNumber argumentList: #().	aCustomMenu balloonTextForLastItem: 'Choose which physical device is associated with the joystick.' translated! !!JoystickMorph methodsFor: 'accessing'!amount	^ (handleMorph center - self center) r * radiusScale! !!JoystickMorph methodsFor: 'accessing'!angle	self center = handleMorph center ifTrue: [^ lastAngle].	^ 360.0 - (handleMorph center - self center) theta radiansToDegrees! !!JoystickMorph methodsFor: 'menu' stamp: 'sw 4/29/2004 18:30'!autoCenterString	"Answer a string characterizing whether or not I have auto-center on"	^ (autoCenter == true	ifTrue: ['<yes>'] ifFalse: ['<no>']), ('auto-center' translated)! !!JoystickMorph methodsFor: 'accessing' stamp: 'mir 9/4/2005 16:46'!button1	^button1 == true! !!JoystickMorph methodsFor: 'accessing' stamp: 'mir 9/4/2005 16:46'!button2	^button2 == true! !!JoystickMorph methodsFor: 'menu' stamp: 'alain.plantec 2/6/2009 15:26'!chooseJoystickNumber	"Allow the user to select a joystick number"	| result aNumber str |	str := self lastRealJoystickIndex asString.	result := UIManager default 				request: (('Joystick device number' translated, ' (', 'currently' translated, ' {1})') format: {str})				initialAnswer: str.	[aNumber := result asNumber] on: Error do: [:err | ^Beeper beep].	(aNumber > 0 and: [aNumber <= 32]) 		ifFalse: 			["???"			^Beeper beep].	realJoystickIndex := aNumber.	self setProperty: #lastRealJoystickIndex toValue: aNumber.	self startStepping! !!JoystickMorph methodsFor: 'event handling' stamp: 'sw 5/11/1998 13:51'!handlesMouseDown: evt	self inPartsBin ifTrue: [^ false].	true ifTrue: [^ true].  "5/7/98 jhm temporary fix to allow use when rotated"	(handleMorph fullContainsPoint: evt cursorPoint)		ifTrue: [^ true]		ifFalse: [^ super handlesMouseDown: evt].! !!JoystickMorph methodsFor: 'initialization' stamp: 'alain.plantec 5/28/2009 10:00'!initialize	super initialize.	xScale := 0.25.	yScale := 0.25.	radiusScale := 1.0.	lastAngle := 0.0.	autoCenter := true.	self form: ((Form extent: 55@55 depth: 8) fillColor: (Color r: 0.3 g: 0.2 b: 0.2)).	handleMorph := EllipseMorph new.	handleMorph color: Color red; extent: 15@15.	self addMorph: handleMorph.	self moveHandleToCenter.	button1 := false.	button2 := false.! !!JoystickMorph methodsFor: 'parts bin' stamp: 'sw 8/12/2001 17:26'!initializeToStandAlone	"Circumvent SketchMorph's implementation here"	self initialize! !!JoystickMorph methodsFor: 'halos and balloon help' stamp: 'sw 8/11/2004 18:10'!isLikelyRecipientForMouseOverHalos	"The automatic mouseover halos interere with the proper functioning of the joystick's knob"	^ false! !!JoystickMorph methodsFor: 'menu' stamp: 'yo 2/11/2005 09:19'!joystickNumberString	"Answer a string characterizing the joystick number"	^ 'set real joystick number (now {1})' translated format: {self lastRealJoystickIndex asString}.! !!JoystickMorph methodsFor: 'menu' stamp: 'sw 4/29/2004 20:08'!lastRealJoystickIndex	"Answer the last remembered real joystick index.  Initialize it to 1 if need be"	^ self valueOfProperty: #lastRealJoystickIndex ifAbsentPut: [1] ! !!JoystickMorph methodsFor: 'accessing'!leftRight	^ (handleMorph center x - self center x) * xScale! !!JoystickMorph methodsFor: 'event handling'!mouseMove: evt	"Make handle track the cursor within my bounds."	| m r center |	m := handleMorph.	center := m center.	r := m owner innerBounds insetBy:		((center - m fullBounds origin) corner: (m fullBounds corner - center)).	m position: (evt cursorPoint adhereTo: r) - (m extent // 2).! !!JoystickMorph methodsFor: 'event handling' stamp: 'jm 11/18/97 14:26'!mouseUp: evt	lastAngle := self angle.	autoCenter ifTrue: [self moveHandleToCenter].! !!JoystickMorph methodsFor: 'other'!moveHandleToCenter	handleMorph position: self center - (handleMorph extent // 2).! !!JoystickMorph methodsFor: 'menu' stamp: 'sw 4/29/2004 19:57'!realJoystickInUse	"Answer whether a real joystick is in use"	^ realJoystickIndex notNil! !!JoystickMorph methodsFor: 'menu' stamp: 'sw 4/29/2004 18:29'!realJoystickString	"Answer a string characterizing whether or not I am currenty tracking a real joystick"	^ (realJoystickIndex ifNil: ['<no>'] ifNotNil: ['<yes>']), ('track real joystick' translated)! !!JoystickMorph methodsFor: 'menu' stamp: 'DamienCassou 9/29/2009 12:59'!setXRange	| range |	range := UIManager default		request:'Type the maximum value for the X axis' translated		initialAnswer: ((xScale * (self width - handleMorph width) / 2.0) roundTo: 0.01) printString.	range isEmptyOrNil ifFalse: [		xScale := (2.0 * range asNumber asFloat) / (self width - handleMorph width)].! !!JoystickMorph methodsFor: 'menu' stamp: 'DamienCassou 9/29/2009 12:59'!setYRange	| range |	range := UIManager default		request:'Type the maximum value for the Y axis'  translated		initialAnswer: ((yScale * (self width - handleMorph width) / 2.0) roundTo: 0.01) printString.	range isEmptyOrNil ifFalse: [		yScale := (2.0 * range asNumber asFloat) / (self width - handleMorph width)].! !!JoystickMorph methodsFor: 'stepping and presenter' stamp: 'bf 9/5/2005 11:19'!step	"Track the real joystick whose index is realJoystickIndex."	"Details:	  a. if realJoystickIndex is nil we're not tracking a joystick	  b. [-joyMax..joyMax] is nominal range of joystick in both X and Y	  c. [-threshold..threshold] is considered 0 to compensate for poor joystick centering"	| threshold joyMax joyPt joyBtn m mCenter r scaledPt  |	super step.  "Run ticking user-written scripts if any"	realJoystickIndex ifNil: [^ self].	threshold := 30.	joyMax := 350.	joyPt := Sensor joystickXY: realJoystickIndex.	joyBtn := Sensor joystickButtons: realJoystickIndex.	button1 := (joyBtn bitAnd: 1) > 0.	button2 := (joyBtn bitAnd: 2) > 0.		joyPt x abs < threshold ifTrue: [joyPt := 0@joyPt y].	joyPt y abs < threshold ifTrue: [joyPt := joyPt x@0].	lastRealJoystickValue = joyPt ifTrue: [^ self].	lastRealJoystickValue := joyPt.	m := handleMorph.	mCenter := m center.	r := m owner innerBounds insetBy:		((mCenter - m fullBounds origin) corner: (m fullBounds corner - mCenter)).	scaledPt := r center + ((r extent * joyPt) / (joyMax * 2)) truncated.	m position: (scaledPt adhereTo: r) - (m extent // 2).! !!JoystickMorph methodsFor: 'stepping and presenter' stamp: 'laza 6/8/2003 11:53'!stepTime	"Provide for as-fast-as-possible stepping in the case of a real joystick"	^ realJoystickIndex		ifNotNil:			[0]  "fast as we can to track actual joystick"		ifNil:			[super stepTime]! !!JoystickMorph methodsFor: 'menu' stamp: 'jm 6/22/1998 17:24'!stopTrackingJoystick	realJoystickIndex := nil.	self stopStepping.! !!JoystickMorph methodsFor: 'menu' stamp: 'jm 11/18/97 14:33'!toggleAutoCenter	autoCenter := autoCenter not.	autoCenter ifTrue: [self moveHandleToCenter].! !!JoystickMorph methodsFor: 'menu' stamp: 'sw 8/11/2004 18:15'!toggleRealJoystick	"Toggle whether or not one is using a real joystick"	realJoystickIndex		ifNil:			[realJoystickIndex := self valueOfProperty: #lastRealJoystickIndex ifAbsentPut: [1].			self startStepping]		ifNotNil:			[self stopTrackingJoystick]! !!JoystickMorph methodsFor: 'menu' stamp: 'DamienCassou 9/29/2009 12:59'!trackRealJoystick	| s |	s := UIManager default		request: 'Number of joystick to track?' translated		initialAnswer: '1'.	s isEmptyOrNil ifTrue: [^ self].	realJoystickIndex := Number readFromString: s.	self startStepping.! !!JoystickMorph methodsFor: 'accessing' stamp: 'jm 1/19/98 20:48'!upDown	^ (self center y - handleMorph center y) * yScale! !!StarMorph commentStamp: 'wiz 9/6/2005 12:30' prior: 37644006!I am a very flexible star..Grab me from the supplies flap or from the graphic objects.Add my handles and you can move and resize me.The up and down arrows increase or reduce the number of my sides.The right and left arrows cycle thru different amounts of  pointiness.Use the arrows right and left of my center or get stars with a specific amount of pointyness.  The left side goes from fat to thin and then cycles around again. The right goes from thin to fat. Hold down the shift key if you wish to stop the cycling at the extremes.Use the arrows up and down to change the number of sides if you would like a different number of points.To add or remove just one side hold the shift key down as you use the arrows or use the menu items for that purpose.If you add or remove just one point I will have an odd number of sides.  When that happens I can only look like a regular polygon. The right and left arrows will have no effect.  Add or remove just one more side and you can shift drag the outer handle or use the arrows to restore my pointiness. That was too complicated. It is gone. You can get regular polygon shapes by adjusting my pointiness. For example the extreme of a five pointed star is a dodecahedron (10 sided regular polygon) and one step less extreme is a pentagon (5 sided regular polygon).At some time you will probably shift drag the outer handle thru the center handle.While I looked round as you shrunk me, I will look very much like an asterisk as you pull me away.  What happens is that inside bend shrunk on the way down because it can never be larger than the outer point (or it wouldn't be the innerbend would it).But on the way out it is perfectly happy to remain small. So I look like an asterisk.To fatten me up  (if you haven't already figured this out by fooling around)  hold the shift down an move the outer handle towards the center (but not quite all the way) then let the shift up and move the outer handle away.  A couple of cycles like this and I'll be looking fat and jolly again. Or you can now just use the right arrow to make me fatter.This is also the reason I don't let the inside bend get larger than the outer point.If I did the same process that fattened me when I was an asterisk would also grow an asterisk so large squeak would complain about not having enough memory.Historical note:The former star had two bugs that are fixed here.The outer handle now no longer jumps from one point to another.The other bug prevented some higher order stars from looking right. Which is why the former star didn't allow you to change the number of points. !!StarMorph class methodsFor: 'parts bin' stamp: 'sw 8/2/2001 16:22'!descriptionForPartsBin	^ self partName:	'Star'		categories:		#('Graphics')		documentation:	'A symmetrical polygon in the shape of a star'! !!StarMorph class methodsFor: 'initialization' stamp: 'asm 4/11/2003 11:37'!initialize	self registerInFlapsRegistry.	! !!StarMorph class methodsFor: 'initialization' stamp: 'asm 4/11/2003 11:39'!registerInFlapsRegistry	"Register the receiver in the system's flaps registry"	self environment		at: #Flaps		ifPresent: [:cl | cl registerQuad: #(StarMorph		authoringPrototype	'Star'	'A star')						forFlapNamed: 'PlugIn Supplies'.						cl registerQuad: #(StarMorph	authoringPrototype	'Star'	'A star')						forFlapNamed: 'Supplies'.]! !!StarMorph class methodsFor: 'initialization' stamp: 'asm 4/11/2003 12:41'!unload	"Unload the receiver from global registries"	self environment at: #Flaps ifPresent: [:cl |	cl unregisterQuadsWithReceiver: self] ! !!StarMorph methodsFor: 'menu' stamp: 'wiz 9/5/2005 23:08'!addChangeSidesMenuItems: aCustomMenu hand: aHandMorph 	"Menu items to change number of sides."	aCustomMenu addLine.	aCustomMenu add: 'more sides' translated action: #moreVertices.	aCustomMenu add: 'fewer sides' translated action: #lessVertices."	Regular polygons can be simulated with the one of the skip stars 	and it would confuse users to have stars be limited to Regular polygons.	So we've removed those menu items - wiz""	aCustomMenu add: 'one more side' translated action: #oneMoreVertex.	aCustomMenu add: 'one fewer side' translated action: #oneLessVertex"! !!StarMorph methodsFor: 'menu' stamp: 'wiz 1/11/2005 14:55'!addCustomMenuItems: aCustomMenu hand: aHandMorph 	super addCustomMenuItems: aCustomMenu hand: aHandMorph.self addChangeSidesMenuItems: aCustomMenu hand: aHandMorph.self addTwinkleMenuItems: aCustomMenu hand: aHandMorph.	! !!StarMorph methodsFor: 'editing' stamp: 'wiz 12/15/2004 00:59'!addHandles	self addStarHandles! !!StarMorph methodsFor: 'editing' stamp: 'wiz 1/15/2005 00:20'!addStarHandles	"Outer handle must not be blocked so it comes first. 	The editing routine expects to find the center handle second.	The side and shape changing handles follow these."	| center |	self removeHandles.	"Check for old stars and correct order of vertices."	self insureCompatability .	handles := OrderedCollection new.	center := vertices average rounded.	self withCenterOuterHandles; withUpDownLeftRightHandlesAround: 6 center: center.	self placeHandles.	self changed.	! !!StarMorph methodsFor: 'menu' stamp: 'wiz 1/11/2005 20:38'!addTwinkleMenuItems: aCustomMenu hand: aHandMorph 	"Menu items to change the sharpness of the star."	aCustomMenu addLine.	aCustomMenu add: 'twinkle fatter' translated action: #nextTwinkle.	aCustomMenu add: 'twinkle thinner' translated action: #prevTwinkle."	aCustomMenu add: 'fatter star' translated action: #nextFatter.	aCustomMenu add: 'thinner star' translated action: #prevThinner"		! !!StarMorph methodsFor: 'editing' stamp: 'wiz 9/5/2005 23:12'!changeVertices: label event: evt fromHandle: handle 	| |	label == #more		ifTrue: [evt shiftPressed				ifTrue: [self moreVertices "not oneMoreVertex"]				ifFalse: [self moreVertices]].	label == #less		ifTrue: [evt shiftPressed				ifTrue: [self lessVertices "not oneLessVertex"]				ifFalse: [self lessVertices]].	label == #next		ifTrue: [evt shiftPressed				ifTrue: [self makeVertices: vertices size starRatio: self nextSkip]				ifFalse: [self makeVertices: vertices size starRatio: self nextTwinkleSkip]].	label == #prev		ifTrue: [evt shiftPressed				ifTrue: [self makeVertices: vertices size starRatio: self prevSkip]				ifFalse: [self makeVertices: vertices size starRatio: self prevTwinkleSkip]].	self computeBounds! !!StarMorph methodsFor: 'initialization' stamp: 'dgd 2/14/2003 22:35'!defaultBorderColor	"answer the default border color/fill style for the receiver"	^ Color black! !!StarMorph methodsFor: 'initialization' stamp: 'dgd 2/14/2003 22:40'!defaultBorderWidth	"answer the default border width for the receiver"	^ 1! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/11/2005 14:33'!defaultCenter	"answer the default center for the receiver"	^ 0 asPoint! !!StarMorph methodsFor: 'initialization' stamp: 'dgd 2/14/2003 22:31'!defaultColor	"answer the default color/fill style for the receiver"	^ Color lightBlue! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/11/2005 14:33'!defaultFirstVertex	"answer the default first outer point for the receiver.	This with the center determines the angle and size of the outer radius."	^ 10 asPoint! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/11/2005 14:28'!defaultSides	"answer the default number of sides for the receiver"	^ 10! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/11/2005 14:29'!defaultStarRatio	"answer the default ratio of outer radius to inner radius for the receiver"	^ 5.0 / 12.0! !!StarMorph methodsFor: 'editing' stamp: 'wiz 1/20/2005 19:07'!dragVertex: label event: evt fromHandle: handle 	| center r1 rN rNext a1 rTotal |	label == #outside		ifTrue: [center := handles second center.			r1 := center dist: vertices first.			"Rounding and what happens as the outer handle			approached the center, 			requires we guard the inner radius 			from becoming larger than the outer radius."			rN := r1						min: (center dist: vertices last).			rNext := 1						max: (center dist: evt cursorPoint).			a1 := 270.0						+ (center bearingToPoint: evt cursorPoint).			rTotal := vertices size even						ifTrue: [evt shiftPressed								ifTrue: [rNext + rNext min: rNext + rN]								ifFalse: [r1 + rN * rNext / r1]]						ifFalse: [rNext + rNext].			rNext := rTotal - rNext.			vertices := ((a1 to: a1 + 359.999 by: 360.0 / vertices size)						collect: [:angle | center								+ (Point r: (rNext := rTotal - rNext) degrees: angle)]) .			handle align: handle center with: evt cursorPoint].	label == #center		ifTrue: [evt shiftPressed				ifTrue: [self updateFormFromUser]				ifFalse: [self position: self position + (evt cursorPoint - handle center)]].	self computeBounds! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/11/2005 14:36'!initialize	"initialize the state of the receiver"	super initialize.	self		makeVertices: self defaultSides		starRatio: self defaultStarRatio		withCenter: self defaultCenter		withPoint: self defaultFirstVertex.	self computeBounds! !!StarMorph methodsFor: 'parts bin' stamp: 'sw 7/2/2001 11:07'!initializeToStandAlone	^ self initialize removeHandles! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/9/2005 20:15'!insureCompatability"The old stars had the point on the second not the first vertex. So we need to check for this special case." | c v1 v2 |c := vertices average rounded. v1 := vertices first . v2 := vertices second .(c dist: v1) + 0.001 < (c dist: v2) ifTrue: [vertices := vertices allButFirst copyWith: v1]! !!StarMorph methodsFor: 'menus' stamp: 'wiz 12/12/2004 16:43'!lessVertices"Reduce the number of points by one until we are  a diamond. If odd reduce the number of sides by two until we become a triangle. See class comment."	| nVerts |	( nVerts := 2 negated + vertices size) < 3 ifFalse: [	self		makeVertices: nVerts]! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 12/30/2004 02:57'!makeVertices: nSides 	"Assuming vertices has at least one point, make a new star 	or regular polygon (for odd sided polygons).	The center of the polygon and the first vertex remain in	place. The inner distances for stars remain the same also if	possible."	| center r1 rN rNext a1 rTotal |	center := vertices average rounded.	r1 := center dist: vertices first.	rN := center dist: vertices last.	rNext := 1 max: r1.	a1 := 270.0				+ (center bearingToPoint: vertices first).	rTotal := nSides even				ifTrue: [rNext + rNext min: rNext + rN]				ifFalse: [rNext + rNext].	rNext := rTotal - rNext.	self changed .	vertices := (a1 to: a1 + 359.999 by: 360.0 / nSides)				collect: [:angle | center						+ (Point r: (rNext := rTotal - rNext) degrees: angle)].	self computeBounds.	self changed! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/4/2005 19:31'!makeVertices: nSides starRatio: fraction	"Assuming vertices has at least one point, make a new star 	or regular polygon (for odd sided polygons).	The center of the polygon and the first vertex remain in	place. The inner distances for stars remain the same also if	possible."	| center r1 rN rNext a1 rTotal |	center := vertices average rounded.	r1 := center dist: vertices first.	rNext := 1 max: r1.	rN := (1.0 min: fraction) * rNext.	a1 := 270.0				+ (center bearingToPoint: vertices first).	rTotal := nSides even				ifTrue: [rNext + rNext min: rNext + rN]				ifFalse: [rNext + rNext].	rNext := rTotal - rNext.	self changed .	vertices := (a1 to: a1 + 359.999 by: 360.0 / nSides)				collect: [:angle | center						+ (Point r: (rNext := rTotal - rNext) degrees: angle)].	self computeBounds.	self changed! !!StarMorph methodsFor: 'initialization' stamp: 'wiz 1/11/2005 21:36'!makeVertices: nSides starRatio: fraction withCenter: center withPoint: aPoint 	"Make a new star or regular polygon (for odd sided polygons).	This makes star vertices from scratch without any feedback from existing vertices."	| r1 rN rNext a1 rTotal |	r1 := center dist: aPoint.	rNext := 1 max: r1.	rN := (1.0 min: fraction)				* rNext.	a1 := 270.0				+ (center bearingToPoint: aPoint).	rTotal := nSides even				ifTrue: [rNext + rNext min: rNext + rN]				ifFalse: [rNext + rNext].	rNext := rTotal - rNext.	self changed.	vertices := (a1 to: a1 + 359.999 by: 360.0 / nSides)				collect: [:angle | center						+ (Point r: (rNext := rTotal - rNext) degrees: angle)].	self computeBounds.	self changed! !!StarMorph methodsFor: 'menus' stamp: 'wiz 12/11/2004 16:45'!moreVertices	self makeVertices: 2+ vertices size! !!StarMorph methodsFor: 'geometry' stamp: 'wiz 1/19/2005 22:34'!nextSkip	"Set starRatio to next skip wrapping if needed."	| skips n c r1 rN |	c := vertices average rounded.	r1 := (c dist: vertices first) truncated asFloat.	rN := c dist: vertices last.	skips := self skipRatios.	n := skips * r1				findFirst: [:r | r > (rN + 1.0)].	"n = 0		ifTrue: [n := skips size]."	^ skips atWrap: n! !!StarMorph methodsFor: 'menus' stamp: 'wiz 1/11/2005 20:37'!nextTwinkle	self makeVertices: vertices size starRatio: self nextTwinkleSkip .	self computeBounds.! !!StarMorph methodsFor: 'geometry' stamp: 'wiz 1/19/2005 22:42'!nextTwinkleSkip	"Set starRatio to next skip wrapping if needed."	| skips n c r1 rN |	c := vertices average rounded.	r1 := (c dist: vertices first) truncated asFloat.	rN := c dist: vertices last.	skips := self skipRatios.	n := skips * r1				findFirst: [:r | r > (rN + 1.0)].	n = 0		ifTrue: [ n := 1].	^ skips atWrap: n! !!StarMorph methodsFor: 'menu' stamp: 'wiz 12/11/2004 16:45'!oneLessVertex	self		makeVertices: (3 max: 1 negated + vertices size)! !!StarMorph methodsFor: 'menu' stamp: 'wiz 12/11/2004 16:46'!oneMoreVertex	self makeVertices: 1 + vertices size! !!StarMorph methodsFor: 'editing' stamp: 'wiz 1/15/2005 00:19'!placeHandles	"Add the handles to my submorphs."	handles reverseDo: [:each | self addMorphFront: each ] .		! !!StarMorph methodsFor: 'geometry' stamp: 'wiz 1/19/2005 22:41'!prevSkip	"Set starRatio to next skip wrapping if necessary"	| skips n c r1 rN |	c := vertices average rounded.	r1 := c dist: vertices first.	rN := (c dist: vertices last) truncated asFloat.	skips := self skipRatios.	n := skips * r1				findLast: [:r | r + 1.0 < rN].	n = 0		ifTrue: [n := 1].	^ skips at: n! !!StarMorph methodsFor: 'menus' stamp: 'wiz 1/11/2005 20:37'!prevTwinkle	self makeVertices: vertices size starRatio: self prevTwinkleSkip .	self computeBounds.! !!StarMorph methodsFor: 'geometry' stamp: 'wiz 1/19/2005 22:19'!prevTwinkleSkip	"Set starRatio to next skip wrapping if necessary"	| skips n c r1 rN |	c := vertices average rounded.	r1 := c dist: vertices first.	rN := (c dist: vertices last) truncated asFloat.	skips := self skipRatios.	n := skips * r1				findLast: [:r | r + 1.0 < rN].	"n = 0	ifTrue: [^ oldR]."	^ skips atWrap: n! !!StarMorph methodsFor: 'access' stamp: 'wiz 1/11/2005 03:58'!skipRatios"Return an array of  ratios  of the inner radius to the outer radius.Ratios are in ascending order from 0.0 to 1.0.""Assume we have at least one vertex.All ways return a number <= 1.0"| n  alpha  |"Odd vertices sizes can not be stars only regular polygons"n:= vertices size . n odd ifTrue: [ ^ #(  1.0) ] .alpha := Float pi / (n//2)  asFloat .^ ((((    Float halfPi -alpha  to: alpha /2.0  by: alpha  negated ) 	collect:  [:angle |( (angle) sin )/					(angle + alpha ) sin ]	) copyWith: 0.0) copyWithFirst: 1.0) reversed .! !!StarMorph methodsFor: 'access' stamp: 'wiz 1/4/2005 20:14'!starRatio"Return the ratio of the inner radius to the outer radius.""Assume we have at least one vertex.All ways return a number <= 1.0"| r c |c := vertices average rounded .r := (c dist: vertices last) / (c dist:  vertices first)  .^ r > 1.0  ifTrue: [  r reciprocal ] ifFalse: [r ] .! !!StarMorph methodsFor: 'accessing' stamp: 'wiz 1/4/2005 19:47'!starRatio: r"Set the star s.t. the ratio of the inner radius to the outer radius is r.If r is > 1 use the reciprocal to keep the outer radius first.""Assume we have at least one vertex.setAll ways return a number <= 1.0"self makeVertices: vertices size starRatio:( r > 1.0  ifTrue: [  r reciprocal ] ifFalse: [r ] ).! !!StarMorph methodsFor: 'menus' stamp: 'wiz 1/15/2005 02:26'!updateFormFromUser"Does nothing here. Overridden in subclasses e.g. Kaleidoscope."^ self.! !!StarMorph methodsFor: 'editing' stamp: 'di 9/26/97 11:11'!updateHandles! !!StarMorph methodsFor: 'editing' stamp: 'wiz 1/11/2005 19:39'!withCenterOuterHandles	"Add to our handles the center positioning and outer resizing	handles. Outer handle must not be blocked so it comes first. 	The editing routine expects to find the center handle second.	The side and shape changing handles follow these."	| center v1 hExtent holder |	center := vertices average rounded.	hExtent := 8 @ 8.	v1 := vertices first.	holder := {(EllipseMorph				newBounds: (Rectangle center: v1 extent: hExtent)				color: Color yellow)				setBalloonText: 'Move me to adjust size. Shift move to adjust pointiness'. (EllipseMorph				newBounds: (Rectangle center: center extent: hExtent)				color: Color yellow)				setBalloonText: 'Move me to adjust position'}.	holder		with: {#outside. #center}		do: [:handle :which | handle				on: #mouseDown				send: #dragVertex:event:fromHandle:				to: self				withValue: which;								on: #mouseMove				send: #dragVertex:event:fromHandle:				to: self				withValue: which].	handles addAll: holder! !!StarMorph methodsFor: 'editing' stamp: 'wiz 1/11/2005 19:47'!withUpDownLeftRightHandlesAround: radius center: center	"Add to our handles the side and shape changing handles."	| tri  above holder  triAbove triBelow triRight triLeft |	above := 0 @ radius negated.		tri := Array				with: 0 @ -5				with: 4 @ 3				with: -4 @ 3.	triAbove := tri + (center + above).	triBelow := triAbove				collect: [:pt | pt rotateBy: #pi centerAt: center].	triRight := triAbove				collect: [:pt | pt rotateBy: #right centerAt: center].	triLeft := triAbove				collect: [:pt | pt rotateBy: #left centerAt: center].					holder := { (PolygonMorph				vertices: triAbove				color: Color green				borderWidth: 1				borderColor: Color black)				 setBalloonText: 'More points.'. 								(PolygonMorph				vertices: triBelow				color: Color magenta				borderWidth: 1				borderColor: Color black)				 setBalloonText: 'Fewer points.'. 								(PolygonMorph				vertices: triRight				color: Color green				borderWidth: 1				borderColor: Color black)				 setBalloonText: 'Twinkle fatter.'. 								(PolygonMorph				vertices: triLeft				color: Color magenta				borderWidth: 1				borderColor: Color black)				 setBalloonText: 'Twinkle thinner.'}.		holder		with: {#more. #less. #next. #prev}		do: [:handle :which | handle				on: #mouseDown				send: #changeVertices:event:fromHandle:				to: self				withValue: which;								on: #mouseMove				send: #changeVertices:event:fromHandle:				to: self				withValue: which].	^ handles addAll: holder! !!DoubleClickExample commentStamp: 'StephaneDucasse 8/19/2009 22:55' prior: 37646713!Illustrates the double-click capabilities of Morphic.DoubleClickExample new openInWorld 	If you have a kind of morph you wish to have respond specially to a double-click, it should:(1)  Respond "true" to #handlesMouseDown:(2)  In its mouseDown: method, send #waitForClicksOrDrag:event: to the hand.(3)  Reimplement #click: to react to single-clicked mouse-down.(4)  Reimplement #doubleClick: to make the appropriate response to a double-click.(5)  Reimplement #drag: to react to non-clicks.  This message is sent continuously until the button is released.  You can check the event argument to react differently on the first, intermediate, and last calls.!!DoubleClickExample class methodsFor: 'parts bin' stamp: 'sw 8/2/2001 12:46'!descriptionForPartsBin	^ self partName:	'DoubleClick'		categories:		#('Demo')		documentation:	'An example of how to use double-click in moprhic'! !!DoubleClickExample methodsFor: 'accessing' stamp: 'nk 7/26/2004 10:38'!balloonText	^ 'Double-click on me to change my color; single-click on me to change border color;hold mouse down within me and then move it to grow (if I''m red) or shrink (if I''m blue).' translated! !!DoubleClickExample methodsFor: 'event handling' stamp: 'ar 10/3/2000 17:05'!click: evt	self showBalloon: 'click' hand: evt hand.	self borderColor: (self borderColor = Color black ifTrue: [Color yellow] ifFalse: [Color black])! !!DoubleClickExample methodsFor: 'initialization' stamp: 'dgd 3/7/2003 14:22'!defaultColor"answer the default color/fill style for the receiver"	^ Color red! !!DoubleClickExample methodsFor: 'event handling' stamp: 'ar 10/3/2000 17:05'!doubleClick: evt	self showBalloon: 'doubleClick' hand: evt hand.	self color: ((color = Color blue) ifTrue: [Color red] ifFalse: [Color blue])! !!DoubleClickExample methodsFor: 'event handling' stamp: 'sw 9/14/1999 16:05'!handlesMouseDown: evt	^ true! !!DoubleClickExample methodsFor: 'event handling' stamp: 'bf 9/28/1999 17:20'!mouseDown: evt	"Do nothing upon mouse-down except inform the hand to watch for a double-click; wait until an ensuing click:, doubleClick:, or drag: message gets dispatched"	evt hand waitForClicksOrDrag: self event: evt! !!DoubleClickExample methodsFor: 'event handling' stamp: 'ar 10/3/2000 17:05'!startDrag: evt	"We'll get a mouseDown first, some mouseMoves, and a mouseUp event last"	| oldCenter |	evt isMouseDown ifTrue:		[self showBalloon: 'drag (mouse down)' hand: evt hand.		self world displayWorld.		(Delay forMilliseconds: 750) wait].	evt isMouseUp ifTrue:		[self showBalloon: 'drag (mouse up)' hand: evt hand].	(evt isMouseUp or: [evt isMouseDown]) ifFalse:		[self showBalloon: 'drag (mouse still down)' hand: evt hand].	(self containsPoint: evt cursorPoint)		ifFalse: [^ self].	oldCenter := self center.	color = Color red		ifTrue:			[self extent: self extent + (1@1)]		ifFalse:			[self extent: ((self extent - (1@1)) max: (16@16))].	self center: oldCenter! !!HeadingMorph commentStamp: 'StephaneDucasse 8/19/2009 23:00' prior: 37647455!A HeadingMorph displays an arrow on a grid as well as its decomposition on x and y axis.Clicking on it changes the direction of the main arrow.	HeadingMorph new openInWorld!!HeadingMorph methodsFor: 'initialization' stamp: 'dgd 3/7/2003 14:34'!defaultBorderWidth"answer the default border width for the receiver"	^ 1! !!HeadingMorph methodsFor: 'initialization' stamp: 'dgd 3/7/2003 14:33'!defaultColor"answer the default color/fill style for the receiver"	^ Color		r: 0.6		g: 1.0		b: 1.0! !!HeadingMorph methodsFor: 'accessing'!degrees	^ (degrees + 90.0) \\ 360.0! !!HeadingMorph methodsFor: 'accessing'!degrees: aNumber	degrees := (aNumber asFloat + 270.0) \\ 360.0.! !!HeadingMorph methodsFor: 'drawing'!drawArrowFrom: p1 to: p2 width: w color: aColor on: aCanvas	| d p |	d := (p1 - p2) theta radiansToDegrees.	aCanvas line: p1 to: p2 width: w color: aColor.	p := p2 + (Point r: 5 degrees: d - 50).	aCanvas line: p to: p2 width: w color: aColor.	p := p2 + (Point r: 5 degrees: d + 50).	aCanvas line: p to: p2 width: w color: aColor.! !!HeadingMorph methodsFor: 'drawing'!drawOn: aCanvas	| x y r center box |	super drawOn: aCanvas.	box := self innerBounds.	1 to: 9 do: [:i |		x := box left + ((box width * i) // 10).		aCanvas line: (x@box top) to: (x@(box bottom - 1)) color: Color black.		y := box top + ((box height * i) // 10).		aCanvas line: (box left@y) to: ((box right - 1)@y) color: Color black].	r := ((box width asFloat * magnitude asFloat) / 2.0) - 1.0.	center := box center.	self drawArrowFrom: center - (1@1)		to: center + ((r * degrees degreesToRadians cos)@0) - (1@1)		width: 3		color: (Color red)		on: aCanvas.	self drawArrowFrom: center - (1@1)		to: center + (0@(r * degrees degreesToRadians sin)) - (1@1)		width: 3		color: (Color red)		on: aCanvas.	self drawArrowFrom: center - (1@1)		to: center + (Point r: r degrees: degrees) - (1@1)		width: 3		color: Color black		on: aCanvas.! !!HeadingMorph methodsFor: 'geometry'!extent: aPoint	"Contrain extent to be square."	| d |	d := aPoint x min: aPoint y.	super extent: d@d.! !!HeadingMorph methodsFor: 'event handling'!handlesMouseDown: evt	^ true! !!HeadingMorph methodsFor: 'initialization' stamp: 'dgd 3/7/2003 14:34'!initialize	"initialize the state of the receiver"	super initialize.	""	degrees := 90.0.	magnitude := 1.0.		self extent: 160 @ 160! !!HeadingMorph methodsFor: 'accessing'!magnitude	^ magnitude! !!HeadingMorph methodsFor: 'accessing'!magnitude: aNumber	magnitude := (aNumber asFloat max: 0.0) min: 1.0.! !!HeadingMorph methodsFor: 'events' stamp: 'mk 11/7/2003 11:35'!mouseDown: evt	| v |	self changed.	v := evt cursorPoint - bounds center.	degrees := v theta radiansToDegrees.	magnitude := (v r asFloat / (bounds width asFloat / 2.0)) min: 1.0.! !!HeadingMorph methodsFor: 'events' stamp: 'mk 11/7/2003 11:36'!mouseMove: evt	self mouseDown: evt! !!StarWithABallMorph commentStamp: 'StephaneDucasse 8/20/2009 09:40' prior: 37647710!This is a example of how to use a morph. It consists of only two methods, initialize and step.DoIt:StarWithABall new openInWorld.!!StarWithABallMorph methodsFor: 'initialization' stamp: 'dgd 2/21/2003 19:59'!initialize	"initialize the state of the receiver"	super initialize.	phase := 1.	self extent: 200 @ 200.	ball := EllipseMorph new extent: 30 @ 30.	self		addMorph: ((star := StarMorph new extent: 150 @ 150) center: self center)! !!StarWithABallMorph methodsFor: 'stepping and presenter' stamp: 'kfr 10/26/2003 18:33'!step	phase := phase\\8 + 1.	phase = 1 ifTrue: [^ ball delete].	phase < 4 ifTrue:[^self].	phase = 4 ifTrue: [self addMorph: ball].	ball align: ball center with: (star vertices at: (phase-3*2)).! !!StickyPadMorph commentStamp: 'StephaneDucasse 8/20/2009 10:16' prior: 37647923!A custom item for the  Squeakland Supplies bin, as defined by Kim Rose and BJ Con.A parts bin will deliver up translucent, borderless Rectangles in a sequence of 6 colors.  It offers some complication to the parts-bin protocols in two ways::* The multi-colored icon seen in the parts bin is not a thumbnail of any actual instance, all of which are monochrome* New instances need to be given default names that are not the same as the name seen in the parts bin.StickyPadMorph minimics the stickyPad 	StickyPadMorph new openInWorld 	!!StickyPadMorph class methodsFor: 'parts bin' stamp: 'sw 4/4/2003 11:12'!descriptionForPartsBin	"Answer a description of the receiver for use in a parts bin"	^ self partName: 	'Sticky Pad'		categories:		#('Graphics')		documentation:	'A translucent, borderless rectangle of a standard size, delivered in a predictable sequence of pastel colors'		sampleImageForm: (Form extent: 50@40 depth: 16	fromArray: #( 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 1736271741 