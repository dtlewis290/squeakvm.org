target isKindOf: O2ClassAwareNode) and: [ requestor isSelected: target ]! !!O2CmdBrowseProtocol methodsFor: 'accessing' stamp: 'DM 5/20/2007 15:42'!keystroke	^ $P	! !!O2CmdBrowseProtocol methodsFor: 'accessing' stamp: 'DM 5/20/2007 15:38'!label	^ 'browse protocol'! !!O2CmdBrowseReferences methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#browse! !!O2CmdBrowseReferences methodsFor: 'execution' stamp: 'scg 8/24/2009 11:29'!execute	O2ReferencesBrowser browseRoot: target theNonMetaClass asO2Node! !!O2CmdBrowseReferences methodsFor: 'accessing' stamp: 'dr 6/26/2009 10:04'!group	^#navigation! !!O2CmdBrowseReferences methodsFor: 'testing' stamp: 'dr 6/5/2009 16:38'!isActive	^ (target isClassNode)		and: [requestor isSelected: target]! !!O2CmdBrowseReferences methodsFor: 'as yet unclassified' stamp: 'ben 8/3/2007 12:12'!keystroke	^ $N! !!O2CmdBrowseReferences methodsFor: 'accessing' stamp: 'dr 6/5/2009 16:38'!label	^ 'browse references'! !!O2CmdBrowseSendersOfIt class methodsFor: 'as yet unclassified' stamp: 'cwp 10/15/2006 01:00'!takesNodes	^ false! !!O2CmdBrowseSendersOfIt class methodsFor: 'as yet unclassified' stamp: 'cwp 10/15/2006 01:00'!takesText	^ true! !!O2CmdBrowseSendersOfIt methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| node |	node := O2SelectorNode on: target selector.	(requestor announce: (O2ShowSenders of: node)) execute! !!O2CmdBrowseSendersOfIt methodsFor: 'testing' stamp: 'cwp 10/14/2006 21:06'!isActive	^ true! !!O2CmdBrowseSendersOfIt methodsFor: 'testing' stamp: 'cwp 10/15/2006 19:31'!isEnabled	^ target hasSelector! !!O2CmdBrowseSendersOfIt methodsFor: 'accessing' stamp: 'cwp 3/11/2007 19:57'!keystroke	^ $n! !!O2CmdBrowseSendersOfIt methodsFor: 'accessing' stamp: 'cwp 3/11/2007 19:57'!label	^ 'senders'! !!O2CmdBrowseTraitUsers methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	"ugly hack to get rid of double..."	| users usersNames selection |	users := target theClass users asOrderedCollection asSet asOrderedCollection.	users ifEmpty: 		[ Beeper beep.		^ self ].	users size = 1 ifTrue: 		[ users first browse.		^ self ].	usersNames := users asOrderedCollection collect: [ :clsOrTrait | clsOrTrait name ].	selection := O2ChoiceRequest 		prompt: nil		labels: usersNames		values: users.	selection ifNotNil: [ selection browse ]! !!O2CmdBrowseTraitUsers methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ ((target isKindOf: O2ClassNode) and: [ target theClass isTrait ]) and: [ requestor isSelected: target ]! !!O2CmdBrowseTraitUsers methodsFor: 'accessing' stamp: 'ab 6/5/2007 23:48'!keystroke	^ $u! !!O2CmdBrowseTraitUsers methodsFor: 'accessing' stamp: 'ab 6/5/2007 23:48'!label	^ 'browse trait users...'! !!O2CmdChaseVariables methodsFor: 'accessing' stamp: 'lr 4/25/2007 09:28'!buttonLabel	^ 'variables'! !!O2CmdChaseVariables methodsFor: 'accessing' stamp: 'dr 2/16/2009 14:46'!buttonLabelWithSpaces	^ ' variables '! !!O2CmdChaseVariables methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#browse! !!O2CmdChaseVariables methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	^ O2VariablesBrowser browseRoot: target classNode! !!O2CmdChaseVariables methodsFor: 'accessing' stamp: 'dr 6/26/2009 10:05'!group	^ #navigation! !!O2CmdChaseVariables methodsFor: 'testing' stamp: 'dr 6/5/2009 16:38'!isActive	^ ((target isClassNode) "or: [(target respondsTo: #theClass) and: [target theClass notNil]]")		and: [requestor isSelected: target]! !!O2CmdChaseVariables methodsFor: 'accessing' stamp: 'cwp 10/10/2006 22:20'!label	^ 'chase variables'! !!O2CmdClassTemplate methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#'class templates'! !!O2CmdClassTemplate methodsFor: 'accessing' stamp: 'dc 7/16/2007 18:34'!currentCategory	^ target theNonMetaClass category! !!O2CmdClassTemplate methodsFor: 'accessing' stamp: 'dc 7/16/2007 18:36'!currentClass	^ target theNonMetaClass! !!O2CmdClassTemplate methodsFor: 'accessing' stamp: 'dc 7/16/2007 18:34'!currentEnvironment	^ target theNonMetaClass environment! !!O2CmdClassTemplate methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| definition |	definition := self templateDefinition.	definition ifNotNil: [ requestor announce: (O2DefinitionChanged definition: definition) ]! !!O2CmdClassTemplate methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) and: [ requestor isSelected: target ]! !!O2CmdClassTemplate methodsFor: 'private' stamp: 'dc 7/16/2007 18:42'!templateDefinition	self subclassResponsibility! !!O2CmdNewClassTemplate methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| class definition |	class := target theNonMetaClass.	definition := O2ClassDefinition 		environment: class environment		template: (Class template: class category).	requestor announce: (O2DefinitionChanged definition: definition)! !!O2CmdNewClassTemplate methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdNewClassTemplate methodsFor: 'accessing' stamp: 'dc 4/23/2007 14:29'!label	^ 'new class template'! !!O2CmdNewClassTemplate methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!templateDefinition	^ O2ClassDefinition 		environment: self currentEnvironment		template: (Class template: self currentCategory)! !!O2CmdNewTraitTemplate methodsFor: 'accessing' stamp: 'dr 4/27/2009 11:28'!group	^#xAdditional! !!O2CmdNewTraitTemplate methodsFor: 'accessing' stamp: 'dc 4/23/2007 15:03'!label	^ 'new trait template'! !!O2CmdNewTraitTemplate methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!templateDefinition	^ O2ClassDefinition 		environment: self currentEnvironment		template: (Trait newTemplateIn: self currentCategory)! !!O2CmdSubclassTemplate methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdSubclassTemplate methodsFor: 'accessing' stamp: 'cwp 12/7/2006 23:04'!label	^ 'subclass template'! !!O2CmdSubclassTemplate methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!templateDefinition	^ O2ClassDefinition 		environment: self currentEnvironment		template: (Class 				templateForSubclassOf: self currentClass				category: self currentCategory)! !!O2CmdCompareToCurrent methodsFor: 'accessing' stamp: 'dr 12/16/2008 10:28'!buttonLabel	^ 'compare to current'! !!O2CmdCompareToCurrent methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| defPanel s1 s2 text current change |	defPanel := requestor browser definitionPanel.	current := target source.	change := target version source.	s1 := current string.	s2 := change string.	s1 = s2 ifTrue: [ ^ self inform: 'Exact Match' translated ].	text := TextDiffBuilder 		buildDisplayPatchFrom: s1		to: s2		inClass: target theNonMetaClass		prettyDiffs: false.	defPanel definition: (O2TextDefinition text: text)! !!O2CmdCompareToCurrent methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodVersionNode) and: [ requestor isSelected: target ]! !!O2CmdCompareToCurrent methodsFor: 'accessing' stamp: 'dr 12/16/2008 10:28'!keystroke	^ $c! !!O2CmdCompareToCurrent methodsFor: 'accessing' stamp: 'dr 12/16/2008 10:29'!label	^ 'compare to current method'! !!O2CmdCompareToCurrent methodsFor: 'accessing' stamp: 'dr 12/16/2008 10:29'!longDescription	^ 'compare current method version to current selection'! !!O2CmdCompareToCurrent methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!wantsButton	^ target isKindOf: O2MethodVersionNode! !!O2CmdCopyClass methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdCopyClass methodsFor: 'as yet unclassified' stamp: 'PDC 6/25/2007 21:54'!copyClass: oldClass as: newName 	| oldDefinition newDefinition |	(oldClass environment hasClassNamed: newName) 		ifTrue: [^ self error: newName , ' already exists'].	oldDefinition := oldClass definition.	newDefinition := oldDefinition 				copyReplaceAll: '#' , oldClass name asString				with: '#' , newName asString.	^ Cursor wait showWhile: 			[| newClass |			newClass := Compiler evaluate: newDefinition logged: true.			newClass copyAllCategoriesFrom: oldClass.			newClass class copyAllCategoriesFrom: oldClass class.			newClass]! !!O2CmdCopyClass methodsFor: 'execution' stamp: 'scg 8/24/2009 11:29'!execute	| newName newClass |	newName := O2TextRequest 		prompt: 'Please type new class name'		template: target theNonMetaClassName asString.	newName ifNotNil: 		[ newClass := self 			copyClass: target theNonMetaClass			as: newName asSymbol.		self 			select: newClass asO2Node			with: requestor announcer ]! !!O2CmdCopyClass methodsFor: 'accessing' stamp: 'cwp 11/2/2006 22:00'!group	^ #identity! !!O2CmdCopyClass methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) and: [ requestor isSelected: target ]! !!O2CmdCopyClass methodsFor: 'accessing' stamp: 'cwp 11/2/2006 20:06'!label	^ 'copy...'! !!O2CmdCreateMonticelloCategory methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| organization catName |	organization := target organization.	catName := O2TextRequest 		prompt: 'Please type new category name'		template: self template.	catName ifNil: [ ^ self ].	(catName beginsWith: self template) ifFalse: [ ^ self inform: 'Class category should start with package name.' ].	catName ifNotNil: 		[ organization addCategory: catName.		target resetCache.		requestor listChanged.		self 			select: (O2MonticelloClassCategoryNode 					on: catName					workingCopy: target workingCopy)			with: requestor announcer.		requestor changed: #list ]! !!O2CmdCreateMonticelloCategory methodsFor: 'accessing' stamp: 'dr 6/5/2009 16:04'!group	^#general! !!O2CmdCreateMonticelloCategory methodsFor: 'accessing' stamp: 'dr 12/18/2007 16:37'!icon	^ #newIcon! !!O2CmdCreateMonticelloCategory methodsFor: 'testing' stamp: 'dr 5/6/2009 10:40'!isActive    ^(requestor isSelected: target) and: [target isPackage or: [target isClassCategoryNode]]! !!O2CmdCreateMonticelloCategory methodsFor: 'accessing' stamp: 'dr 12/18/2007 17:03'!label   ^'create category'! !!O2CmdCreateMonticelloCategory methodsFor: 'accessing' stamp: 'dr 8/11/2008 11:43'!template    ^target systemCategoryPrefix, '-'! !!O2CmdCreatePackage methodsFor: 'as yet unclassified' stamp: 'DamienCassou 9/23/2009 08:49'!execute	| name package workingCopy |	name := UIManager default request: 'Name of package:'.	name isEmptyOrNil ifTrue: [ ^ self ].	"PackageInfo named: name. "	package := MCPackage new name: name.	workingCopy := MCWorkingCopy forPackage: package.	requestor browser root resetCache.	requestor listChanged.	self 		select: (O2MonticelloPackageNode on: workingCopy)		with: requestor announcer! !!O2CmdCreatePackage methodsFor: 'as yet unclassified' stamp: 'dr 7/4/2009 20:25'!group	^#general! !!O2CmdCreatePackage methodsFor: 'as yet unclassified' stamp: 'dr 12/18/2007 16:37'!icon	^ #newIcon! !!O2CmdCreatePackage methodsFor: 'as yet unclassified' stamp: 'dr 7/4/2009 19:33'!isActive	^(target isEnvironment or: [(target isPackage) or: [target isClassCategoryNode]])		and: [(requestor isSelected: target)		and: [requestor switch selection < 2]]! !!O2CmdCreatePackage methodsFor: 'as yet unclassified' stamp: 'dr 4/27/2009 10:56'!label    ^'create package'! !!O2CmdCreatePackage methodsFor: 'as yet unclassified' stamp: 'dr 7/4/2009 20:26'!priority	^-1! !!O2CmdExcludeClass methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	(O2ConfirmationRequest 		prompt: 'Are you certain that you want to REMOVE the trait ' , target theNonMetaClassName , ' from the composition of ' , target parentNode theNonMetaClassName , '?'		confirm: 'Remove') ifFalse: [ ^ self ].	target parentNode theNonMetaClass traitComposition removeFromComposition: target theNonMetaClass.	target signalDeletion! !!O2CmdExcludeClass methodsFor: 'accessing' stamp: 'jk 8/26/2007 12:27'!group	^ #identity! !!O2CmdExcludeClass methodsFor: 'accessing' stamp: 'jk 8/26/2007 12:25'!icon	^ #deleteIcon! !!O2CmdExcludeClass methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) 		and: [ requestor isSelected: target ]		and: [ target isUsedTrait ]! !!O2CmdExcludeClass methodsFor: 'accessing' stamp: 'jk 8/26/2007 12:26'!keystroke	^ $x! !!O2CmdExcludeClass methodsFor: 'accessing' stamp: 'jk 8/26/2007 14:50'!label	^ 'remove from composition...'! !!O2CmdExcludeMethod methodsFor: 'as yet unclassified' stamp: 'jk 8/25/2007 20:28'!execute	target excludeSelector! !!O2CmdExcludeMethod methodsFor: 'as yet unclassified' stamp: 'jk 8/25/2007 20:50'!icon	^ #deleteIcon! !!O2CmdExcludeMethod methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) 		and: [ requestor isSelected: target ]		and: [ target isLocalSelector not ]! !!O2CmdExcludeMethod methodsFor: 'as yet unclassified' stamp: 'jk 8/25/2007 20:50'!keystroke	^ $x! !!O2CmdExcludeMethod methodsFor: 'as yet unclassified' stamp: 'jk 8/25/2007 20:51'!label	^ 'exclude/remove...'! !!O2CmdFileOut methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdFileOut methodsFor: 'execution' stamp: 'cwp 10/15/2006 18:50'!execute	target fileOut! !!O2CmdFileOut methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdFileOut methodsFor: 'testing' stamp: 'cwp 10/9/2006 15:43'!isActive	^ (requestor isSelected: target) 		and: [target respondsTo: #fileOut]! !!O2CmdFileOut methodsFor: 'accessing' stamp: 'dr 7/16/2008 11:13'!keystroke	^ $o! !!O2CmdFileOut methodsFor: 'accessing' stamp: 'cwp 10/7/2006 11:19'!label	^ 'file out'! !!O2CmdFindMethod methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!chooseSelector	| selectors |	selectors := target theClass selectors asSortedArray.	^ selectors isEmpty 		ifTrue: [ nil ]		ifFalse: [ O2ChoiceRequest labels: selectors ]! !!O2CmdFindMethod methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdFindMethod methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| selection method |	selection := self chooseSelector.	selection ifNotNil: 		[ method := O2MethodNode 			on: selection			inClass: target theClass.		self 			select: method			with: requestor announcer ]! !!O2CmdFindMethod methodsFor: 'accessing' stamp: 'cwp 6/8/2007 20:37'!icon	^ #findIcon! !!O2CmdFindMethod methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) and: [ requestor isSelected: target ]! !!O2CmdFindMethod methodsFor: 'accessing' stamp: 'cwp 11/3/2006 00:26'!label	^ 'find method...'! !!O2CmdFindMethodWildcard methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!chooseSelector	| aClass selectors reply |	aClass := target theClass.	selectors := aClass selectors asSortedArray.	selectors isEmpty ifTrue: [ ^ nil ].	reply := O2TextRequest 		prompt: 'Enter partial method name:'		template: '*'.	(reply isNil or: [ reply isEmpty ]) ifTrue: [ ^ nil ].	(reply includes: $*) ifFalse: [ reply := '*' , reply , '*' ].	selectors := selectors select: [ :each | reply match: each ].	selectors isEmpty ifTrue: [ ^ nil ].	reply := selectors size = 1 		ifTrue: [ selectors first ]		ifFalse: [ O2ChoiceRequest labels: selectors ].	^ reply! !!O2CmdFindMethodWildcard methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdFindMethodWildcard methodsFor: 'accessing' stamp: 'dc 7/15/2007 16:23'!label	^ 'find method wildcard...'! !!O2CmdFocusOnClassInHierarchy commentStamp: 'dr 4/14/2008 15:40' prior: 35453716!Special command triggered when a class in the class hierarchy browser gets double-clicked to focus in the hierarchy on that specific class.!!O2CmdFocusOnClassInHierarchy methodsFor: 'execution' stamp: 'dr 4/14/2008 16:33'!execute   requestor panel changeRootNode: target.! !!O2CmdLimitProtocol methodsFor: 'execution' stamp: 'DM 5/23/2007 14:49'!execute	| menu |	menu := (MenuMorph entitled: self menuString) defaultTarget: self.	menu		add: (self menuLabelForClass: target theClass)		selector: #limitClass:		argument: target theClass;		addLine.	target theClass allSuperclassesDo: 			[:each | 			menu 				add: (self menuLabelForClass: each)				selector: #limitClass:				argument: each].	menu popUpInWorld! !!O2CmdLimitProtocol methodsFor: 'testing' stamp: 'DM 5/23/2007 18:51'!isActive	^ target theClass ~= ProtoObject and: [requestor isSelected: target]! !!O2CmdLimitProtocol methodsFor: 'limit class' stamp: 'DM 5/22/2007 02:53'!isLimitClass: aClass	^ self limitClass = aClass.! !!O2CmdLimitProtocol methodsFor: 'accessing' stamp: 'DM 5/23/2007 15:26'!label	^ requestor browser theClass = ProtoObject 		ifTrue: ['limit']		ifFalse: ['limit: ' , self limitClass name]! !!O2CmdLimitProtocol methodsFor: 'limit class' stamp: 'DM 5/22/2007 18:41'!limitClass	^ requestor browser limitClass! !!O2CmdLimitProtocol methodsFor: 'limit class' stamp: 'scg 8/24/2009 10:45'!limitClass: aClass 	requestor		announce: (O2NodeChanged node: aClass);		announce: O2RefreshRequired new! !!O2CmdLimitProtocol methodsFor: 'private' stamp: 'DM 5/22/2007 04:03'!menuLabelForClass: aClass 	| content |	content := (self isLimitClass: aClass) 				ifTrue: [aClass name asText addAttribute: TextEmphasis bold]				ifFalse: [aClass name].	^ content! !!O2CmdLimitProtocol methodsFor: 'private' stamp: 'DM 5/21/2007 14:50'!menuString^ 'Show only methods implemented at or above...'! !!O2CmdLimitProtocol methodsFor: 'testing' stamp: 'DM 5/21/2007 14:23'!wantsButton^ true! !!O2CmdMethodToExtendClass methodsFor: 'accessing' stamp: 'dr 4/28/2009 11:06'!cluster	^#various! !!O2CmdMethodToExtendClass methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| className categoryName |	className := O2TextRequest 		prompt: 'Type the name of the class ' , String cr , 'you want to extend with this method:'		template: target theClass theNonMetaClass name asString.	className ifNotNil: 		[ (Smalltalk hasClassNamed: className asSymbol) ifFalse: [ ^ self inform: 'Class ' , className , ' does not exist!!' ].		categoryName := '*' , target theClass basicCategory asLowercase.		(Smalltalk at: className asSymbol) 			compile: target source			classified: categoryName			notifying: nil.		target theClass removeSelector: target selector.		requestor announce: (O2NodeDeleted node: target) ]! !!O2CmdMethodToExtendClass methodsFor: 'accessing' stamp: 'dr 4/28/2009 11:11'!group	^#xAdditional! !!O2CmdMethodToExtendClass methodsFor: 'testing' stamp: 'dr 7/3/2008 16:39'!isActive	^target isMethodNode and: [requestor isSelected: target]! !!O2CmdMethodToExtendClass methodsFor: 'accessing' stamp: 'dr 6/8/2009 16:46'!label    ^'move to class as extension...'! !!O2CmdBrowseSnapshot methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:34'!execute	(MCSnapshotBrowser forSnapshot: target package snapshot)			label: 'Snapshot Browser: ', target packageName;			show! !!O2CmdBrowseSnapshot methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:08'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdBrowseSnapshot methodsFor: 'as yet unclassified' stamp: 'dr 4/27/2009 10:54'!label    ^'browse snapshot'! !!O2CmdCheckRecentStatus methodsFor: 'execution' stamp: 'dr 12/10/2008 10:47'!execute    target updateRecentStatus.	requestor changed: #list.! !!O2CmdCheckRecentStatus methodsFor: 'testing' stamp: 'dr 7/21/2008 11:17'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdCheckRecentStatus methodsFor: 'accessing' stamp: 'dr 6/5/2009 16:19'!label    ^'check more recent on server'! !!O2CmdImportPackage methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| repo repos newLabel labels lines values |	newLabel := 'new...'.	labels := OrderedCollection with: newLabel.	values := OrderedCollection with: newLabel.	repos := MCRepositoryGroup default repositories asSortedCollection: [ :a :b | a description <= b description ].	lines := #(1 ).	labels addAll: (repos collect: [ :ea | ea description ]).	repo := O2ChoiceRequest 		prompt: 'Import package'		labels: labels		values: values , repos		lines: lines.	repo ifNotNil: 		[ repo = newLabel ifTrue: [ repo := self requestRepositoryToUser ].		repo 			ifNotNil: [ target workingCopy repositoryGroup addRepository: repo ]			ifNil: [ ^ self ].		"now add that package to this repo..."		target workingCopy newVersion ifNotNilDo: 			[ :v | 			(MCVersionInspector new version: v) show.			Cursor wait showWhile: [ repo storeVersion: v ].			MCCacheRepository default cacheAllFileNamesDuring: 				[ repo cacheAllFileNamesDuring: 					[ v allAvailableDependenciesDo: 						[ :dep | 						(repo includesVersionNamed: dep info name) ifFalse: [ repo storeVersion: dep ] ] ] ] ] ]! !!O2CmdImportPackage methodsFor: 'testing' stamp: 'dr 5/5/2009 11:21'!isActive 	^target isPackage and: [(requestor isSelected: target)	  			    	  and: [requestor switch selection < 2 					  and: [target workingCopy repositoryGroup repositories size < 2]]] ! !!O2CmdImportPackage methodsFor: 'accessing' stamp: 'dr 4/27/2009 10:53'!label   ^'add package to repository...'! !!O2CmdImportPackage methodsFor: 'execution' stamp: 'dr 7/3/2008 18:11'!requestRepositoryToUser	^MCHttpRepository morphicConfigure! !!O2CmdMonticello methodsFor: 'accessing' stamp: 'dr 4/27/2009 10:42'!cluster	^#Monticello! !!O2CmdOpenMC methodsFor: 'as yet unclassified' stamp: 'cb 7/16/2008 16:22'!execute	MCWorkingCopyBrowser new		workingCopy: target workingCopy ;		show! !!O2CmdOpenMC methodsFor: 'as yet unclassified' stamp: 'cb 7/16/2008 15:49'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdOpenMC methodsFor: 'as yet unclassified' stamp: 'cb 7/16/2008 16:28'!label    ^'open in MC'! !!O2CmdPublishPackage methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!execute	| repository |	target hasRepository ifFalse: [ ^ self ].	repository := target askForRepository.	repository ifNil: [ ^ self ].	(target checkForNewerVersionsAndAskIn: repository) ifFalse: [ ^ self ].	target workingCopy newVersion ifNotNilDo: 		[ :v | 		(MCVersionInspector new version: v) show.		Cursor wait showWhile: [ repository storeVersion: v ].		v allAvailableDependenciesDo: 			[ :dep | 			(repository includesVersionNamed: dep info name) ifFalse: [ repository storeVersion: dep ] ] ].	requestor announce: (O2ChildrenChanged node: requestor parent)! !!O2CmdPublishPackage methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:07'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdPublishPackage methodsFor: 'as yet unclassified' stamp: 'dr 4/24/2007 18:10'!label    ^'publish'! !!O2CmdUpdatePackage methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!execute	| repository versions fileName |	target hasRepository ifFalse: [ ^ self ].	repository := target askForRepository.	repository ifNil: [ ^ self ].	(target checkForNewerVersionsIn: repository) ifFalse: 		[ self inform: 'There are no newer versions available in this repository.'.		^ self ].	versions := (repository versionsAvailableForPackage: target workingCopy) select: [ :version | version last isDigit ].	versions := versions asSortedCollection: 		[ :a :b | 		| versionNr1 versionNr2 |		versionNr1 := (a copyAfterLast: $.) asInteger.		versionNr2 := (b copyAfterLast: $.) asInteger.		versionNr1 >= versionNr2 ].	(self confirm: 'Do you want to load version ' , versions first , '?') ifTrue: 		[ fileName := (repository allFileNamesForVersionNamed: versions first) first.		Cursor wait showWhile: [ (repository versionFromFileNamed: fileName) load ] ].	requestor announce: (O2ChildrenChanged node: requestor parent)! !!O2CmdUpdatePackage methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:07'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdUpdatePackage methodsFor: 'as yet unclassified' stamp: 'dr 12/14/2007 12:00'!label    ^'update'! !!O2CmdViewChanges methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:33'!execute	| patch repository |	target hasRepository ifFalse: [^self].	repository := target askForRepository.	repository ifNil: [^ self].	patch := target workingCopy changesRelativeToRepository: repository.	patch isNil ifTrue: [^ self].	patch isEmpty		ifTrue: [target workingCopy modified: false.				self inform: 'No changes' ]		ifFalse:				[target workingCopy modified: true.				(MCPatchBrowser forPatch: patch)					label: 'Patch Browser: ', target workingCopy description;					show]! !!O2CmdViewChanges methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:07'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdViewChanges methodsFor: 'as yet unclassified' stamp: 'dr 4/24/2007 18:36'!label    ^'changes'! !!O2CmdViewHistory methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:33'!execute	target workingCopy ifNil: [^self].	(MCWorkingHistoryBrowser new				ancestry: target workingCopy ancestry;				package: target package)			label:  'Version History: ', target packageName;			show! !!O2CmdViewHistory methodsFor: 'as yet unclassified' stamp: 'dr 4/11/2008 14:07'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdViewHistory methodsFor: 'as yet unclassified' stamp: 'dr 4/24/2007 18:37'!label    ^'history'! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!askForNewTraitFromClass: actualClass 	| traitName newTrait listOfTraits listOfTraitsNames index |	listOfTraits := actualClass traitComposition allTraits.	listOfTraitsNames := #('*New trait*' ) , (listOfTraits collect: [ :tr | tr name ]).	index := UIManager default 		chooseFrom: listOfTraitsNames		title: 'Please choose the trait to move the method to'.	"Cancel was pressed"	index = 0 ifTrue: [ ^ false ].	index ~= 1 ifTrue: [ ^ Smalltalk at: (listOfTraitsNames at: index) ].	traitName := O2TextRequest 		prompt: 'Name for the new trait'		template: 'T' , actualClass name asString.	(traitName isNil or: [ traitName isEmpty ]) ifTrue: [ ^ false ].	traitName := traitName asSymbol.	newTrait := (Smalltalk includesKey: traitName) 		ifTrue: [ Smalltalk at: traitName ]		ifFalse: 			[ self 				createTraitNamed: traitName				inCategory: actualClass category ].	^ newTrait! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!cannotMoveError: aString for: compiledMethod 	| index v |	self ignoreNotification ifTrue: [ ^ self ].	"	index := UIManager default chooseFrom: #('proceed' 'proceed to all moves' 'open a debugger') title: aString."	v := #('proceed' 'proceed to all moves' 'open a debugger' ).	index := O2ChoiceRequest 		prompt: aString		labels: v		values: v.	index = v third ifTrue: [ self error: aString ].	index = v second ifTrue: [ self doIgnoreNotification ]! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'accessing' stamp: 'dr 4/28/2009 11:14'!cluster	^#various! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'requirement' stamp: 'AlexandreBergel 1/7/2009 11:28'!doIgnoreNotification	ignoreNotification := true! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'as yet unclassified' stamp: 'ab 8/31/2007 19:27'!execute	| methodRefs newTrait |	methodRefs := target allMethods collect: [:each| each reference].	newTrait := self askForNewTraitFromClass: target theClass.	methodRefs do: [:each| self 		moveMethodNamed: each		inTrait: newTrait]! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'accessing' stamp: 'dr 4/27/2009 16:18'!group	^#xAdditional! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'requirement' stamp: 'AlexandreBergel 1/7/2009 11:31'!ignoreNotification	^ ignoreNotification ! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'initialize-release' stamp: 'AlexandreBergel 1/7/2009 11:27'!initialize	super initialize.	ignoreNotification := false! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodCategoryNode) and: [ requestor isSelected: target ]! !!O2CmdMoveMethodCategoryToTrait methodsFor: 'as yet unclassified' stamp: 'ab 8/31/2007 19:24'!label	^ 'move methods into new trait...'! !!O2CmdMoveMethodToTrait methodsFor: 'as yet unclassified' stamp: 'Alexandre Bergel 12/17/2009 22:07'!askForNewTraitFromClass: actualClass 	| traitName newTrait listOfTraits listOfTraitsNames index |	listOfTraits := actualClass traitComposition allTraits.	listOfTraitsNames := #('*New trait*' ) , (listOfTraits collect: [ :tr | tr name ]).	index := UIManager default 		chooseFrom: listOfTraitsNames		title: 'Please choose the trait to move the method to'.	"Cancel was pressed"	index = 0 ifTrue: [ ^ false ].	index ~= 1 ifTrue: [ ^ Smalltalk at: (listOfTraitsNames at: index) ].	traitName := O2TextRequest 		prompt: 'Name for the new trait'		template: 'T' , actualClass theNonMetaClass name asString.	(traitName isNil or: [ traitName isEmpty ]) ifTrue: [ ^ false ].	traitName := traitName asSymbol.	newTrait := (Smalltalk includesKey: traitName) 		ifTrue: [ Smalltalk at: traitName ]		ifFalse: 			[ self 				createTraitNamed: traitName				inCategory: actualClass theNonMetaClass category ].	^ newTrait! !!O2CmdMoveMethodToTrait methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!cannotMoveError: aString for: compiledMethod 	| index v |	self ignoreNotification ifTrue: [ ^ self ].	"	index := UIManager default chooseFrom: #('proceed' 'proceed to all moves' 'open a debugger') title: aString."	v := #('proceed' 'proceed to all moves' 'open a debugger' ).	index := O2ChoiceRequest 		prompt: aString		labels: v		values: v.	index = v third ifTrue: [ self error: aString ].	index = v second ifTrue: [ self doIgnoreNotification ]! !!O2CmdMoveMethodToTrait methodsFor: 'requirement' stamp: 'AlexandreBergel 1/7/2009 11:35'!doIgnoreNotification	ignoreNotification := true! !!O2CmdMoveMethodToTrait methodsFor: 'accessing' stamp: 'ab 9/1/2007 01:12'!execute	| actualClass aTrait |	actualClass := target theClass.	aTrait := self askForNewTraitFromClass: actualClass.	(aTrait = false) ifTrue: [^ false].	^ self moveMethodNamed: target reference inTrait: aTrait! !!O2CmdMoveMethodToTrait methodsFor: 'accessing' stamp: 'dr 4/27/2009 16:30'!group	^#xAdditional! !!O2CmdMoveMethodToTrait methodsFor: 'requirement' stamp: 'AlexandreBergel 1/7/2009 11:36'!ignoreNotification	^ ignoreNotification ! !!O2CmdMoveMethodToTrait methodsFor: 'initialize-release' stamp: 'AlexandreBergel 1/7/2009 11:33'!initialize	super initialize.	ignoreNotification := false! !!O2CmdMoveMethodToTrait methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) and: [ requestor isSelected: target ]! !!O2CmdMoveMethodToTrait methodsFor: 'accessing' stamp: 'dr 6/5/2009 17:12'!label	^ 'move to trait...'! !!O2CmdMoveToPackage methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| tmpPackages packageNames packages lines typeLabel answer |	typeLabel := 'type...'.	tmpPackages := (PackageOrganizer default packages reject: [ :pkg | pkg = target theNonMetaClass package ]) asSortedCollection: [ :a :b | a packageName <= b packageName ].	lines := #().	target isClassNode 		ifTrue: 			[ lines := #(1 ).			packages := OrderedCollection new.			packageNames := OrderedCollection new.			packages add: typeLabel.			packageNames add: typeLabel.			tmpPackages do: 				[ :pkg | 				packages add: pkg.				packageNames add: pkg packageName.				pkg systemCategories ifNotEmptyDo: 					[ :cats | 					cats allButFirst do: 						[ :cat | 						packages add: cat.						packageNames add: '   ' , cat ] ] ] ]		ifFalse: 			[ packages := tmpPackages.			packageNames := tmpPackages collect: [ :ea | ea packageName ] ].	answer := O2ChoiceRequest 		prompt: nil		labels: packageNames		values: packages		lines: lines.	answer ifNotNil: 		[ target isClassNode 			ifTrue: 				[ answer = typeLabel ifTrue: 					[ answer := self requestPackageToUser , (packageNames anySatisfy: [ :pkgName | pkgName withoutLeadingBlanks = answer ]) ifFalse: 						[ self inform: 'This package or class category does not exist!!'.						^ self ] ].				target theNonMetaClass category: (answer isString 						ifFalse: [ answer packageName ]						ifTrue: [ answer ]) ]			ifFalse: [ answer addMethod: target reference ] ]! !!O2CmdMoveToPackage methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^ #xAdditional! !!O2CmdMoveToPackage methodsFor: 'testing' stamp: 'dr 10/30/2008 09:55'!isActive	^ (target isMethodNode or: [target isClassNode]) and: [requestor isSelected: target]! !!O2CmdMoveToPackage methodsFor: 'accessing' stamp: 'cwp 12/11/2006 20:13'!label	^ 'move to package...'! !!O2CmdMoveToPackage methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!priority	^5! !!O2CmdMoveToPackage methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!requestPackageToUser	^ O2TextRequest 		prompt: 'Please type package or class category name'		template: ''! !!O2CmdMultiView methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdMultiView methodsFor: 'accessing' stamp: 'ms 6/27/2007 11:13'!compiledMethod	^target theClass 		compiledMethodAt: target selector 		ifAbsent: [CompiledMethod new]! !!O2CmdMultiView methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| viewType |	viewType := O2ChoiceRequest labels: #(#Source #Bytecode #Decompile #PrettyPrint ).	viewType ifNotNil: [ self perform: (#toggle , viewType) asSymbol ]! !!O2CmdMultiView methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdMultiView methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) and: [ requestor isSelected: target ]! !!O2CmdMultiView methodsFor: 'testing' stamp: 'ms 6/28/2007 17:56'!label	^ 'view...'! !!O2CmdMultiView methodsFor: 'accessing' stamp: 'dc 8/26/2008 17:54'!longDescription	^ 'display different views of the current method'! !!O2CmdMultiView methodsFor: 'utils' stamp: 'scg 8/24/2009 10:45'!setTextInDefinitionPanel: aTextOrString 	(requestor announce: O2AboutToChange) isVetoed ifFalse: 		[ requestor announce: (O2DefinitionChanged definition: (O2ReadOnlyDefinition new					setText: aTextOrString;					yourself)) ]! !!O2CmdMultiView methodsFor: 'utils' stamp: 'ms 6/27/2007 11:20'!toggleBytecode	self setTextInDefinitionPanel: self compiledMethod symbolic! !!O2CmdMultiView methodsFor: 'utils' stamp: 'ms 6/27/2007 11:20'!toggleDecompile	self setTextInDefinitionPanel: self compiledMethod decompileString! !!O2CmdMultiView methodsFor: 'utils' stamp: 'ms 6/27/2007 14:50'!togglePrettyPrint		self setTextInDefinitionPanel: 		(self class formatterClass 			format: target source in: target theClass			notifying: nil contentsSymbol: nil)! !!O2CmdMultiView methodsFor: 'utils' stamp: 'scg 8/24/2009 10:45'!toggleSource	(requestor announce: O2AboutToChange) isVetoed ifFalse: [ requestor announce: target definition ]! !!O2CmdPackageDependencies methodsFor: 'accessing' stamp: 'dr 6/5/2009 16:18'!cluster	^#Monticello! !!O2CmdPackageDependencies methodsFor: 'execution' stamp: 'scg 8/24/2009 11:29'!execute	| internalClasses packages packagesLocations externalDependenciesLocations |	packagesLocations := Dictionary new.	externalDependenciesLocations := Dictionary new.	internalClasses := target realClasses.	internalClasses do: 		[ :intClass | 		| dict |		dict := self externalReferencesIn: intClass.		dict keysAndValuesDo: 			[ :extClass :methods | 			| methodSet |			methodSet := externalDependenciesLocations 				at: extClass				ifAbsentPut: [ Set new ].			methodSet addAll: methods ] ].	externalDependenciesLocations keysAndValuesDo: 		[ :extClass :methods | 		| pkg methodSet |		pkg := PackageOrganizer default packageOfClass: extClass.		methodSet := packagesLocations 			at: pkg			ifAbsentPut: [ Set new ].		methodSet addAll: methods ].	packages := packagesLocations keys asSortedCollection: [ :a :b | a packageName <= b packageName ].	packages 		ifNotEmpty: 			[ | selection |			selection := O2ChoiceRequest 				prompt: nil				labels: (packages collect: [ :ea | ea packageName ])				values: packages.			selection ifNotNil: 				[ | methodList |				methodList := (packagesLocations at: selection) asSortedCollection: 					[ :a :b | 					a actualClass name <= b actualClass name and: [ a methodSymbol <= b methodSymbol ] ].				O2MessageSetBrowser 					browseRoot: (O2CollectionNode on: (methodList collect: [ :methodRef | methodRef asO2Node ]))					title: 'Dependencies to ' , selection packageName , ' in ' , target name ] ]		ifEmpty: [ self inform: 'No dependencies found.' ]! !!O2CmdPackageDependencies methodsFor: 'private' stamp: 'dr 3/27/2009 12:18'!externalReferencesIn: aClass     | refClassLocations |	refClassLocations := Dictionary new.	aClass methodDictionary values, aClass class methodDictionary values 			do: [:method | | dict |					dict := (self externalReferencesInMethod: method).				     dict keysAndValuesDo: [:class :methods | | methodSet |						methodSet := refClassLocations at: class ifAbsentPut: [Set new].					 	methodSet addAll: methods]].	^refClassLocations			! !!O2CmdPackageDependencies methodsFor: 'private' stamp: 'dr 3/27/2009 15:34'!externalReferencesInMethod: aCompiledMethod	| res methodSet |	res := Dictionary new.	aCompiledMethod literals do: [:l |		 (l isVariableBinding and: [l value isBehavior and: [(target realClasses includes: l value theNonMetaClass) not]])			ifTrue: [methodSet := res at: l value ifAbsentPut: [Set new].				     methodSet add: aCompiledMethod methodReference]].	^ res! !!O2CmdPackageDependencies methodsFor: 'testing' stamp: 'dr 3/19/2009 10:19'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdPackageDependencies methodsFor: 'accessing' stamp: 'dr 6/8/2009 16:44'!label	^'identify dependent packages'! !!O2CmdPackageToScope methodsFor: 'execution' stamp: 'dr 5/9/2008 14:10'!execute    ((Smalltalk at: #HOCollector) default isInPackageScope: target workingCopy)         ifTrue: [(Smalltalk at: #HOCollector) default removePackageFromScope: target workingCopy]        ifFalse: [(Smalltalk at: #HOCollector) default addPackageToScope: target workingCopy]! !!O2CmdPackageToScope methodsFor: 'accessing' stamp: 'dr 5/5/2008 11:46'!group    ^#dynamic! !!O2CmdPackageToScope methodsFor: 'testing' stamp: 'dr 12/22/2008 14:07'!isActive	^(Smalltalk hasClassNamed: #HOCollector) and: [target isPackage and: [requestor isSelected: target]]! !!O2CmdPackageToScope methodsFor: 'accessing' stamp: 'dr 5/9/2008 14:11'!label    ^((Smalltalk at: #HOCollector) default isInPackageScope: target workingCopy)         ifTrue: ['remove package from scope']        ifFalse: ['add package to scope'].! !!O2CmdRemoveCategory methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:35'!categoryOrProtocol	^ 'category'! !!O2CmdRemoveCategory methodsFor: 'testing' stamp: 'dr 7/4/2009 20:05'!isActive	^ target isClassCategoryNode and: [requestor isSelected: target]! !!O2CmdRemoveMonticelloCategory methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| list choice packageNode classCats |	packageNode := requestor browser root packages detect: [ :pkg | pkg workingCopy = target workingCopy ].	list := target container organization listAtCategoryNamed: target name.	list isEmpty ifTrue: 		[ target remove.		packageNode resetCache.		requestor listChanged.		classCats := packageNode classCategories.		classCats 			ifNotEmpty: 				[ self 					select: classCats first					with: requestor announcer ]			ifEmpty: 				[ self 					select: packageNode					with: requestor announcer ].		^ self ].	choice := O2ConfirmationRequest 		prompt: 'Are you sure you want toremove this category and all its elements?'		confirm: 'Remove'.	(choice notNil and: [ choice ]) ifTrue: 		[ target remove.		packageNode resetCache.		requestor listChanged.		classCats := packageNode classCategories.		classCats 			ifNotEmpty: 				[ self 					select: classCats first					with: requestor announcer ]			ifEmpty: 				[ self 					select: packageNode					with: requestor announcer ] ]! !!O2CmdRemoveMonticelloCategory methodsFor: 'testing' stamp: 'dr 7/4/2009 20:19'!isActive     target ifNil: [^false].    	^super isActive! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:31'!categoryOrProtocol	^ self subclassResponsibility! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| list choice |	list := target container organization listAtCategoryNamed: target name.	list isEmpty ifTrue: [ ^ target remove ].	choice := O2ConfirmationRequest 		prompt: 'Are you sure you want toremove this ' , self categoryOrProtocol , ' and all its elements?'		confirm: 'Remove'.	(choice notNil and: [ choice ]) ifTrue: [ ^ target remove ]! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'accessing' stamp: 'dr 7/3/2008 17:20'!group	^ #general! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'accessing' stamp: 'lr 6/9/2007 09:59'!icon	^ #deleteIcon! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'testing' stamp: 'onierstrasz 7/4/2009 18:39'!isActive	^ false! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'accessing' stamp: 'cwp 9/28/2006 08:37'!keystroke	^ $x! !!O2CmdRemoveCategoryOrProtocol methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:31'!label	^ 'remove ', self categoryOrProtocol, '...'! !!O2CmdRemoveProtocol methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:35'!categoryOrProtocol	^ 'protocol'! !!O2CmdRemoveProtocol methodsFor: 'testing' stamp: 'onierstrasz 7/4/2009 18:44'!isActive	^ target isMethodCategoryNode and: [requestor isSelected: target]! !!O2CmdRemoveClass methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| ans |	ans := O2ConfirmationRequest 		prompt: 'Are you certain that you want to REMOVE the class ' , target theNonMetaClassName , ' from the system?'		confirm: 'Remove'.	ans ifNil: [ ^ self ].	ans ifFalse: [ ^ self ].	target remove.	requestor announce: (O2NodeDeleted node: target)! !!O2CmdRemoveClass methodsFor: 'accessing' stamp: 'dr 6/26/2009 10:06'!group	^ #xAdditional! !!O2CmdRemoveClass methodsFor: 'accessing' stamp: 'cwp 6/8/2007 20:37'!icon	^ #deleteIcon! !!O2CmdRemoveClass methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) and: [ requestor isSelected: target ]! !!O2CmdRemoveClass methodsFor: 'accessing' stamp: 'cwp 11/3/2006 00:17'!keystroke	^ $x! !!O2CmdRemoveClass methodsFor: 'accessing' stamp: 'dr 7/3/2008 17:16'!label	^ 'remove class...'! !!O2CmdRemoveClass methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!priority	^4! !!O2CmdRemoveClassButUsedTrait methodsFor: 'testing' stamp: 'jk 9/21/2007 00:54'!isActive	^ super isActive		and: [target isUsedTrait not]! !!O2CmdRemoveElement methodsFor: 'execution' stamp: 'cb 7/19/2007 14:49'!execute	target removeChild: requestor selectedNode.	requestor listChanged! !!O2CmdRemoveElement methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2CollectionNode) and: [ requestor hasSelection ]! !!O2CmdRemoveElement methodsFor: 'accessing' stamp: 'cb 7/19/2007 14:33'!label	^'remove element'! !!O2CmdRemoveFromSmartGroup methodsFor: 'command' stamp: 'dr 7/21/2008 11:42'!execute     target remove.    requestor refresh.! !!O2CmdRemoveFromSmartGroup methodsFor: 'command' stamp: 'dr 4/5/2007 15:43'!group	^ #navigation! !!O2CmdRemoveFromSmartGroup methodsFor: 'command' stamp: 'scg 8/24/2009 10:45'!isActive	(target isSmartGroupCategory and: 		[ target name = 'default' or: [ target name = O2SmartRootNode searchGroupName ] ]) ifTrue: [ ^ false ].	^ target isSmartGroup and: [ (requestor isSelected: target) and: [ target isDummy not ] ]! !!O2CmdRemoveFromSmartGroup methodsFor: 'command' stamp: 'dr 10/22/2008 09:45'!keystroke	^ $x! !!O2CmdRemoveFromSmartGroup methodsFor: 'command' stamp: 'dr 4/5/2007 15:43'!label    ^'remove'! !!O2CmdRemoveLocalMethod methodsFor: 'testing' stamp: 'jk 9/21/2007 00:59'!isActive	^ super isActive and: [target isLocalSelector]! !!O2CmdRemoveMethod methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!browseSenders	O2SendersBrowser browseRoot: target! !!O2CmdRemoveMethod methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!doRemove	| methods idxToBeRemoved method |	methods := OrderedCollection new.	requestor previous ifNotNilDo: 		[ :column | 		| selectedNode |		selectedNode := column selectedNode.		(selectedNode isClassNode or: [ selectedNode isMethodCategoryNode ]) ifTrue: 			[ methods := selectedNode methods.			idxToBeRemoved := methods indexOf: target ] ].	target theClass removeSelector: target selector.	requestor announce: (O2NodeDeleted node: target).	methods size > 1 ifTrue: 		[ method := methods 			at: idxToBeRemoved + 1			ifAbsent: [ methods at: idxToBeRemoved - 1 ].		self 			select: method			with: requestor announcer ]! !!O2CmdRemoveMethod methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| senders choice |	senders := SystemNavigation default allCallsOn: target selector.	senders isEmpty ifTrue: [ ^ self doRemove ].	choice := O2ChoiceRequest 		prompt: 'This message has ' , senders size asString , ' senders.'		labels: #(				'Remove it'				'Remove, then browse senders'				'Don''t remove, but show me those senders'				'Forget it -- do nothing -- sorry I asked'			)		values: #(				#doRemove				#removeAndBrowse				#browseSenders				nil			).	choice ifNotNil: [ ^ self perform: choice ]! !!O2CmdRemoveMethod methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdRemoveMethod methodsFor: 'accessing' stamp: 'lr 6/9/2007 09:59'!icon	^ #deleteIcon! !!O2CmdRemoveMethod methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) and: [ requestor isSelected: target ]! !!O2CmdRemoveMethod methodsFor: 'accessing' stamp: 'cwp 12/8/2006 23:18'!keystroke	^ $x! !!O2CmdRemoveMethod methodsFor: 'accessing' stamp: 'dr 7/3/2008 17:13'!label	^ 'remove method...'! !!O2CmdRemoveMethod methodsFor: 'private' stamp: 'cwp 12/9/2006 20:37'!removeAndBrowse	self browseSenders.	self doRemove! !!O2CmdRemovePackage methodsFor: 'execution' stamp: 'dr 11/19/2008 14:20'!execute	(PopUpMenu confirm: 'Really remove package?') ifTrue: [		"remove all class cats first"		target classCategories do: [:node | node remove].				target workingCopy unload. 		requestor listChanged]! !!O2CmdRemovePackage methodsFor: 'accessing' stamp: 'dr 7/4/2009 21:06'!group	^#general! !!O2CmdRemovePackage methodsFor: 'accessing' stamp: 'dr 4/11/2008 14:01'!icon	^ #deleteIcon! !!O2CmdRemovePackage methodsFor: 'testing' stamp: 'dr 4/11/2008 14:07'!isActive	^target isPackage and: [requestor isSelected: target]! !!O2CmdRemovePackage methodsFor: 'accessing' stamp: 'dr 4/11/2008 14:02'!keystroke	^ $x! !!O2CmdRemovePackage methodsFor: 'accessing' stamp: 'dr 4/24/2007 18:49'!label    ^'remove package'! !!O2CmdRenameCategory methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:47'!categoryOrProtocol	^ 'category'! !!O2CmdRenameCategory methodsFor: 'testing' stamp: 'onierstrasz 7/4/2009 18:50'!isActive	^ target isClassCategoryNode and: [requestor isSelected: target]! !!O2CmdRenameCategoryOrProtocol methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:46'!categoryOrProtocol	^ self subclassResponsibility! !!O2CmdRenameCategoryOrProtocol methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| category |	category := O2TextRequest 		prompt: 'Please type new ' , self categoryOrProtocol , ' name'		template: target name.	category ifNotNil: 		[ target renameTo: category.		self 			select: (target setName: category)			with: requestor announcer ]! !!O2CmdRenameCategoryOrProtocol methodsFor: 'testing' stamp: 'onierstrasz 7/4/2009 18:45'!isActive	^ false! !!O2CmdRenameCategoryOrProtocol methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:49'!label	^ 'rename ', self categoryOrProtocol, '...'! !!O2CmdRenamePackage methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| packageName |	packageName := O2TextRequest 		prompt: 'Please type new package name'		template: target name.	packageName ifNotNil: 		[ target renamePackageTo: packageName.		target signalChanged ]! !!O2CmdRenamePackage methodsFor: 'testing' stamp: 'dr 4/11/2008 14:08'!isActive	^ target isPackage and: [requestor isSelected: target]! !!O2CmdRenamePackage methodsFor: 'accessing' stamp: 'dr 4/11/2008 14:08'!label	^ 'rename package...'! !!O2CmdRenameProtocol methodsFor: 'accessing' stamp: 'onierstrasz 7/4/2009 18:47'!categoryOrProtocol	^ 'protocol'! !!O2CmdRenameProtocol methodsFor: 'testing' stamp: 'onierstrasz 7/4/2009 18:45'!isActive	^ target isMethodCategoryNode and: [requestor isSelected: target]! !!O2CmdRenameSmartCategory methodsFor: 'command' stamp: 'scg 8/24/2009 10:45'!execute	| category |	category := O2TextRequest 		prompt: 'Please type new category name'		template: target name.	category ifNotNil: 		[ target name: category.		requestor panel columns first refresh ]! !!O2CmdRenameSmartCategory methodsFor: 'command' stamp: 'dr 3/12/2008 15:20'!isActive 	^target isSmartGroupCategory and: [target isSearchGroup not]! !!O2CmdRenameSmartCategory methodsFor: 'command' stamp: 'dr 3/1/2008 17:07'!label	^ 'rename smart group...'! !!O2CmdRenameClass methodsFor: 'as yet unclassified' stamp: 'scg 8/24/2009 10:45'!browseObsoleteRefs: aClassNode as: oldName 	| binding |	binding := aClassNode theNonMetaClass environment associationAt: aClassNode theNonMetaClass name.	(SystemNavigation default allCallsOn: binding) isEmpty ifFalse: 		[ O2ReferencesBrowser 			browseRoot: aClassNode			title: 'Obsolete references to' ]! !!O2CmdRenameClass methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| newName |	newName := O2TextRequest 		prompt: 'Please type new class name'		template: target theNonMetaClassName asString.	newName ifNotNil: 		[ | oldName |		oldName := target theNonMetaClass name.		target theNonMetaClass environment 			renameClassNamed: oldName			as: newName asSymbol.		self 			browseObsoleteRefs: target			as: oldName ]! !!O2CmdRenameClass methodsFor: 'accessing' stamp: 'dr 6/26/2009 10:06'!group	^ #xAdditional! !!O2CmdRenameClass methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) and: [ requestor isSelected: target ]! !!O2CmdRenameClass methodsFor: 'accessing' stamp: 'cwp 11/2/2006 22:47'!label	^ 'rename...'! !!O2CmdRenameClass methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!priority	^2! !!O2CmdReorgPackages methodsFor: 'accessing' stamp: 'dr 4/28/2009 15:29'!cluster	^#various! !!O2CmdReorgPackages methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| definition |	definition := O2OrganizationDefinition on: O2PackageBrowser packageOrganization.	requestor browser root resetCache.	requestor announce: definition! !!O2CmdReorgPackages methodsFor: 'accessing' stamp: 'dr 4/28/2009 15:29'!group	^#xAdditional! !!O2CmdReorgPackages methodsFor: 'testing' stamp: 'dr 6/5/2009 16:16'!isActive	"^ target isPackage and: [requestor isSelected: target]"	^false! !!O2CmdReorgPackages methodsFor: 'accessing' stamp: 'dr 11/19/2008 15:09'!label	^'reorganize packages'! !!O2CmdResetSearch methodsFor: 'execution' stamp: 'cb 7/19/2007 15:25'!execute	"OBSearchBrowser reset. self halt."	target setCollection: OrderedCollection new.	requestor  listChanged.! !!O2CmdResetSearch methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ target isKindOf: O2CollectionNode! !!O2CmdResetSearch methodsFor: 'accessing' stamp: 'cb 7/19/2007 14:47'!label	^'reset list'! !!O2CmdResetSearchSmartGroups methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| choice |	choice := O2ConfirmationRequest 		prompt: 'Are you sure you want to reset all searches smart groups?'		confirm: 'Reset'.	(choice notNil and: [ choice ]) ifTrue: 		[ target reset.		requestor panel columns first refresh ]! !!O2CmdResetSearchSmartGroups methodsFor: 'testing' stamp: 'dr 7/17/2008 11:30'!isActive 	^target isSmartGroupCategory and: [target isSearchGroup]! !!O2CmdResetSearchSmartGroups methodsFor: 'accessing' stamp: 'dr 7/17/2008 11:31'!label	^ 'reset searches smart group...'! !!O2CmdRevertMethod methodsFor: 'accessing' stamp: 'lr 4/25/2007 09:31'!buttonLabel	^ 'revert'! !!O2CmdRevertMethod methodsFor: 'execution' stamp: 'cwp 10/15/2006 18:54'!execute	target version fileIn! !!O2CmdRevertMethod methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodVersionNode) and: [ requestor isSelected: target ]! !!O2CmdRevertMethod methodsFor: 'accessing' stamp: 'cwp 10/9/2006 18:26'!keystroke	^ $r! !!O2CmdRevertMethod methodsFor: 'accessing' stamp: 'cwp 10/9/2006 18:24'!label	^ 'revert to version'! !!O2CmdRevertMethod methodsFor: 'accessing' stamp: 'dc 8/26/2008 17:56'!longDescription	^ 'reverts the method to the current selection'! !!O2CmdRevertMethod methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!wantsButton	^ target isKindOf: O2MethodVersionNode! !!O2CmdSUnit methodsFor: 'private' stamp: 'dc 8/2/2007 17:46'!buildSuite	self subclassResponsibility ! !!O2CmdSUnit methodsFor: 'execution' stamp: 'Alexandre.Bergel 3/13/2009 09:30'!execute	| res defectSelectors shouldDebug whatShouldBeDebugged |	res := self buildSuite run.	self ifSUnitSupportHistory: [self updateTestHistoryWith: res. requestor listChanged].	res hasPassed 		ifTrue: [ self successNotificationFor: res ]		ifFalse: 			[defectSelectors := res defects collect: [:ts | ts selector].			defectSelectors size > 2				ifTrue: [defectSelectors := (defectSelectors copyFrom: 1 to: 2), {'...'}].			defectSelectors := defectSelectors inject: ''						into: [:sum :el | sum , ' ' , el asString].			shouldDebug := UIManager default 								confirm: (res printString ,String cr, ' => ' , defectSelectors), 											String cr, 'Do you want to debug?'.			whatShouldBeDebugged := res errors asArray , res failures asArray.			shouldDebug ifTrue: [whatShouldBeDebugged first debug]]! !!O2CmdSUnit methodsFor: 'testing' stamp: 'dr 12/3/2008 20:57'!ifSUnitSupportHistory: aBlock	(TestResult includesSelector: #updateResultsInHistory) ifTrue: [aBlock value]! !!O2CmdSUnit methodsFor: 'accessing' stamp: 'dc 7/22/2007 20:45'!keystroke	^ $t! !!O2CmdSUnit methodsFor: 'accessing' stamp: 'dc 7/25/2007 16:12'!label	^ 'run the tests'! !!O2CmdSUnit methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!successNotificationFor: result 	| numberOfTests |	result passed = nil 		ifTrue: [ numberOfTests := 0 ]		ifFalse: [ numberOfTests := result passed size ].	O2InformRequest message: 'All ' , numberOfTests printString , ' tests pass!!'! !!O2CmdSUnit methodsFor: 'private' stamp: 'dr 11/24/2008 14:44'!updateTestHistoryWith: aResult	aResult dispatchResultsIntoHistory.! !!O2CmdTestClass methodsFor: 'execution' stamp: 'alexandre@bergel.eu 9/17/2007 11:18'!buildSuite	^ target theClass suite! !!O2CmdTestClass methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2ClassNode) 		and: [ requestor isSelected: target ]		and: [ target theClass inheritsFrom: TestCase ]! !!O2CmdTestMethod methodsFor: 'private' stamp: 'dr 11/24/2008 14:45'!buildSuite	| selector tests |	selector := target selector.	tests := target theClass suite tests select: [ :each | selector = each selector ].	^ TestSuite new addTests: tests! !!O2CmdTestMethod methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) 		and: [ requestor isSelected: target ]		and: [ target theClass inheritsFrom: TestCase ]		and: [ target selector beginsWith: 'test' ]		and: [ target selector isUnary ]! !!O2CmdTestMethod methodsFor: 'private' stamp: 'dr 11/24/2008 14:42'!updateTestHistoryWith: aResult	aResult updateResultsInHistory ! !!O2CmdTestPackage methodsFor: 'private' stamp: 'alexandre@bergel.eu 9/24/2007 11:41'!buildSuite	^ target classes		inject: TestSuite new		into: [:suite :classNode | 				(classNode theClass inheritsFrom: TestCase)						ifTrue: [suite addTests: classNode theClass suite tests].				suite]	! !!O2CmdTestPackage methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ ((target isKindOf: O2ClassCategoryNode) or: [ target isKindOf: O2MonticelloPackageNode ]) 		and: [ requestor isSelected: target ]		and: 			[ target classes anySatisfy: [ :cls | cls theClass inheritsFrom: TestCase ] ]! !!O2CmdTestProtocol methodsFor: 'private' stamp: 'alexandre@bergel.eu 9/24/2007 09:55'!buildSuite	| selectorUnderTheCategory tests |	selectorUnderTheCategory := target theClass organization listAtCategoryNamed: target category.	tests := target theClass suite tests select: [:each| selectorUnderTheCategory includes: each selector].	^ TestSuite new addTests: tests! !!O2CmdTestProtocol methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodCategoryNode) 		and: [ target theClass inheritsFrom: TestCase ]		and: 			[ target methodReferences anySatisfy: [ :ref | ref methodSymbol beginsWith: 'test' ] ]		and: [ requestor isSelected: target ]! !!O2CmdTestProtocol methodsFor: 'private' stamp: 'dr 11/24/2008 14:41'!updateTestHistoryWith: aResult	aResult updateResultsInHistory ! !!O2CmdSearchGroupClassRefs methodsFor: 'execution' stamp: 'scg 8/24/2009 11:29'!execute	"needs some work to find classname for sure in query"	| className |	className := target alias query first asSymbol.	(Smalltalk hasClassNamed: className) ifTrue: 		[ "should also work for wildcard searches"		O2ReferencesBrowser browseRoot: (Smalltalk at: className) asO2Node.		^ self ].	self inform: 'No references found.'! !!O2CmdSearchGroupClassRefs methodsFor: 'testing' stamp: 'dr 2/13/2009 11:29'!isActive	^target isSmartAlias and: [target isSearchAlias and: [target alias isClassSearch and: [requestor isSelected: target]]]! !!O2CmdSearchGroupClassRefs methodsFor: 'accessing' stamp: 'dr 8/11/2008 16:21'!label    ^'all references'! !!O2CmdSearchGroupImplementors methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	(requestor announce: (O2ShowImplementors of: target alias)) execute! !!O2CmdSearchGroupImplementors methodsFor: 'testing' stamp: 'dr 2/13/2009 11:29'!isActive	^target isSmartAlias and: [target isSearchAlias and: [target alias isMethodSearch and: [requestor isSelected: target]]]! !!O2CmdSearchGroupImplementors methodsFor: 'accessing' stamp: 'dr 8/11/2008 14:45'!label    ^'all implementors'! !!O2CmdSearchGroupSenders methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	(requestor announce: (O2ShowSenders of: target alias)) execute! !!O2CmdSearchGroupSenders methodsFor: 'testing' stamp: 'dr 2/13/2009 11:29'!isActive	^target isSmartAlias and: [target isSearchAlias and: [target alias isMethodSearch and: [requestor isSelected: target]]]! !!O2CmdSearchGroupSenders methodsFor: 'accessing' stamp: 'dr 8/11/2008 15:31'!label    ^'all senders'! !!O2CmdFindClass methodsFor: 'private' stamp: 'lr 8/3/2007 11:53'!allBehaviorsIn: anEnvironment 	^ anEnvironment classNames asArray! !!O2CmdFindClass methodsFor: 'private' stamp: 'cwp 7/20/2007 21:51'!candidateClassesIn: anEnvironment pattern: pattern 	| matching |	matching := (self allBehaviorsIn: anEnvironment) select: (self selectorBlockFor: pattern).	^ matching isEmpty		ifTrue: [nil]		ifFalse: [matching]! !!O2CmdFindClass methodsFor: 'private' stamp: 'PDC 6/28/2007 07:10'!findClassIn: anEnvironment pattern: pattern 	| classNames className |	classNames := (self candidateClassesIn: anEnvironment pattern: pattern) ifNil: [^ nil].	className := classNames size = 1 				ifTrue: [classNames first]				ifFalse: 					[self userSelectionOf: classNames for: (pattern copyWithout: $.) asLowercase].	^ className ifNotNil: [anEnvironment at: className asSymbol]! !!O2CmdFindClass methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#atTop! !!O2CmdFindClass methodsFor: 'accessing' stamp: 'cwp 10/9/2006 13:39'!keystroke	^ $f! !!O2CmdFindClass methodsFor: 'accessing' stamp: 'cwp 10/9/2006 13:34'!label	^ 'find class...'! !!O2CmdFindClass methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!priority	^-1! !!O2CmdFindClass methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!requestClassToUser	| pattern |	pattern := O2TextRequest 		prompt: 'Please type the name or fragment to look for'		template: ''.	pattern ifNil: [ ^ nil ].	^ self 		findClassIn: target environment		pattern: pattern! !!O2CmdFindClass methodsFor: 'private' stamp: 'PDC 6/28/2007 06:50'!selectorBlockFor: pattern 	| toMatch |	toMatch := (pattern copyWithout: $.) asLowercase.	^ (pattern endsWith: '.') 		ifTrue: [[:ea | ea asLowercase = toMatch]]		ifFalse: [[:ea | ea includesSubstring: toMatch caseSensitive: false]]! !!O2CmdFindClass methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!userSelectionOf: classNames for: toMatch 	| exactMatch |	exactMatch := classNames 		detect: [ :ea | ea asLowercase = toMatch ]		ifNone: [ nil ].	^ exactMatch 		ifNil: 			[ O2ChoiceRequest 				labels: classNames				lines: #() ]		ifNotNil: 			[ O2ChoiceRequest 				labels: (classNames copyWithFirst: exactMatch)				lines: #(1 ) ]! !!O2CmdFindClassOrTrait methodsFor: 'private' stamp: 'dc 5/17/2007 12:54'!allBehaviorsIn: anEnvironment	^ Array streamContents: [:stream|				stream			nextPutAll: anEnvironment classNames;			nextPutAll: anEnvironment traitNames 				]! !!O2CmdRecentClasses methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#atTop! !!O2CmdRecentClasses methodsFor: 'accessing' stamp: 'dc 7/16/2007 15:05'!label	^ 'recent classes...'! !!O2CmdRecentClasses methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!requestClassToUser	| classeNames |	classeNames := O2RecentClasses default classes.	^ classeNames isEmpty 		ifTrue: [ nil ]		ifFalse: 			[ O2ChoiceRequest 				prompt: nil				labels: classeNames				values: (classeNames collect: 					[ :name | 					Smalltalk 						at: name						ifAbsent: nil ]) ]! !!O2CmdSearchingClasses methodsFor: 'execution' stamp: 'scg 8/24/2009 11:29'!execute	| class |	class := self requestClassToUser.	class ifNotNil: 		[ self 			select: class asO2Node			with: requestor announcer ]! !!O2CmdSearchingClasses methodsFor: 'accessing' stamp: 'dc 7/16/2007 15:04'!group	^ #class! !!O2CmdSearchingClasses methodsFor: 'accessing' stamp: 'dc 7/16/2007 15:04'!icon	^ #findIcon! !!O2CmdSearchingClasses methodsFor: 'testing' stamp: 'dc 7/16/2007 15:04'!isActive	^ target isEnvironment! !!O2CmdSearchingClasses methodsFor: 'private' stamp: 'dc 7/16/2007 15:03'!requestClassToUser	"Ask the user for the class he wants to visit. Returns a class or nil."	self subclassResponsibility ! !!O2CmdSelectMethodCategory methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdSelectMethodCategory methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	(requestor parent isKindOf: O2AllMethodCategoryNode) 		ifTrue: 			[ self 				select: (O2MethodCategoryNode 						on: (target theClass organization categoryOfElement: target selector)						inClass: target theClass)				with: requestor announcer ]		ifFalse: 			[ self 				select: (O2AllMethodCategoryNode on: target theClass)				with: requestor announcer ].	self 		select: target		with: requestor announcer! !!O2CmdSelectMethodCategory methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdSelectMethodCategory methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) and: [ requestor isSelected: target ]! !!O2CmdSelectMethodCategory methodsFor: 'accessing' stamp: 'dc. 12/15/2007 15:36'!keystroke	^ $C! !!O2CmdSelectMethodCategory methodsFor: 'accessing' stamp: 'cb 4/15/2008 22:20'!label	^ 'toggle -- all -- / category '! !!O2CmdToggleBreak methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#various! !!O2CmdToggleBreak methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	target reference compiledMethod hasBreakpoint 		ifTrue: [ BreakpointManager unInstall: target reference compiledMethod ]		ifFalse: 			[ BreakpointManager 				installInClass: target theClass				selector: target selector ].	requestor announce: (O2DefinitionChanged definition: target definition).	requestor refresh! !!O2CmdToggleBreak methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!group	^#xAdditional! !!O2CmdToggleBreak methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) and: [ requestor isSelected: target ]! !!O2CmdToggleBreak methodsFor: 'accessing' stamp: 'dr 4/11/2008 12:11'!label	^ 'toggle break on entry'! !!O2CmdTogglePackageScope methodsFor: 'execution' stamp: 'dr 5/9/2008 14:11'!execute    (Smalltalk at: #HOCollector) default toggleIgnorePackageScope! !!O2CmdTogglePackageScope methodsFor: 'accessing' stamp: 'dr 5/5/2008 15:25'!group    ^#dynamic! !!O2CmdTogglePackageScope methodsFor: 'testing' stamp: 'dr 12/22/2008 14:07'!isActive	^target isEnvironment and: [Smalltalk hasClassNamed: #HOCollector]! !!O2CmdTogglePackageScope methodsFor: 'execution' stamp: 'dr 5/9/2008 14:11'!label    ^(Smalltalk at: #HOCollector) default ignorePackageScope         ifTrue: ['do not show calls outside package']         ifFalse: ['show calls outside package']! !!O2Command class methodsFor: 'instance creation' stamp: 'cwp 10/14/2006 23:29'!on: target for: requestor	^ self new setTarget: target requestor: requestor! !!O2Command class methodsFor: 'testing' stamp: 'cwp 10/15/2006 00:58'!takesNodes	^ true! !!O2Command class methodsFor: 'testing' stamp: 'cwp 10/15/2006 00:58'!takesText	^ false! !!O2Command methodsFor: 'user interface' stamp: 'cwp 6/8/2007 20:45'!addItemToMenu: aMenu	self isActive ifTrue:		[aMenu			add: self labelWithKeystroke			target: self 			selector: #execute			enabled: self isEnabled			icon: self icon]! !!O2Command methodsFor: 'accessing' stamp: 'dr 2/16/2009 14:41'!buttonLabel	^self label! !!O2Command methodsFor: 'accessing' stamp: 'dr 2/16/2009 14:41'!buttonLabelWithSpaces	^' ', self label, ' '! !!O2Command methodsFor: 'accessing' stamp: 'cwp 9/30/2007 18:59'!cluster	^ nil! !!O2Command methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!createCluster	^ O2CommandCluster label: self cluster! !!O2Command methodsFor: 'execution' stamp: 'cwp 10/15/2006 14:12'!execute	! !!O2Command methodsFor: 'accessing' stamp: 'cwp 10/6/2006 21:44'!group	^ #general! !!O2Command methodsFor: 'accessing' stamp: 'cwp 10/6/2006 18:45'!icon	^ nil! !!O2Command methodsFor: 'testing' stamp: 'cwp 10/15/2006 22:05'!isActive	^ false! !!O2Command methodsFor: 'testing' stamp: 'cwp 10/15/2006 19:31'!isEnabled	^ true! !!O2Command methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!isReferenceListCmd    ^false! !!O2Command methodsFor: 'accessing' stamp: 'cwp 9/27/2006 22:53'!keystroke	^ nil! !!O2Command methodsFor: 'accessing' stamp: 'cwp 9/27/2006 22:53'!label	self subclassResponsibility! !!O2Command methodsFor: 'accessing' stamp: 'dr 7/10/2008 14:44'!labelWithKeystroke	^ self keystroke		ifNil: [self label]		ifNotNil: [self label, ' (', self keystroke asString, ')']! !!O2Command methodsFor: 'accessing' stamp: 'dc 8/3/2007 12:50'!longDescription	"Override this and return a string or a text for the fly-by-help (tooltip)"	^ nil! !!O2Command methodsFor: 'accessing' stamp: 'cwp 10/14/2006 23:39'!on: anObject for: aRequestor	^ self class on: anObject for: aRequestor! !!O2Command methodsFor: 'user interface' stamp: 'dc 1/3/2008 10:11'!order	^ self label! !!O2Command methodsFor: 'user interface' stamp: 'cwp 10/15/2006 12:37'!perform: aSelector orSendTo: anObject	self perform: aSelector! !!O2Command methodsFor: 'accessing' stamp: 'dr 5/6/2009 11:17'!priority	^0! !!O2Command methodsFor: 'user interface' stamp: 'scg 8/24/2009 10:45'!select: aNode with: anAnnouncer 	(anAnnouncer announce: O2AboutToChange) isVetoed ifFalse: [ anAnnouncer announce: (O2SelectingNode node: aNode) ]! !!O2Command methodsFor: 'initialize-release' stamp: 'DamienCassou 12/23/2009 16:36'!setTarget: anObject requestor: aRequestor	target := anObject.	requestor := aRequestor! !!O2Command methodsFor: 'testing' stamp: 'cwp 10/14/2006 19:38'!takesNodes	^ true! !!O2Command methodsFor: 'testing' stamp: 'cwp 10/14/2006 19:37'!takesText	^ false! !!O2Command methodsFor: 'testing' stamp: 'cwp 9/27/2006 22:53'!wantsButton	"Put this here for compatibility. Eventually this will be obsolete"	^ false! !!O2Command methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!wantsTabButton    ^false! !!O2PluggableCommand class methodsFor: 'as yet unclassified' stamp: 'cwp 6/18/2006 18:53'!action: aValuable	^ self new action: aValuable! !!O2PluggableCommand class methodsFor: 'as yet unclassified' stamp: 'cwp 10/15/2006 13:50'!action: aValuable active: aValuable2	^ self new 		action: aValuable;		active: aValuable2;		yourself! !!O2PluggableCommand class methodsFor: 'as yet unclassified' stamp: 'cwp 6/24/2006 15:43'!new	^ self basicNew initialize! !!O2PluggableCommand class methodsFor: 'as yet unclassified' stamp: 'cwp 10/15/2006 00:57'!takesNodes	^ true! !!O2PluggableCommand class methodsFor: 'as yet unclassified' stamp: 'cwp 10/15/2006 00:58'!takesText	^ false! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'dc 4/28/2007 11:36'!action: aValuable	action := aValuable! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'dc 4/28/2007 11:36'!active: aValuable	active := aValuable! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'cwp 10/15/2006 13:41'!buttonLabel	^ buttonLabel! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!buttonLabel: aString	buttonLabel := aString! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'cwp 6/2/2009 01:20'!buttonLabelWithSpaces	^ ' ', self buttonLabel, ' '! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!enabled: aBlock	enabled := aBlock! !!O2PluggableCommand methodsFor: 'execute' stamp: 'dkh 5/31/2007 13:53'!execute	^ action valueWithPossibleArgs: (Array with: target with: requestor)! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'cwp 10/15/2006 13:37'!icon	^ icon! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!icon: anIcon	icon := anIcon! !!O2PluggableCommand methodsFor: 'initialize-release' stamp: 'DamienCassou 12/23/2009 16:36'!initialize	action := [].	active := [true].	enabled := [true].	label := 'a command'.! !!O2PluggableCommand methodsFor: 'testing' stamp: 'dkh 5/31/2007 13:53'!isActive	^ active valueWithPossibleArgs: (Array with: target with: requestor)! !!O2PluggableCommand methodsFor: 'testing' stamp: 'dkh 5/31/2007 13:53'!isEnabled	^ enabled valueWithPossibleArgs: (Array with: target with: requestor)! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'cwp 6/24/2006 19:04'!keystroke	^ keystroke! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!keystroke: aCharacter	keystroke := aCharacter! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'cwp 6/24/2006 19:04'!label	^ label! !!O2PluggableCommand methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!label: aString	label := aString! !!O2PluggableCommand methodsFor: 'morphic' stamp: 'cwp 6/24/2006 19:05'!labelWithKeystroke	^keystroke		ifNil: [label]		ifNotNil: [label, ' (', keystroke asString, ')']! !!O2PluggableCommand methodsFor: 'converting' stamp: 'DamienCassou 12/23/2009 16:36'!on: aNode for: aRequestor 	| inst |	inst := self copy.	inst setTarget: aNode requestor: aRequestor.	^ inst! !!O2PluggableCommand methodsFor: 'testing' stamp: 'cwp 6/25/2006 00:43'!useLineAfter	^ false! !!O2PluggableCommand methodsFor: 'testing' stamp: 'cwp 6/24/2006 19:46'!wantsButton	^ self buttonLabel notNil! !!OR2CmdAcceptChanges methodsFor: 'execution' stamp: 'lr 2/7/2008 20:22'!execute	self performChange: self browser root change.	self browser close! !!OR2CmdAcceptChanges methodsFor: 'accessing' stamp: 'lr 3/12/2008 09:08'!group	^ #action! !!OR2CmdAcceptChanges methodsFor: 'accessing' stamp: 'lr 2/7/2008 20:45'!keystroke	^ $s! !!OR2CmdAcceptChanges methodsFor: 'accessing' stamp: 'lr 2/8/2008 09:23'!label	^ 'accept'! !!OR2CmdAcceptChanges methodsFor: 'testing' stamp: 'lr 2/7/2008 19:05'!wantsButton	^ true! !!OR2CmdApplyChange methodsFor: 'execution' stamp: 'lr 3/12/2008 10:21'!execute	self performChange: target change.	self refresh! !!OR2CmdApplyChange methodsFor: 'accessing' stamp: 'lr 1/30/2009 23:40'!label	^ 'apply'! !!OR2CmdBrowseChange methodsFor: 'execution' stamp: 'lr 3/24/2008 11:51'!execute	target browse! !!OR2CmdBrowseChange methodsFor: 'testing' stamp: 'lr 3/24/2008 11:54'!isEnabled	^ target change changeClass notNil! !!OR2CmdBrowseChange methodsFor: 'accessing' stamp: 'lr 3/24/2008 11:51'!keystroke	^ $b! !!OR2CmdBrowseChange methodsFor: 'accessing' stamp: 'lr 3/24/2008 11:51'!label	^ 'browse'! !!OR2CmdCancelChanges methodsFor: 'execution' stamp: 'lr 2/7/2008 19:06'!execute	self browser close! !!OR2CmdCancelChanges methodsFor: 'accessing' stamp: 'lr 3/12/2008 09:09'!group	^ #action! !!OR2CmdCancelChanges methodsFor: 'accessing' stamp: 'lr 2/8/2008 09:23'!keystroke	^ $l! !!OR2CmdCancelChanges methodsFor: 'accessing' stamp: 'lr 2/7/2008 19:06'!label	^ 'cancel'! !!OR2CmdCancelChanges methodsFor: 'testing' stamp: 'lr 2/7/2008 19:05'!wantsButton	^ true! !!OR2CmdDisplayDiffs methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	OR2ChangesBrowser displayDiffs: OR2ChangesBrowser isDisplayingDiffs not.	self browser announce: (OBDefinitionChanged 			node: target			definition: target)! !!OR2CmdDisplayDiffs methodsFor: 'accessing' stamp: 'lr 1/30/2009 23:38'!group	^ #settings! !!OR2CmdDisplayDiffs methodsFor: 'accessing' stamp: 'lr 1/30/2009 23:38'!keystroke	^ $d! !!OR2CmdDisplayDiffs methodsFor: 'accessing' stamp: 'lr 1/31/2009 00:06'!label	^ self browser class isDisplayingDiffs ifTrue: [ 'hide diffs' ] ifFalse: [ 'show diffs' ]! !!OR2CmdFileOutChanges methodsFor: 'execution' stamp: 'lr 3/13/2009 17:23'!execute	| changes |	changes := String streamContents: [ :stream |		stream			header;			timeStamp.		self browser root changes			do: [ :each | stream cr; cr; print: each change ] ].	FileStream 		writeSourceCodeFrom: changes readStream		baseName: self browser root change name		isSt: true! !!OR2CmdFileOutChanges methodsFor: 'accessing' stamp: 'lr 1/30/2009 23:36'!group	^ #action! !!OR2CmdFileOutChanges methodsFor: 'accessing' stamp: 'lr 1/30/2009 23:40'!keystroke	^ $o! !!OR2CmdFileOutChanges methodsFor: 'accessing' stamp: 'lr 1/30/2009 23:40'!label	^ 'file out'! !!OR2CmdRemoveChange methodsFor: 'execution' stamp: 'lr 3/12/2008 10:19'!execute	target remove.	self refresh! !!OR2CmdRemoveChange methodsFor: 'accessing' stamp: 'lr 3/12/2008 10:14'!keystroke	^ $x! !!OR2CmdRemoveChange methodsFor: 'accessing' stamp: 'lr 3/12/2008 10:13'!label	^ 'remove'! !!OR2CmdRemoveClassChanges methodsFor: 'execution' stamp: 'lr 3/12/2008 10:20'!execute	self browser root changes do: [ :each |		(target change changeClass = each change changeClass)			ifTrue: [ each remove ] ].	self refresh! !!OR2CmdRemoveClassChanges methodsFor: 'testing' stamp: 'lr 3/12/2008 10:19'!isEnabled	^ target change changeClass notNil! !!OR2CmdRemoveClassChanges methodsFor: 'accessing' stamp: 'lr 3/12/2008 10:13'!label	^ 'remove class'! !!OR2CmdCategoryEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 15:59'!environment	^ super environment forCategories: (Array with: target name)! !!OR2CmdCategoryEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:12'!isActive	^ super isActive and: [ target isKindOf: O2ClassCategoryNode ]! !!OR2CmdCategoryEnvironment methodsFor: 'accessing' stamp: 'lr 1/4/2008 16:03'!label	^ 'category'! !!OR2CmdClassEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:01'!environment	^ super environment forClasses: (Array with: target theNonMetaClass)! !!OR2CmdClassEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:08'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdClassEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'class'! !!OR2CmdClassHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 10:26'!environment	| classes |	classes := Set new		addAll: target theNonMetaClass withAllSuperclasses;		addAll: target theNonMetaClass allSubclasses;		yourself.	^ (super environment forClasses: classes)		label: 'Hierarchy of ' , target theNonMetaClassName! !!OR2CmdClassHierarchyEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:09'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdClassHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'class hierarchy'! !!OR2CmdClassVarRefsEnvironment methodsFor: 'accessing' stamp: 'lr 3/8/2009 19:08'!environment	^ super environment classVarRefsTo: (self chooseFrom: self classVariables) in: target theClass! !!OR2CmdClassVarRefsEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 14:59'!isActive	^ super isActive and: [ (target isKindOf: O2ClassNode) or: [ target isKindOf: O2ClassVariableNode ] ]! !!OR2CmdClassVarRefsEnvironment methodsFor: 'accessing' stamp: 'lr 1/4/2008 16:54'!label	^ 'class variable references'! !!OR2CmdDependenciesEnvironment methodsFor: 'private' stamp: 'lr 3/16/2009 09:57'!add: aClass to: anEnvironment	anEnvironment		addClass: aClass theNonMetaClass;		addClass: aClass theMetaClass! !!OR2CmdDependenciesEnvironment methodsFor: 'accessing' stamp: 'lr 3/16/2009 10:06'!environment	"Build an environment with all the static dependnecies."	| result parent |	result := ClassEnvironment new.	parent := super environment.	parent classesDo: [ :each |		"(1) super classes"		(each superclass isNil and: [ (parent includesClass: each superclass) not ])			ifTrue: [ self add: each superclass to: result ] ].	parent classesAndSelectorsDo: [ :class :selector |		"(2) extended classes"		(parent includesClass: class)			ifFalse: [ self add: class superclass to: result ].		"(3) referenced classes"		(class compiledMethodAt: selector) literals allButLast do: [ :literal |			(literal isVariableBinding and: [ literal value isBehavior and: [ (parent includesClass: literal value) not ]])				ifTrue: [ self add: literal value superclass to: result ] ] ].	^ result label: 'External Dependencies of ' , parent label! !!OR2CmdDependenciesEnvironment methodsFor: 'testing' stamp: 'lr 3/16/2009 09:50'!isActive	^ super isActive and: [ self browser environment isSystem not ]! !!OR2CmdDependenciesEnvironment methodsFor: 'accessing' stamp: 'lr 3/16/2009 09:50'!label	^ 'dependencies'! !!OR2CmdEnvironment methodsFor: 'accessing' stamp: 'lr 3/8/2009 19:55'!cluster	^ #'refactoring scope'! !!OR2CmdEnvironment methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	[ self openEnvironment: self environment ] 		on: OR2UICancellationError		do: [ :err | ^ self ]! !!OR2CmdImplementorEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:27'!environment	^ super environment implementorsOf: target selector! !!OR2CmdImplementorEnvironment methodsFor: 'testing' stamp: 'lr 5/19/2007 09:22'!isActive	^ super isActive and: [ target hasSelector ]! !!OR2CmdImplementorEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'implementors'! !!OR2CmdInstVarReaderEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:36'!environment	^ super environment instVarReadersTo: (self chooseFrom: self instanceVariables) in: target theClass! !!OR2CmdInstVarReaderEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:09'!isActive	^ super isActive and: [ (target isKindOf: O2ClassAwareNode) or: [ target isKindOf: OBInstanceVariableNode ] ]! !!OR2CmdInstVarReaderEnvironment methodsFor: 'accessing' stamp: 'lr 1/4/2008 16:53'!label	^ 'instance variable reader'! !!OR2CmdInstVarRefsEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:28'!environment	^ super environment instVarRefsTo: (self chooseFrom: self instanceVariables) in: target theClass! !!OR2CmdInstVarRefsEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:10'!isActive	^ super isActive and: [ (target isKindOf: O2ClassAwareNode) or: [ target isKindOf: O2InstanceVariableNode ] ]! !!OR2CmdInstVarRefsEnvironment methodsFor: 'accessing' stamp: 'lr 1/4/2008 16:53'!label	^ 'instance variable references'! !!OR2CmdInstVarWriterEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:28'!environment	^ super environment instVarWritersTo: (self chooseFrom: self instanceVariables) in: target theClass! !!OR2CmdInstVarWriterEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:09'!isActive	^ super isActive and: [ (target isKindOf: O2ClassAwareNode) or: [ target isKindOf: O2InstanceVariableNode ] ]! !!OR2CmdInstVarWriterEnvironment methodsFor: 'accessing' stamp: 'lr 1/4/2008 16:53'!label	^ 'instance variable writer'! !!OR2CmdInverseEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:29'!environment	^ super environment not! !!OR2CmdInverseEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:43'!group	^ #noble! !!OR2CmdInverseEnvironment methodsFor: 'testing' stamp: 'lr 11/14/2007 10:33'!isActive	^ super isActive and: [ self environment isSystem not ]! !!OR2CmdInverseEnvironment methodsFor: 'accessing' stamp: 'lr 6/13/2008 14:18'!label	^ 'inverse'! !!OR2CmdManualEnvironment methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	| browser |	browser := OR2SystemBrowser on: self environment.	browser jumpTo: target.	browser open! !!OR2CmdManualEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:43'!group	^ #noble! !!OR2CmdManualEnvironment methodsFor: 'accessing' stamp: 'lr 6/13/2008 14:19'!label	^ 'manual'! !!OR2CmdMatchesEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 13:34'!environment	| literal |	literal := self request: 'Literals matching:'.	^ (super environment matches: literal) 		label: 'Literals matching ' , literal printString;		yourself! !!OR2CmdMatchesEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 10:31'!label	^ 'literal matches...'! !!OR2CmdBrowsePackageEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 13:55'!cluster	^ nil! !!OR2CmdBrowsePackageEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 13:53'!group	^ #navigation! !!OR2CmdBrowsePackageEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 13:53'!label	^ 'browse package'! !!OR2CmdPackageEnvironment methodsFor: 'accessing' stamp: 'DavidRoethlisberger 12/23/2009 12:25'!environment	| package |	^ (super environment forPackages: (Array with: (package := self package))) 		label: package packageName! !!OR2CmdPackageEnvironment methodsFor: 'testing' stamp: 'lr 1/4/2008 15:53'!isEnabled	^ self package notNil! !!OR2CmdPackageEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'package'! !!OR2CmdPackageEnvironment methodsFor: 'accessing' stamp: 'lr 9/26/2008 12:16'!package	^ target containingPackage! !!OR2CmdPragmaEnvironment methodsFor: 'accessing' stamp: 'lr 7/21/2008 10:29'!environment	^ super environment forPragmas: (Array with: target selector)! !!OR2CmdPragmaEnvironment methodsFor: 'testing' stamp: 'lr 7/21/2008 10:23'!isActive	^ super isActive and: [ target hasSelector ]! !!OR2CmdPragmaEnvironment methodsFor: 'accessing' stamp: 'lr 7/21/2008 10:23'!label	^ 'pragmas'! !!OR2CmdProtocolEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:45'!environment	^ super environment forClass: target theClass protocols: (Array with: target name)! !!OR2CmdProtocolEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:15'!isActive	^ super isActive and: [ target isKindOf: O2MethodCategoryNode ]! !!OR2CmdProtocolEnvironment methodsFor: 'accessing' stamp: 'lr 1/4/2008 16:14'!label	^ 'protocol'! !!OR2CmdReferencesEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 10:28'!environment	^ (super environment referencesTo: target theNonMetaClass binding)		label: 'References to ' , target theNonMetaClassName! !!OR2CmdReferencesEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:10'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdReferencesEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:48'!label	^ 'references'! !!OR2CmdSelectMethodsEnvironment methodsFor: 'accessing' stamp: 'lr 2/10/2008 10:24'!environment	| condition |	condition := self request: 'Select methods:' initialAnswer: '[ :each | false ]'.	^ (super environment selectMethods: (self class evaluatorClass evaluate: condition))		label: 'Methods matching ' , condition.! !!OR2CmdSelectMethodsEnvironment methodsFor: 'accessing' stamp: 'lr 2/9/2008 16:55'!label	^ 'select methods...'! !!OR2CmdSelectionEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 12:29'!environment	^ target browserEnvironment! !!OR2CmdSelectionEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 13:24'!group	^ #noble! !!OR2CmdSelectionEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 12:29'!label	^ 'selection'! !!OR2CmdSelfSendEnvironment methodsFor: 'accessing' stamp: 'TestRunner 11/16/2009 10:10'!environment	| parent environment matcher |	parent := super environment.	environment := ParseTreeEnvironment onEnvironment: parent.	environment label: 'Self-Sends'; matcher: (matcher := RBParseTreeSearcher new).	matcher matches: 'self `@message: ``@args' do: [ :node :answer | node ].	parent classesAndSelectorsDo: [ :class :selector |		(matcher executeTree: (class compiledMethodAt: selector) parseTree initialAnswer: nil) notNil			ifTrue: [ environment addClass: class selector: selector ] ].	^ environment! !!OR2CmdSelfSendEnvironment methodsFor: 'accessing' stamp: 'lr 6/22/2008 14:15'!label	^ 'self-sends'! !!OR2CmdSenderEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 13:35'!environment	^ (super environment referencesTo: target selector)		label: 'Senders of ' , target selector printString;		yourself! !!OR2CmdSenderEnvironment methodsFor: 'testing' stamp: 'lr 5/19/2007 09:22'!isActive	^ super isActive and: [ target hasSelector ]! !!OR2CmdSenderEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'senders'! !!OR2CmdSubclassesHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 14:07'!environment	^ (super environment forClasses: target theNonMetaClass allSubclasses)		label: 'Subclasses of ' , target theNonMetaClassName;		yourself! !!OR2CmdSubclassesHierarchyEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:08'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdSubclassesHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'subclasses'! !!OR2CmdSubclassesWithHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 14:07'!environment	^ (super environment forClasses: target theNonMetaClass withAllSubclasses)		label: 'Subclasses with ' , target theNonMetaClassName;		yourself! !!OR2CmdSubclassesWithHierarchyEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:10'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdSubclassesWithHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 13:39'!label	^ 'subclasses with'! !!OR2CmdSuperSendEnvironment methodsFor: 'accessing' stamp: 'TestRunner 11/16/2009 10:10'!environment	| parent environment matcher |	parent := super environment.	environment := ParseTreeEnvironment onEnvironment: parent.	environment label: 'Super-Sends'; matcher: (matcher := RBParseTreeSearcher new).	matcher matches: 'super `@message: ``@args' do: [ :node :answer | node ].	parent classesAndSelectorsDo: [ :class :selector |		(matcher executeTree: (class compiledMethodAt: selector) parseTree initialAnswer: nil) notNil			ifTrue: [ environment addClass: class selector: selector ] ].	^ environment! !!OR2CmdSuperSendEnvironment methodsFor: 'accessing' stamp: 'lr 6/22/2008 14:15'!label	^ 'super-sends'! !!OR2CmdSuperclassesHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 14:07'!environment	^ (super environment forClasses: target theNonMetaClass allSuperclasses)		label: 'Superclasses of ' , target theNonMetaClassName;		yourself! !!OR2CmdSuperclassesHierarchyEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:10'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdSuperclassesHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/14/2007 10:41'!label	^ 'superclasses'! !!OR2CmdSuperclassesWithHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 14:07'!environment	^ (super environment forClasses: target theNonMetaClass withAllSuperclasses)		label: 'Superclasses with ' , target theNonMetaClassName;		yourself! !!OR2CmdSuperclassesWithHierarchyEnvironment methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:10'!isActive	^ super isActive and: [ target isKindOf: O2ClassAwareNode ]! !!OR2CmdSuperclassesWithHierarchyEnvironment methodsFor: 'accessing' stamp: 'lr 11/11/2008 13:41'!label	^ 'superclasses with'! !!OR2CmdBrowse methodsFor: 'execution' stamp: 'lr 1/17/2009 12:15'!execute	target browse! !!OR2CmdBrowse methodsFor: 'testing' stamp: 'lr 1/25/2009 15:33'!isEnabled	^ target isComposite not and: [ target isEmpty not ]! !!OR2CmdBrowse methodsFor: 'accessing' stamp: 'lr 1/17/2009 12:15'!keystroke	^ $b! !!OR2CmdBrowse methodsFor: 'accessing' stamp: 'lr 1/17/2009 12:15'!label	^ 'browse'! !!OR2CmdBrowse methodsFor: 'testing' stamp: 'lr 1/25/2009 15:24'!wantsButton	^ true! !!OR2CmdImplementor methodsFor: 'execution' stamp: 'lr 2/24/2009 14:00'!execute	target rule class browse! !!OR2CmdImplementor methodsFor: 'testing' stamp: 'lr 1/17/2009 12:35'!isEnabled	^ target isComposite not! !!OR2CmdImplementor methodsFor: 'accessing' stamp: 'lr 1/17/2009 12:34'!keystroke	^ $m! !!OR2CmdImplementor methodsFor: 'accessing' stamp: 'lr 1/17/2009 12:34'!label	^ 'implementor'! !!OR2CmdRefresh methodsFor: 'execution' stamp: 'lr 1/25/2009 15:22'!execute	self browser search: self browser root rule! !!OR2CmdRefresh methodsFor: 'testing' stamp: 'lr 1/25/2009 15:25'!isEnabled	^ requestor browser isSearching not! !!OR2CmdRefresh methodsFor: 'accessing' stamp: 'lr 8/29/2008 12:04'!keystroke	^ $r! !!OR2CmdRefresh methodsFor: 'accessing' stamp: 'lr 1/25/2009 15:26'!label	^ 'refresh'! !!OR2CmdRefresh methodsFor: 'testing' stamp: 'lr 1/25/2009 15:23'!wantsButton	^ true! !!OR2CmdRefreshRule methodsFor: 'execution' stamp: 'lr 1/25/2009 15:23'!execute	self browser search: target rule! !!OR2CmdRefreshRule methodsFor: 'testing' stamp: 'lr 1/25/2009 15:25'!isEnabled	^ requestor browser isSearching not! !!OR2CmdRefreshRule methodsFor: 'accessing' stamp: 'lr 1/25/2009 12:26'!label	^ 'refresh rule'! !!OR2CmdOpen methodsFor: 'accessing' stamp: 'lr 2/26/2009 16:55'!cluster	^ #refactor! !!OR2CmdOpen methodsFor: 'private' stamp: 'lr 5/30/2008 10:15'!definition: aDefinition	requestor announce: (OBDefinitionChanged definition: aDefinition)! !!OR2CmdOpen methodsFor: 'accessing' stamp: 'lr 2/26/2009 17:03'!group	^ #open! !!OR2CmdOpenLint methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	OR2LintBrowser 		openRule: RBCompositeLintRule allRules		environment: self environment! !!OR2CmdOpenLint methodsFor: 'accessing' stamp: 'lr 5/30/2008 10:11'!label	^ 'code critics'! !!OR2CmdOpenRewriter methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	self definition: (OR2RewriterDefinition on: self environment)! !!OR2CmdOpenRewriter methodsFor: 'accessing' stamp: 'lr 6/6/2008 16:57'!label	^ 'rewrite code'! !!OR2CmdOpenSearcher methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	self definition: (OR2SearcherDefinition on: self environment)! !!OR2CmdOpenSearcher methodsFor: 'accessing' stamp: 'lr 6/6/2008 16:57'!label	^ 'search code'! !!OR2CmdPrettyPrint class methodsFor: 'testing' stamp: 'lr 6/14/2007 19:49'!takesText	^ true! !!OR2CmdPrettyPrint methodsFor: 'execution' stamp: 'DavidRoethlisberger 10/17/2009 13:00'!execute	"Now this is utterly ugly, but unfortunately I see no better way doing this."	| panel definition class morph source |	panel := requestor browser panels 		detect: [ :each | each isDefinition ]		ifNone: [ ^ self ].	definition := panel getDefinition ifNil: [ ^ self ].	class := Smalltalk classNamed: #O2PluggableTextMorph.	class isNil		ifTrue: [ ^ self ].	morph := class allSubInstances		detect: [ :each | each model == panel ]		ifNone: [ ^ self ].	source := morph text asString.	(definition prettyPrint: source) = source		ifTrue: [ ^ self ].	requestor browser announce: definition.	morph hasUnacceptedEdits: true! !!OR2CmdPrettyPrint methodsFor: 'accessing' stamp: 'lr 10/3/2007 20:11'!group	^ #general! !!OR2CmdPrettyPrint methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:11'!isActive	^ (target isKindOf: O2TextSelection) or: [ (target isKindOf: O2MethodNode) and: [ (target isKindOf: O2MethodVersionNode) not and: [ requestor isSelected: target ] ] ] ! !!OR2CmdPrettyPrint methodsFor: 'accessing' stamp: 'DavidRoethlisberger 10/17/2009 14:43'!keystroke	^ $p! !!OR2CmdPrettyPrint methodsFor: 'accessing' stamp: 'lr 6/14/2007 19:13'!label	^ 'pretty print'! !!OR2CmdRecompile methodsFor: 'accessing' stamp: 'lr 2/26/2009 17:03'!cluster	^ #refactor! !!OR2CmdRecompile methodsFor: 'execution' stamp: 'lr 2/26/2009 20:50'!execute	OBWaitRequest block: [		self environment classesAndSelectorsDo: [ :class :selector |			class recompile: selector from: class ] ]! !!OR2CmdRecompile methodsFor: 'accessing' stamp: 'lr 2/26/2009 17:03'!group	^ #tools! !!OR2CmdRecompile methodsFor: 'accessing' stamp: 'lr 2/6/2009 11:35'!label	^ 'recompile'! !!OR2CmdAccessorClassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:35'!label	^ 'accessors'! !!OR2CmdAccessorClassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:35'!longDescription	^ 'Creates getter and setter methods for all variables.'! !!OR2CmdAccessorClassRefactoring methodsFor: 'accessing' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!refactoring	^ OR2AccessorClassRefactoring className: self currentNode theClass name! !!OR2CmdClassRefactoring class methodsFor: 'testing' stamp: 'lr 3/15/2008 09:23'!takesText	^ true! !!OR2CmdClassRefactoring methodsFor: 'accessing' stamp: 'lr 1/28/2008 22:48'!cluster	^ #'refactor class'! !!OR2CmdClassRefactoring methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:08'!isActive	^ super isActive and: [ self currentNode isKindOf: O2ClassAwareNode ]! !!OR2CmdCreateSubclassRefactoring methodsFor: 'accessing' stamp: 'lr 4/5/2008 10:35'!label	^ 'create subclass'! !!OR2CmdCreateSubclassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:57'!longDescription	^ 'This refactoring allows you to insert a new class into an existing hierarchy.'! !!OR2CmdCreateSubclassRefactoring methodsFor: 'accessing' stamp: 'lr 2/12/2009 10:49'!refactoring	| class subclassName |	class := self currentNode theNonMetaClass.	subclassName := self request: 'Enter new subclass name:'.	^ AddClassRefactoring 		addClass: subclassName		superclass: class		subclasses: ((OBMultipleChoiceRequest 			prompt: 'Select subclasses of ' , subclassName , ':'			labels: (class subclasses collect: [ :each | each name ])			values: class subclasses)			ifNil: [ ^ nil ])		category: class category! !!OR2CmdCreateSuperclassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:36'!label	^ 'create superclass'! !!OR2CmdCreateSuperclassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 11:00'!longDescription	^ 'This refactoring allows you to insert a new class into an existing hierarchy.'! !!OR2CmdCreateSuperclassRefactoring methodsFor: 'accessing' stamp: 'lr 2/12/2009 10:49'!refactoring	| class superclassName |	class := self currentNode theNonMetaClass.	superclassName := self request: 'Enter new superclass name:'.	^ ChildrenToSiblingsRefactoring 		name: superclassName		class: class		subclasses: ((OBMultipleChoiceRequest 			prompt: 'Select subclasses of ' , superclassName , ':'			labels: (class subclasses collect: [ :each | each name ])			values: class subclasses)			ifNil: [ ^ nil ])! !!OR2CmdRealizeClassRefactoring methodsFor: 'accessing' stamp: 'lr 10/17/2007 20:20'!label	^ 'realize'! !!OR2CmdRealizeClassRefactoring methodsFor: 'accessing' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!refactoring	^ OR2RealizeClassRefactoring className: self currentNode theNonMetaClass name! !!OR2CmdRemoveClassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 11:04'!label	^ 'remove'! !!OR2CmdRemoveClassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 11:14'!longDescription	^ 'This refactoring checks for references to a class, and if there are no references, it will remove the class.'! !!OR2CmdRemoveClassRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:55'!refactoring	^ RemoveClassRefactoring classNames: (Array with: self currentNode theNonMetaClass name)! !!OR2CmdRenameClassRefactoring methodsFor: 'accessing' stamp: 'lr 10/17/2007 20:20'!label	^ 'rename'! !!OR2CmdRenameClassRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 11:14'!longDescription	^ 'This refactoring renames a class and also renames every reference to the class in the code. Even symbols with the same name as the class will also be renamed.'! !!OR2CmdRenameClassRefactoring methodsFor: 'accessing' stamp: 'lr 3/15/2008 09:22'!refactoring	^ RenameClassRefactoring 		rename: self currentNode theNonMetaClass		to: (self 			request: 'Enter new class name:'			initialAnswer: self currentNode theNonMetaClass name)! !!OR2CmdSplitClassRefactoring methodsFor: 'accessing' stamp: 'lr 10/17/2007 20:20'!label	^ 'split'! !!OR2CmdSplitClassRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:55'!refactoring	^ SplitClassRefactoring 		class: self currentNode theNonMetaClass		instanceVariables: #()		newClassName: (self request: 'Enter new class name:')		referenceVariableName: (self request: 'Enter new variable name where requests will be forwarded:')! !!OR2CmdAbstractClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:48'!label	^ 'abstract'! !!OR2CmdAbstractClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:37'!longDescription	^ 'Performs the create accessors refactoring and then converts all direct variable to use the accessor methods.'! !!OR2CmdAbstractClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:36'!refactoring	^ self classAndVariable: [ :class :variable | 		AbstractClassVariableRefactoring 			variable: variable			class: class ]! !!OR2CmdAccessorClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:36'!label	^ 'accessors'! !!OR2CmdAccessorClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:34'!longDescription	^ 'Creates getter and setter methods for a variable.'! !!OR2CmdAccessorClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:36'!refactoring	^ self classAndVariable: [ :class :variable | 		CreateAccessorsForVariableRefactoring 			variable: variable			class: class			classVariable: true ]! !!OR2CmdAddClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:49'!label	^ 'add'! !!OR2CmdAddClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:31'!longDescription	^ 'Add a variable to the class.'! !!OR2CmdAddClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/15/2008 09:18'!refactoring	^ AddClassVariableRefactoring 		variable: (self			request: 'Enter the new variable name:'			initialAnswer: (self selection ifNil: [ 'Var' ]))		class: self currentNode theNonMetaClass! !!OR2CmdClassVarRefactoring class methodsFor: 'testing' stamp: 'lr 3/14/2008 23:18'!takesText	^ true! !!OR2CmdClassVarRefactoring methodsFor: 'private' stamp: 'lr 3/14/2008 23:35'!classAndVariable: aBlock	| variable class |	variable := self chooseFrom: self classVariables.	class := self currentNode theNonMetaClass whichClassDefinesClassVar: variable.	^ aBlock value: class value: variable! !!OR2CmdClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/28/2008 22:48'!cluster	^ #'refactor class variable'! !!OR2CmdClassVarRefactoring methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:08'!isActive	^ super isActive and: [ self currentNode isKindOf: O2ClassAwareNode ]! !!OR2CmdClassVarRefactoring methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:09'!isEnabled	(self class = OR2CmdAddClassVarRefactoring or: [ target isKindOf: O2ClassAwareNode ]) ifTrue: [ ^ true ].	^ self currentNode theNonMetaClass allClassVarNames includes: self selection! !!OR2CmdPullUpClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:49'!label	^ 'pull up'! !!OR2CmdPullUpClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:34'!longDescription	^ 'Move a variable definition from the currently selected class into the superclass.'! !!OR2CmdPullUpClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:37'!refactoring	^ self classAndVariable: [ :class :variable | 		PullUpClassVariableRefactoring 			variable: variable			class: class superclass ]! !!OR2CmdPushDownClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:49'!label	^ 'push down'! !!OR2CmdPushDownClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:33'!longDescription	^ 'Moves a variable definition from the currently selected class to only those subclasses that use the variable.'! !!OR2CmdPushDownClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:37'!refactoring	^ self classAndVariable: [ :class :variable | 		PushDownClassVariableRefactoring 			variable: variable			class: class ]! !!OR2CmdRemoveClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:50'!label	^ 'remove'! !!OR2CmdRemoveClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:31'!longDescription	^ 'Removes a variable only if it is not referenced.'! !!OR2CmdRemoveClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:37'!refactoring	^ self classAndVariable: [ :class :variable | 		RemoveClassVariableRefactoring 			variable: variable			class: class ]! !!OR2CmdRenameClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:50'!label	^ 'rename'! !!OR2CmdRenameClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:30'!longDescription	^ 'Renames a variable and all references to the variable.'! !!OR2CmdRenameClassVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:39'!refactoring	| name |	^ self classAndVariable: [ :class :variable | 		name := self 			request: 'Enter the new variable name:'			initialAnswer: variable.		RenameClassVariableRefactoring 			rename: variable			to: name			in: class ]! !!OR2CmdAbstractInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:48'!label	^ 'abstract'! !!OR2CmdAbstractInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:37'!longDescription	^ 'Performs the create accessors refactoring and then converts all direct variable to use the accessor methods.'! !!OR2CmdAbstractInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:42'!refactoring	^ self classAndVariable: [ :class :variable |		AbstractInstanceVariableRefactoring 			variable: variable			class: class ]! !!OR2CmdAccessorInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:36'!label	^ 'accessors'! !!OR2CmdAccessorInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:34'!longDescription	^ 'Creates getter and setter methods for a variable.'! !!OR2CmdAccessorInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:42'!refactoring	^ self classAndVariable: [ :class :variable |		CreateAccessorsForVariableRefactoring 			variable: variable			class: class			classVariable: false ]! !!OR2CmdAddInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:50'!label	^ 'add'! !!OR2CmdAddInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:31'!longDescription	^ 'Add a variable to the class.'! !!OR2CmdAddInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/15/2008 09:20'!refactoring	^ AddInstanceVariableRefactoring		variable: (self			request: 'Enter the new variable name:'			initialAnswer: (self selection ifNil: [ 'var' ]))		class: self currentNode theClass! !!OR2CmdInstVarRefactoring class methodsFor: 'testing' stamp: 'lr 3/14/2008 23:11'!takesText	^ true! !!OR2CmdInstVarRefactoring methodsFor: 'private' stamp: 'lr 3/14/2008 23:41'!classAndVariable: aBlock	| variable class |	variable := self chooseFrom: self instanceVariables.	class := self currentNode theClass whichClassDefinesInstVar: variable.	^ aBlock value: class value: variable! !!OR2CmdInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/28/2008 22:48'!cluster	^ #'refactor instance variable'! !!OR2CmdInstVarRefactoring methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:09'!isActive	^ super isActive and: [ self currentNode isKindOf: O2ClassAwareNode ]! !!OR2CmdInstVarRefactoring methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:09'!isEnabled	(self class = OR2CmdAddInstVarRefactoring or: [ target isKindOf: O2ClassAwareNode ]) ifTrue: [ ^ true ].	^ self currentNode theClass allInstVarNames includes: self selection! !!OR2CmdProtectInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:50'!label	^ 'protect'! !!OR2CmdProtectInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:38'!longDescription	^ 'Converts all variable accessor sends to direct variable references. If the accessor is no longer used then it will be removed.'! !!OR2CmdProtectInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:43'!refactoring	^ self classAndVariable: [ :class :variable |		ProtectInstanceVariableRefactoring 			variable: variable			class: class ]! !!OR2CmdPullUpInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:50'!label	^ 'pull up'! !!OR2CmdPullUpInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:34'!longDescription	^ 'Move a variable definition from the currently selected class into the superclass.'! !!OR2CmdPullUpInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:43'!refactoring	^ self classAndVariable: [ :class :variable |		PullUpInstanceVariableRefactoring 			variable: variable			class: class superclass ]! !!OR2CmdPushDownInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:50'!label	^ 'push down'! !!OR2CmdPushDownInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:33'!longDescription	^ 'Moves a variable definition from the currently selected class to only those subclasses that use the variable.'! !!OR2CmdPushDownInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:43'!refactoring	^ self classAndVariable: [ :class :variable |		PushDownInstanceVariableRefactoring 			variable: variable			class: class ]! !!OR2CmdRemoveInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:51'!label	^ 'remove'! !!OR2CmdRemoveInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:31'!longDescription	^ 'Removes a variable only if it is not referenced.'! !!OR2CmdRemoveInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:43'!refactoring	^ self classAndVariable: [ :class :variable |		RemoveInstanceVariableRefactoring 			remove: variable			from: class ]! !!OR2CmdRenameInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 16:51'!label	^ 'rename'! !!OR2CmdRenameInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:30'!longDescription	^ 'Renames a variable and all references to the variable.'! !!OR2CmdRenameInstVarRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 23:55'!refactoring	| name |	^ self classAndVariable: [ :class :variable |		name := self 			request: 'Enter the new variable name:'			initialAnswer: variable.		RenameInstanceVariableRefactoring 			rename: variable			to: name			in: class ]! !!OR2CmdAddParameterMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/22/2007 09:04'!label	^ 'add parameter'! !!OR2CmdAddParameterMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:50'!longDescription	^ 'Adds a default parameter to all implementors of the method.'! !!OR2CmdAddParameterMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	| initializer newSelector initialAnswer |	initialAnswer := self currentNode selector numArgs = 0 		ifTrue: [ self currentNode selector , ':' ]		ifFalse: [ self currentNode selector ].	newSelector := self 		request: 'Enter new selector:'		initialAnswer: initialAnswer.	newSelector isEmpty ifTrue: [ ^ nil ].	initializer := self 		request: 'Enter default value for parameter:'		initialAnswer: 'nil'.	initializer isEmpty ifTrue: [ ^ nil ].	^ AddParameterRefactoring 		addParameterToMethod: self currentNode selector		in: self currentNode theClass		newSelector: newSelector asSymbol		initializer: initializer! !!OR2CmdInlineParameterRefactoring methodsFor: 'accessing' stamp: 'lr 3/16/2007 09:57'!label	^ 'inline parameter'! !!OR2CmdInlineParameterRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:54'!longDescription	^ 'Remove a parameter from the method, and adds an assignment at the beginning of the method. This can only be performed if all senders of the method have the same value for the parameter.'! !!OR2CmdInlineParameterRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ InlineParameterRefactoring 		inlineParameter: (self chooseFrom: self arguments)		in: self currentNode theClass		selector: self currentNode selector! !!OR2CmdInlineSelfSendsMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/22/2007 09:07'!label	^ 'inline self sends'! !!OR2CmdInlineSelfSendsMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:51'!longDescription	^ 'Inlines all senders within the class of the method. If there are no more senders after all inlines have been performed, then it will remove the method.'! !!OR2CmdInlineSelfSendsMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ InlineAllSendersRefactoring 		sendersOf: self currentNode selector		in: self currentNode theClass! !!OR2CmdMethodRefactoring class methodsFor: 'testing' stamp: 'lr 3/14/2008 22:48'!takesText	^ true! !!OR2CmdMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/16/2007 11:31'!arguments	| parser |	parser := RBParser new.	parser errorBlock: [ :error :position | ^ #() ].	parser initializeParserWith: self source type: #on:errorBlock:.	^ parser parseMessagePattern argumentNames! !!OR2CmdMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/28/2008 22:48'!cluster	^ #'refactor method'! !!OR2CmdMethodRefactoring methodsFor: 'testing' stamp: 'lr 3/14/2008 22:59'!isActive	^ super isActive and: [ self currentNode hasSelector ]! !!OR2CmdMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:51'!source	^ self currentNode source! !!OR2CmdMoveMethodRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 17:00'!label	^ 'move'! !!OR2CmdMoveMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:49'!longDescription	^ 'Moves a method to another object (defined by an argument or instance variable).'! !!OR2CmdMoveMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ MoveMethodRefactoring 		selector: self currentNode selector		class: self currentNode theClass		variable: (self chooseFrom: self instanceVariables)! !!OR2CmdPushDownMethodRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 17:01'!label	^ 'push down'! !!OR2CmdPushDownMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:51'!longDescription	^ 'Pushes a method down into all subclasses that don''t implement the method. This can only be allowed if the class is abstract.'! !!OR2CmdPushDownMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ PushDownMethodRefactoring 		pushDown: (Array with: self currentNode selector)		from: self currentNode theClass! !!OR2CmdPushUpMethodRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 17:01'!label	^ 'push up'! !!OR2CmdPushUpMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:51'!longDescription	^ 'Pushes a method up into the superclass. If the superclass is abstract and already defines the method, then the superclass'' method will be copied down into the other subclasses (assuming they don''t already define the method).'! !!OR2CmdPushUpMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ PushUpMethodRefactoring 		pushUp: (Array with: self currentNode selector)		from: self currentNode theClass! !!OR2CmdRemoveMethodRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 17:01'!label	^ 'remove'! !!OR2CmdRemoveMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:50'!longDescription	^ 'Removes a method if there are no senders of the method or there are no symbol that reference the method name. Also, it will remove a method if it is equivalent to the superclass'' definition.'! !!OR2CmdRemoveMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ RemoveMethodRefactoring 		removeMethods: (Array with: self currentNode selector)		from: self currentNode theClass! !!OR2CmdRemoveParameterRefactoring methodsFor: 'accessing' stamp: 'lr 3/16/2007 10:09'!label	^ 'remove parameter'! !!OR2CmdRemoveParameterRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:53'!longDescription	^ 'Removes an unused parameter from all implementors of the method, and removes it from the message sends.'! !!OR2CmdRemoveParameterRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	^ RemoveParameterRefactoring 		removeParameter: (self chooseFrom: self arguments)		in: self currentNode theClass		selector: self currentNode selector! !!OR2CmdRenameMethodRefactoring methodsFor: 'accessing' stamp: 'lr 10/3/2007 17:01'!label	^ 'rename'! !!OR2CmdRenameMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:53'!longDescription	^ 'Renames all implementors of a method, all senders, and all symbols references. In addition to strict renaming, it also allows you to rearrange the parameters.'! !!OR2CmdRenameMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!refactoring	| oldMethodName newMethodName oldArguments argumentPermutation |	oldArguments := (RBParser parseMethod: (self currentNode theClass methodHeaderFor: self currentNode selector)) argumentNames.	oldMethodName := RBMethodName 		selector: self currentNode selector		arguments: oldArguments.	(newMethodName := self requestMethodNameFor: oldMethodName) ifNil: [ ^ nil ].	argumentPermutation := newMethodName arguments collect: [ :each | oldArguments indexOf: each ].	^ RenameMethodRefactoring 		renameMethod: self currentNode selector		in: self currentNode theClass		to: newMethodName selector		permutation: argumentPermutation! !!OR2CmdSwapMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/14/2008 22:52'!label	^ self currentNode theClass isMeta 		ifTrue: [ 'move to instance side' ]		ifFalse: [ 'move to class side' ]! !!OR2CmdSwapMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 11:17'!longDescription	^ 'Move the method from instance- to class-side or vice-versa.'! !!OR2CmdSwapMethodRefactoring methodsFor: 'accessing' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!refactoring	^ OR2SwapMethodRefactoring 		swapMethod: self currentNode selector		in: self currentNode theClass! !!OR2CmdPrettyPrintAll methodsFor: 'accessing' stamp: 'lr 2/26/2009 20:47'!cluster	^ #refactor! !!OR2CmdPrettyPrintAll methodsFor: 'accessing' stamp: 'lr 2/26/2009 20:47'!group	^ #tools! !!OR2CmdPrettyPrintAll methodsFor: 'accessing' stamp: 'lr 2/26/2009 17:06'!label	^ 'pretty print'! !!OR2CmdPrettyPrintAll methodsFor: 'accessing' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!refactoring	^ OR2PrettyPrintCodeRefactoring new! !!OR2CmdRefactoring methodsFor: 'execution' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!execute	| refactoring |	refactoring := [ self refactoring ] 		on: OR2UICancellationError		do: [ :err | ^ self ].	refactoring ifNil: [ ^ self ].	refactoring model environment: self environment.	[ self handleError: [ self performRefactoring: refactoring ] ] 		on: OR2UICancellationError		do: [ :err | ^ self ]! !!OR2CmdRefactoring methodsFor: 'accessing' stamp: 'lr 3/16/2007 16:02'!refactoring	self subclassResponsibility! !!OR2CmdExtractMethodRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:12'!isEnabled	^ self isExtractableSelected! !!OR2CmdExtractMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:06'!label	^ 'extract method'! !!OR2CmdExtractMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:52'!longDescription	^ 'Extracts the selected code as a separate method. This refactoring determines what temporary variables are needed in the new method, and prompts for a selector that takes these arguments.'! !!OR2CmdExtractMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 12:03'!refactoring	^ ExtractMethodRefactoring 		extract: self interval		from: self selector		in: self theClass! !!OR2CmdExtractMethodToComponentRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:12'!isEnabled	^ self isExtractableSelected! !!OR2CmdExtractMethodToComponentRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:06'!label	^ 'extract method to component'! !!OR2CmdExtractMethodToComponentRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 12:03'!refactoring	^ ExtractMethodToComponentRefactoring		extract: self interval		from: self selector		in: self theClass! !!OR2CmdExtractToTemporaryRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:12'!isEnabled	^ self isExtractableSelected! !!OR2CmdExtractToTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 12:05'!label	^ 'extract to temporary'! !!OR2CmdExtractToTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:55'!longDescription	^ 'Extracts a message into an assignment statement.'! !!OR2CmdExtractToTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 12:04'!refactoring	^ ExtractToTemporaryRefactoring 		extract: self interval		to: (self request: 'Enter the new variable name:')		from: self selector		in: self theClass! !!OR2CmdInlineMethodFromComponentRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:16'!isEnabled	^ self isNonSelfSendSelected! !!OR2CmdInlineMethodFromComponentRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:07'!label	^ 'inline method from component'! !!OR2CmdInlineMethodFromComponentRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 12:49'!refactoring	^ InlineMethodFromComponentRefactoring		inline: self interval		inMethod: self selector		forClass: self theClass! !!OR2CmdInlineMethodRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:16'!isEnabled	^ self isSelfSendSelected! !!OR2CmdInlineMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:07'!label	^ 'inline method'! !!OR2CmdInlineMethodRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:55'!longDescription	^ 'Inlines a message send. If there are multiple implementors of the message, it will prompt for the implementation that should be inlined.'! !!OR2CmdInlineMethodRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 12:48'!refactoring	^ InlineMethodRefactoring 		inline: self interval		inMethod: self selector		forClass: self theClass! !!OR2CmdInlineTemporaryRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:21'!isEnabled	^ self isAssignmentSelected! !!OR2CmdInlineTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:07'!label	^ 'inline temporary'! !!OR2CmdInlineTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:52'!longDescription	^ 'Removes the assignment of a variable and replaces all references to the variable with the right hand side of the assignment.'! !!OR2CmdInlineTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 13:23'!refactoring	^ InlineTemporaryRefactoring		inline: self interval		from: self selector		in: self theClass! !!OR2CmdMoveVariableDefinitionRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:26'!isEnabled	^ self isVariableSelected! !!OR2CmdMoveVariableDefinitionRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:07'!label	^ 'move variable definition'! !!OR2CmdMoveVariableDefinitionRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:54'!longDescription	^ 'Moves a temporary variable definition into the tightest scope that contains both the variable assignment and references.'! !!OR2CmdMoveVariableDefinitionRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 13:25'!refactoring	^ MoveVariableDefinitionRefactoring 		bindTight: self interval		in: self theClass		selector: self selector! !!OR2CmdRenameTemporaryRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:31'!isEnabled	^ self isVariableSelected! !!OR2CmdRenameTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:10'!label	^ 'rename temporary'! !!OR2CmdRenameTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:54'!longDescription	^ 'Renames a temporary variable.'! !!OR2CmdRenameTemporaryRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 13:32'!refactoring	^ RenameTemporaryRefactoring		renameTemporaryFrom: self interval		to: (self			request: 'Enter the new variable name:' 			initialAnswer: self selection)		in: self theClass		selector: self selector! !!OR2CmdSourceRefactoring class methodsFor: 'testing' stamp: 'lr 3/17/2007 10:42'!takesNodes	^ false! !!OR2CmdSourceRefactoring class methodsFor: 'testing' stamp: 'lr 3/17/2007 10:41'!takesText	^ true! !!OR2CmdSourceRefactoring methodsFor: 'accessing' stamp: 'lr 1/28/2008 22:48'!cluster	^ #'refactor source'! !!OR2CmdSourceRefactoring methodsFor: 'testing-private' stamp: 'lr 3/17/2007 13:00'!ifNodeSelected: aBlock	"Answer the result of evaluating aBlock with the currently selected parse tree node as argument or false, if there is no valid selection."	| node |	self interval isEmpty		ifTrue: [ ^ false ].	(node := self node) isNil		ifTrue: [ ^ false ].	^ aBlock value: node! !!OR2CmdSourceRefactoring methodsFor: 'testing-private' stamp: 'lr 3/17/2007 13:18'!ifSendSelected: aBlock	^ self ifNodeSelected: [ :node | node isMessage and: [ aBlock value: node ] ]! !!OR2CmdSourceRefactoring methodsFor: 'accessing-selection' stamp: 'lr 3/17/2007 12:03'!interval	^ target instVarNamed: 'selection'! !!OR2CmdSourceRefactoring methodsFor: 'testing' stamp: 'lr 3/15/2008 00:04'!isActive	^ super isActive and: [ self currentNode hasSelector ]! !!OR2CmdSourceRefactoring methodsFor: 'testing-selection' stamp: 'lr 3/17/2007 13:22'!isAssignmentSelected	^ self ifNodeSelected: [ :node | node isAssignment ]! !!OR2CmdSourceRefactoring methodsFor: 'testing-selection' stamp: 'lr 3/17/2007 13:12'!isExtractableSelected	^ self ifNodeSelected: [ :node | node isMethod not and: [ node isVariable not ] ]! !!OR2CmdSourceRefactoring methodsFor: 'testing-selection' stamp: 'lr 3/17/2007 13:09'!isNonSelfSendSelected	^ self ifSendSelected: [ :node | node receiver isVariable not or: [ node receiver name ~= 'self' ] ]! !!OR2CmdSourceRefactoring methodsFor: 'testing-selection' stamp: 'lr 3/17/2007 13:04'!isSelfSendSelected	^ self ifSendSelected: [ :node | node receiver isVariable and: [ node receiver name = 'self' ] ]! !!OR2CmdSourceRefactoring methodsFor: 'testing-selection' stamp: 'lr 3/17/2007 13:26'!isVariableSelected	^ self ifNodeSelected: [ :node | node isVariable ]! !!OR2CmdSourceRefactoring methodsFor: 'accessing-selection' stamp: 'lr 3/17/2007 13:33'!node	^ RBParser parseExpression: self selection onError: [ :str :pos | ^ nil ]! !!OR2CmdSourceRefactoring methodsFor: 'accessing-selection' stamp: 'lr 3/17/2007 13:42'!selection	^ target text asString! !!OR2CmdSourceRefactoring methodsFor: 'accessing-selection' stamp: 'lr 3/17/2007 11:44'!selector	^ RBParser parseMethodPattern: self text! !!OR2CmdSourceRefactoring methodsFor: 'accessing-selection' stamp: 'lr 3/17/2007 13:42'!text	^ target fullText asString! !!OR2CmdSourceRefactoring methodsFor: 'accessing-selection' stamp: 'lr 3/17/2007 10:50'!theClass	^ requestor selectedClass! !!OR2CmdTemporaryToInstvarRefactoring methodsFor: 'testing' stamp: 'lr 3/17/2007 13:39'!isEnabled	^ self isVariableSelected! !!OR2CmdTemporaryToInstvarRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 10:10'!label	^ 'temporary to instvar'! !!OR2CmdTemporaryToInstvarRefactoring methodsFor: 'accessing' stamp: 'lr 1/20/2008 10:52'!longDescription	^ 'Converts a temporary into an instance variable.'! !!OR2CmdTemporaryToInstvarRefactoring methodsFor: 'accessing' stamp: 'lr 3/17/2007 13:39'!refactoring	^ TemporaryToInstanceVariableRefactoring		class: self theClass		selector: self selector		variable: self selection! !!OR2CmdRefactoringRedo methodsFor: 'accessing' stamp: 'lr 2/9/2008 00:58'!change	^ self changeManager redoChange! !!OR2CmdRefactoringRedo methodsFor: 'execution' stamp: 'lr 3/31/2007 13:33'!execute	self changeManager redoOperation! !!OR2CmdRefactoringRedo methodsFor: 'testing' stamp: 'lr 3/31/2007 13:17'!isEnabled	^ self changeManager hasRedoableOperations! !!OR2CmdRefactoringRedo methodsFor: 'accessing' stamp: 'lr 2/9/2008 00:56'!label	^ 'redo' , super label! !!OR2CmdRefactoringTool methodsFor: 'accessing' stamp: 'lr 2/9/2008 00:56'!change	self subclassResponsibility! !!OR2CmdRefactoringTool methodsFor: 'accessing' stamp: 'lr 3/31/2007 13:16'!changeManager	^ RefactoryChangeManager instance! !!OR2CmdRefactoringTool methodsFor: 'accessing' stamp: 'lr 2/26/2009 16:53'!cluster	^ #refactor! !!OR2CmdRefactoringTool methodsFor: 'accessing' stamp: 'lr 2/26/2009 17:05'!group	^ #'undo-redo'! !!OR2CmdRefactoringTool methodsFor: 'accessing' stamp: 'lr 3/13/2009 18:05'!label	^ String streamContents: [ :stream |		self isEnabled ifTrue: [			stream nextPutAll: ': '; nextPutAll: self change name.			stream position > 30				ifTrue: [ stream position: 30; nextPutAll: '...' ] ] ]! !!OR2CmdRefactoringUndo methodsFor: 'accessing' stamp: 'lr 2/9/2008 00:58'!change	^ self changeManager undoChange! !!OR2CmdRefactoringUndo methodsFor: 'execution' stamp: 'lr 3/31/2007 13:33'!execute	self changeManager undoOperation! !!OR2CmdRefactoringUndo methodsFor: 'testing' stamp: 'lr 3/31/2007 13:17'!isEnabled	^ self changeManager hasUndoableOperations! !!OR2CmdRefactoringUndo methodsFor: 'accessing' stamp: 'lr 2/9/2008 00:56'!label	^ 'undo' , super label! !!OR2CmdToggleContainment methodsFor: 'execution' stamp: 'lr 11/11/2008 12:15'!execute	| current selected |	current := self environment.	selected := target browserEnvironment.	(target withinBrowserEnvironment: self environment)		ifTrue: [ 			selected classesAndSelectorsDo: [ :class :selector |				current	removeClass: class selector: selector ] ]		ifFalse: [			selected classesAndSelectorsDo: [ :class :selector |				current addClass: class selector: selector ] ].	requestor refresh! !!OR2CmdToggleContainment methodsFor: 'testing' stamp: 'lr 8/7/2009 12:58'!isActive	^ super isActive and: [ self environment isSelectorEnvironment ]! !!OR2CmdToggleContainment methodsFor: 'accessing' stamp: 'lr 5/21/2007 21:27'!keystroke	^ $/! !!OR2CmdToggleContainment methodsFor: 'accessing' stamp: 'lr 2/9/2008 12:49'!label	^ 'toggle'! !!OR2CmdToggleContainment methodsFor: 'accessing' stamp: 'lr 2/9/2008 12:49'!order	^ '0'! !!OR2Command class methodsFor: 'initialization' stamp: 'lr 2/14/2009 11:48'!initialize	Preferences 		addPreference: #promptOnRefactoring		categories: #('refactoring') default: true		balloonHelp: 'Show the changes before applying a refactoring.'.	Refactoring refactoringOptions		at: #implementorToInline		put: [ :ref :imps | self new requestImplementorToInline: imps ];		at: #methodName		put: [ :ref :string | self new requestMethodNameFor: string ];		at: #selfArgumentName		put: [ :ref | self new requestSelfArgumentName ];		at: #selectVariableToMoveTo		put: [ :ref :class :selector | self new selectVariableToMoveMethodTo: selector class: class ];		at: #variableTypes		put: [ :ref :types :selected | self new selectVariableTypesFrom: types selected: selected for: ref ];		at: #extractAssignment		put: [ :ref :string | self new shouldExtractAssignmentTo: string ];		at: #inlineExpression		put: [ :ref :string | self new shouldInlineExpression: string ];		at: #alreadyDefined		put: [ :ref :class :selector | self new shouldOverride: selector in: class ];		at: #useExistingMethod		put: [ :ref :selector | self new shouldUseExistingMethod: selector ];		at: #openBrowser		put: [ :ref :env | self new openEnvironment: env ]! !!OR2Command methodsFor: 'accessing' stamp: 'lr 2/7/2008 19:17'!browser	^ requestor browser! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 10/15/2007 09:20'!chooseFrom: anArray	^ self chooseFrom: anArray title: nil! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 3/1/2008 21:58'!chooseFrom: anArray title: aString	^ self chooseFrom: anArray title: aString lines: #()! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 3/1/2008 21:58'!chooseFrom: anArray title: aString lines: aCollection 	anArray isEmpty		ifTrue: [ self uiCancellationError ].	anArray size = 1		ifTrue: [ ^ anArray first ].	^ (OBChoiceRequest prompt: aString labels: anArray values: anArray lines: aCollection)		ifNil: [ self uiCancellationError ]! !!OR2Command methodsFor: 'accessing-variables' stamp: 'lr 3/15/2008 09:03'!classVariables	| variables |	variables := self currentNode theNonMetaClass allClassVarNames		asSortedArray.	^ (variables includes: self selection)		ifTrue: [ Array with: self selection ]		ifFalse: [ 			(target isKindOf: OBClassVariableNode)				ifTrue: [ Array with: target name ]				ifFalse: [ variables ] ]! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 10/15/2007 09:21'!confirm: aString	^ (OBConfirmationRequest prompt: aString confirm: 'Yes' cancel: 'No')		ifNil: [ self uiCancellationError ]! !!OR2Command methodsFor: 'accessing' stamp: 'lr 3/15/2008 09:08'!currentNode	^ self browser currentOrRootNode! !!OR2Command methodsFor: 'accessing' stamp: 'lr 2/7/2008 19:20'!environment	^ self browser environment! !!OR2Command methodsFor: 'accessing' stamp: 'cwp 9/30/2007 22:03'!group	^ #refactory! !!OR2Command methodsFor: 'private' stamp: 'lr 3/14/2008 23:56'!handleError: aBlock 	^ aBlock		on: Refactoring preconditionSignal		do: [ :ex | 			ex isResumable 				ifTrue: [					(self confirm: (ex messageText last = $?						ifTrue: [ ex messageText ]						ifFalse: [ ex messageText , '\Do you want to proceed?' withCRs ])) 							ifTrue: [ ex resume ] ]				ifFalse: [					ex parameter notNil 						ifTrue: [ (self confirm: ex messageText) 							ifTrue: [ ex parameter value ] ]						ifFalse: [ self inform: ex messageText ] ].			ex return: nil ]! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 2/9/2008 16:13'!inform: aString	^ OBInformRequest message: aString! !!OR2Command methodsFor: 'accessing-variables' stamp: 'lr 3/15/2008 09:02'!instanceVariables	| variables |	variables := self currentNode theClass allInstVarNames		asSortedArray.	^ (variables includes: self selection)		ifTrue: [ Array with: self selection ]		ifFalse: [			(target isKindOf: OBInstanceVariableNode)				ifTrue: [ Array with: target name ]				ifFalse: [ variables ] ]! !!OR2Command methodsFor: 'testing' stamp: 'DavidRoethlisberger 9/11/2009 15:11'!isActive	(self class takesText and: [ target isKindOf: O2TextSelection ])		ifTrue: [ ^ true ].	(self class takesNodes and: [ requestor isSelected: target ])		ifTrue: [ ^ true ].	^ false! !!OR2Command methodsFor: 'actions' stamp: 'lr 5/14/2008 13:21'!openEnvironment: anEnvironment	anEnvironment isSystem		ifTrue: [ ^ target browse ].	anEnvironment isEmpty		ifTrue: [ ^ self inform: 'Empty environment' ].	self waitWhile: [		| instance |		instance := anEnvironment browserInstance.		[ instance jumpTo: target ] 			ifError: [ instance jumpToRoot ].		instance open ]! !!OR2Command methodsFor: 'private' stamp: 'lr 5/14/2008 13:23'!performChange: aChange	self waitWhile: [		RefactoryChangeManager instance			performChange: aChange ]! !!OR2Command methodsFor: 'private' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!performRefactoring: aRefactoring 	"Try to properly label aRefactoring and perform it or open the changes browser, depending on the preferences of the user."	self label isNil ifFalse: 		[ aRefactoring model name: (String streamContents: 				[ :stream | 				self cluster isNil ifFalse: 					[ stream						nextPutAll: self cluster;						nextPutAll: ', ' ].				stream nextPutAll: self label ]) ].	self waitWhile: 		[ Preferences promptOnRefactoring 			ifFalse: [ aRefactoring execute ]			ifTrue: 				[ aRefactoring primitiveExecute.				OR2ChangesBrowser openChange: aRefactoring changes ] ]! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/12/2008 10:20'!refresh	^ self browser signalRefresh! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 10/15/2007 09:20'!request: aString	^ self request: aString initialAnswer: String new! !!OR2Command methodsFor: 'accessing-conveniance' stamp: 'lr 10/15/2007 09:21'!request: aString initialAnswer: aTemplateString	^ (OBTextRequest prompt: aString template: aTemplateString)		ifNil: [ self uiCancellationError ]! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 22:54'!requestImplementorToInline: aCollection	^ Smalltalk classNamed: (self		chooseFrom: (aCollection collect: [ :each | each name ])		title: 'Which implementation should be inlined?')! !!OR2Command methodsFor: 'actions' stamp: 'dr 12/4/2009 10:23'!requestMethodNameFor: aMethodName	| string parser pattern |	string := self 		request: 'Selector Name:'		initialAnswer: aMethodName asString.	parser := RBParser new.	parser errorBlock: [ :error :position | ^ nil ].	parser initializeParserWith: string.	pattern := parser parseMessagePattern.	^ RBMethodName		selector: pattern selector		arguments: pattern argumentNames! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 22:55'!requestSelfArgumentName	^ self request: 'Enter name for argument to refer to "self" in extracted method'! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 21:59'!selectVariableToMoveMethodTo: aSelector class: aClass	| parseTree nameList | 	parseTree := aClass parseTreeFor: aSelector.	parseTree isNil ifTrue: [ 		parseTree := RBMethodNode 			selector: #value			body: (RBSequenceNode statements: #()) ].	nameList := OrderedCollection new.	nameList		addAll: parseTree argumentNames asSortedCollection;		addAll: aClass allInstanceVariableNames asSortedCollection.	^ self 		chooseFrom: nameList 		title: 'Select variable to move method into:'		lines: (Array with: parseTree argumentNames size)! !!OR2Command methodsFor: 'actions' stamp: 'lr 2/14/2009 11:48'!selectVariableTypesFrom: aCollectionOfTypes selected: aSelectedCollection for: aRefactoring	| stream result |	stream := WriteStream on: String new.	aCollectionOfTypes		do: [ :each | stream nextPutAll: each name ]		separatedBy: [ stream cr ].	result := OBMultiLineTextRequest		prompt: 'Select classes to move to:'		template: stream contents.	result isNil		ifTrue: [ ^ self uiCancellationError ].	^ (result findTokens: String crlf)		collect: [ :each | aRefactoring model classFor: (Smalltalk classNamed: each withBlanksTrimmed) ]		! !!OR2Command methodsFor: 'accessing' stamp: 'DavidRoethlisberger 9/11/2009 15:11'!selection	^ (target isKindOf: O2TextSelection)		ifTrue: [ target text asString ]! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 21:42'!shouldExtractAssignmentTo: aString	^ self confirm: ('Do you want to extract the assignment of <1s> at the end of selection?' expandMacrosWith: aString)! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 21:42'!shouldInlineExpression: aString	^ self confirm: ('Do you want to inline <1s>? If not, it will be assigned as a temporary.' expandMacrosWith: aString)! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 21:54'!shouldOverride: aSelector in: aClass 	^ self confirm: ('<1s> is already defined in the <2p> hierarchy. Extracting it to an existing selector may change behavior. Do you wish to use <1s> anyway?' expandMacrosWith: aSelector with: aClass)! !!OR2Command methodsFor: 'actions' stamp: 'lr 3/1/2008 21:41'!shouldUseExistingMethod: aSelector	^ self confirm: ('Use existing method <1s> instead of creating new method?' expandMacrosWith: aSelector)! !!OR2Command methodsFor: 'private' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!uiCancellationError	"The user pressed Cancel or there were nothing to ask for. The error must be catched by #execute in order to cancel the action."	^ OR2UICancellationError signal! !!OR2Command methodsFor: 'private' stamp: 'lr 5/14/2008 15:47'!waitWhile: aBlock	^ OBWaitRequest block: aBlock! !!O2CommandCluster class methodsFor: 'as yet unclassified' stamp: 'cwp 9/30/2007 20:24'!label: aString	^ self new setLabel: aString! !!O2CommandCluster methodsFor: 'accessing' stamp: 'cwp 9/30/2007 20:19'!addCommand: aCommand	commands add: aCommand! !!O2CommandCluster methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!addItemToMenu: aMenu	| submenu |	submenu := aMenu addSubmenu: label enabled: self isEnabled.	self populateMenu: submenu! !!O2CommandCluster methodsFor: 'accessing' stamp: 'cwp 9/30/2007 20:40'!group	^ #zclusters! !!O2CommandCluster methodsFor: 'accessing' stamp: 'dr 5/6/2009 11:23'!groupedCommands	| groups |	groups := commands 				groupBy: [:svc | svc group]				having: [:group | group isEmpty not].	groups := groups collect: [:ea | ea asArray sort: [:a :b | a priority < b priority or: [a priority = b priority and: [a label <= b label]]]].	^ groups asArray sort: [:a :b | a anyOne group <= b anyOne group]! !!O2CommandCluster methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!initialize	commands := IdentitySet new! !!O2CommandCluster methodsFor: 'accessing' stamp: 'cwp 9/30/2007 21:54'!isEnabled	^ commands anySatisfy: [:ea | ea isEnabled]! !!O2CommandCluster methodsFor: 'accessing' stamp: 'cwp 9/30/2007 20:16'!label	^ label! !!O2CommandCluster methodsFor: 'accessing' stamp: 'cwp 9/30/2007 21:01'!populateMenu: aMenu 	self groupedCommands			do: [:group | group do: [:cmd | cmd addItemToMenu: aMenu]]		separatedBy: [aMenu addLine]! !!O2CommandCluster methodsFor: 'accessing' stamp: 'dr 5/6/2009 11:17'!priority	^0! !!O2CommandCluster methodsFor: 'initialize-release' stamp: 'DamienCassou 12/23/2009 16:36'!setLabel: aSymbol 	label := aSymbol! !!O2DPNotifier commentStamp: 'dc 9/7/2006 23:10' prior: 35453915!Used to update the cache of all dynamic protocols when something changes in the system.!!O2DPNotifier class methodsFor: 'defaults' stamp: 'dc 9/7/2006 22:19'!default	^ SoleInstance ifNil: [SoleInstance := super new]! !!O2DPNotifier class methodsFor: 'initialization' stamp: 'dc 9/12/2006 19:07'!initialize	SoleInstance := super new! !!O2DPNotifier class methodsFor: 'instance creation' stamp: 'dc 9/7/2006 22:20'!new	^ self shouldNotImplement! !!O2DPNotifier class methodsFor: 'initialize-release' stamp: 'dc 9/18/2006 17:14'!unload	self default tearDown.	super unload! !!O2DPNotifier methodsFor: 'initialize-release' stamp: 'scg 8/24/2009 10:45'!hookup	self notifier		noMoreNotificationsFor: self;		noMoreNotificationsFor: O2DynamicProtocols;		notify: O2DynamicProtocols			ofSystemChangesOfItem: #method			change: #Modified			using: #modifiedMethodEvent:;		notify: O2DynamicProtocols			ofSystemChangesOfItem: #method			change: #Added			using: #addedMethodEvent:;		notify: O2DynamicProtocols			ofSystemChangesOfItem: #method			change: #Removed			using: #removedMethodEvent:;		notify: O2DynamicProtocols			ofSystemChangesOfItem: #class			change: #Removed			using: #removedClassEvent:! !!O2DPNotifier methodsFor: 'initialization' stamp: 'dc 9/7/2006 22:33'!initialize	self hookup! !!O2DPNotifier methodsFor: 'initialize-release' stamp: 'dc 9/7/2006 22:46'!notifier	^ SystemChangeNotifier uniqueInstance! !!O2DPNotifier methodsFor: 'initialize-release' stamp: 'scg 8/24/2009 10:45'!tearDown	self notifier		noMoreNotificationsFor: self;		noMoreNotificationsFor: O2DynamicProtocols! !!O2DefaultEdgeNavigation methodsFor: 'comparing' stamp: 'jk 4/2/2008 12:58'!= anObject 	^ self class = anObject class! !!O2DefaultEdgeNavigation methodsFor: 'navigation' stamp: 'jk 3/28/2008 12:48'!columnAfter: anOBColumn withFan: anOBFan selection: aSmallInteger 	^ anOBColumn nextColumnForDefaultNavigationWithFan: anOBFan selection: aSmallInteger! !!O2DefaultEdgeNavigation methodsFor: 'testing' stamp: 'jk 3/26/2008 13:18'!isDefaultNavigation	^ true! !!O2DefaultEdgeNavigation methodsFor: 'testing' stamp: 'jk 12/29/2007 14:54'!isTreeNavigation	^ false! !!O2Definition commentStamp: 'cwp 1/7/2005 23:38' prior: 35454063!The responsibility of a definition is to express a node's composition textually and respond to changes in the text by updating the node it represents. For example,a file browser might use a file definition to allow editing of a files contents.!!O2ClassCommentDefinition class methodsFor: 'as yet unclassified' stamp: 'cwp 8/7/2007 00:09'!on: aClass	^ self new setClass: aClass! !!O2ClassCommentDefinition methodsFor: 'accessing' stamp: 'dc 10/6/2007 15:26'!selectedClass	^ theClass ! !!O2ClassCommentDefinition methodsFor: 'accessing' stamp: 'dc 10/6/2007 15:27'!setClass: aClass	theClass := aClass! !!O2ClassCommentDefinition methodsFor: 'callbacks' stamp: 'cwp 8/7/2007 00:07'!text	^ theClass comment! !!O2ClassCommentDefinition methodsFor: 'callbacks' stamp: 'cwp 8/7/2007 00:24'!text: aText	theClass comment: aText stamp: Utilities changeStamp.	^ true! !!O2ClassDefinition commentStamp: 'cwp 1/8/2005 13:13' prior: 35454372!OBClassDefinition presents a textual interface for examining, modifying and creating classes. Given a class, it knows how to display the definition expression that reflects it's current state, and knows how to create or modify a class given a definition expression.OBClassDefinition implements a number of safety checks when defining or redefining classes, to ensure that existing classes are not accidentally overwritten.!!O2ClassDefinition class methodsFor: 'instance creation'!environment: anEnvironment template: aString 	^ self new setEnvironment: anEnvironment template: aString! !!O2ClassDefinition methodsFor: 'callbacks'!accept: aText notifying: aController	^ self defineClass: aText notifying: aController! !!O2ClassDefinition methodsFor: 'confirmation'!confirmDefinition: definition	"Check to make sure the user isn't accidentally over-writing an existing class."		(((self isRedefinition: definition) not) and: [self definedClassExists: definition])		ifTrue: [^ self confirmRedefinition: definition]		ifFalse: [^ true]! !!O2ClassDefinition methodsFor: 'confirmation' stamp: 'scg 8/24/2009 10:45'!confirmRedefinition: definition 	| newName prompt |	newName := self nameOfClassDefinedBy: definition.	prompt := (newName , ' is an existing class in this system.Redefining it might cause serious problems.Is this really what you want to do?') asText.	^ O2ConfirmationRequest 		prompt: prompt		confirm: 'Redefine'! !!O2ClassDefinition methodsFor: 'class definition'!defineClass: definition notifying: aController	| evaluator newClass |	(self confirmDefinition: definition) ifFalse: [^ false].	evaluator := self evaluatorForDefinition: definition.	newClass := evaluator				evaluate: definition				notifying: aController				logged: true.	newClass ifNil: [^ false].	self signalSelectionOf: newClass.	^ true! !!O2ClassDefinition methodsFor: 'confirmation'!definedClassExists: definition	^ environment hasClassNamed: (self nameOfClassDefinedBy: definition)! !!O2ClassDefinition methodsFor: 'class definition'!evaluatorForDefinition: definition	| tokens |	tokens := Scanner new scanTokens: definition.	^ (environment at: tokens first ifAbsent: [nil]) subclassDefinerClass! !!O2ClassDefinition methodsFor: 'confirmation'!isRedefinition: aDefinition	^ (self nameOfClassDefinedBy: aDefinition) = (self nameOfClassDefinedBy: template)! !!O2ClassDefinition methodsFor: 'confirmation'!nameOfClassDefinedBy: definition	^ (Scanner new scanTokens: definition) third! !!O2ClassDefinition methodsFor: 'confirmation' stamp: 'cwp 10/18/2004 00:13'!selectedClass	^ environment at: (self nameOfClassDefinedBy: template) ifAbsent: [nil]! !!O2ClassDefinition methodsFor: 'initializing'!setEnvironment: anEnvironment template: aText	environment := anEnvironment.	template := aText.! !!O2ClassDefinition methodsFor: 'class definition' stamp: 'scg 8/24/2009 11:29'!signalSelectionOf: aClass 	aClass asO2Node demandSelection! !!O2ClassDefinition methodsFor: 'callbacks'!text	^ template! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 3/22/2004 20:51'!accept: aText notifying: aController	^ self text: aText! !!O2Definition methodsFor: 'testing' stamp: 'cwp 12/26/2007 10:16'!allowsEditing	^ true! !!O2Definition methodsFor: 'updating' stamp: 'scg 8/24/2009 11:11'!asO2Announcement	^ O2DefinitionChanged definition: self! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 3/23/2004 00:08'!doItContext	^ nil! !!O2Definition methodsFor: 'callbacks' stamp: 'DamienCassou 12/23/2009 16:36'!doItReceiver	| class |	class := self selectedClass.	^ class		ifNotNil: [class theNonMetaClass]		ifNil: [FakeClassPool new]! !!O2Definition methodsFor: 'testing' stamp: 'cwp 12/26/2007 13:35'!isEditable	^ true! !!O2Definition methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!isEnrichedDefinition    ^false! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 12/26/2007 23:00'!selectedClass	^ nil! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 3/23/2004 22:16'!selection	^ 1 to: 0! !!O2Definition methodsFor: 'updating' stamp: 'scg 8/24/2009 10:45'!signalChange	O2Announcer current announce: (O2DefinitionChanged definition: self)! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 3/22/2004 20:52'!text	^ ''! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 3/22/2004 20:52'!text: aText	^ false! !!O2Definition methodsFor: 'callbacks' stamp: 'cwp 3/23/2004 22:16'!textSelection	^ self selection! !!O2MethodDefinition commentStamp: 'cwp 1/8/2005 13:20' prior: 35454863!OBMethodDefinition knows how to present method source in the browser's text pane and compile a new CompiledMethod when the source changes. It implements several safety checks to ensure that methods are not accidentally overwritten.!!O2MethodDefinition class methodsFor: 'instance creation' stamp: 'cwp 10/17/2004 23:07'!inCategory: aString inClass: aClass	^ self 		selection: nil		source: nil		inCategory: aString		inClass: aClass! !!O2MethodDefinition class methodsFor: 'instance creation' stamp: 'cwp 10/17/2004 23:07'!selection: anInterval source: aText inCategory: aCategory inClass: aClass	^ self new		setClass: aClass		category: aCategory		source: aText		selection: anInterval! !!O2MethodDefinition class methodsFor: 'instance creation' stamp: 'cwp 10/17/2004 23:07'!selection: anInterval source: aText inClass: aClass	^ self 		selection: anInterval		source: aText		inCategory: nil		inClass: aClass	! !!O2MethodDefinition class methodsFor: 'instance creation' stamp: 'cwp 10/17/2004 23:03'!source: aText inClass: aClass	^ self 		selection: nil		source: aText		inCategory: nil		inClass: aClass! !!O2MethodDefinition methodsFor: 'callbacks' stamp: 'dr 11/4/2008 19:43'!accept: aText notifying: aController	| newSelector | 	newSelector := self compileMethod: aText notifying: aController.	newSelector ifNil: [^ false]. 	(self nodeFor: newSelector) demandSelection.		^ true! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'cwp 10/17/2004 23:36'!callback: aBlockContext 	callback := aBlockContext! !!O2MethodDefinition methodsFor: 'accessing'!category	^ category ifNil: [category := self theClass whichCategoryIncludesSelector: self selector]! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 20:09'!compileCategory	^ compileCategory! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 20:09'!compileCategory: anObject	compileCategory := anObject! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 18:36'!compileClass	^ compileClass! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 18:36'!compileClass: anObject	compileClass := anObject! !!O2MethodDefinition methodsFor: 'compiling' stamp: 'dr 7/8/2009 11:59'!compileMethod: aText notifying: aController 	self compileClass: self theClass.	self compileCategory: self category.	self compileText: aText.	^self executePrecompilationValidations 		ifTrue: [self compileNotifying: aController]		ifFalse: [nil]! !!O2MethodDefinition methodsFor: 'compiling' stamp: 'cwp 10/18/2007 00:03'!compileNotifying: aController 	"This is a little convoluted because I want it to work whether or not	UndeclaredVariable exists. If it does exist, install a handler, otherwise	just compile the method with no special handling. -cwp 2007-10-15"		| compileBlock exception |	compileBlock := [self compileClass 						compile: self compileText						classified: self compileCategory						notifying: aController].	exception := Smalltalk classNamed: #ParserNotification.	^ exception		ifNil: [compileBlock value]		ifNotNil: 			[compileBlock				on: exception				do: [:exc | self convertToChoice: exc]]! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 18:41'!compileSelector	^ self compileText ifNotNil: [Parser new parseSelector: self compileText]! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 18:37'!compileText	^ compileText! !!O2MethodDefinition methodsFor: 'accessing' stamp: 'jk 8/22/2007 18:37'!compileText: anObject	compileText := anObject! !!O2MethodDefinition methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!confirmCompileLocalyOrInUsedTrait: aTrait 	| result prompt m1 m2 m3 r1 r3 |	prompt := 'You are compiling a method that already exists in aused trait. What do you want to do:' translated.	r1 := self compileClass.	r3 := nil.	m1 := 'Compile the method locally in ' translated , r1 asString.	m2 := 'Compile the method in the trait ' translated , aTrait asString.	m3 := 'Cancel' translated.	result := O2ChoiceRequest 		prompt: prompt		labels: (Array 				with: m1				with: m2				with: m3)		values: (Array 				with: r1				with: aTrait				with: r3).	result = aTrait ifTrue: [ self compileClass: aTrait ].	result isNil ifTrue: [ ^ false ].	^ true! !!O2MethodDefinition methodsFor: 'compiling' stamp: 'scg 8/24/2009 10:45'!convertToChoice: exception 	exception openMenuIn: 		[ :labels :lines :caption | 		O2ChoiceRequest 			prompt: caption			labels: labels			values: (1 to: labels size)			lines: lines ]! !!O2MethodDefinition methodsFor: 'validation' stamp: 'jk 8/22/2007 19:02'!executePrecompilationValidations	"It executes all selectors beginning with 'validate'. All such selector have to return 	true/false value and have no arguments. After success validation, self compileText 	will compiled in self compileClass. 'self compileSelector can be used.'"	(self class allSelectors select: [:ea | ea beginsWith: 'validate']) 		do: [:selector | (self perform: selector) ifFalse: [^ false]].	^ true! !!O2MethodDefinition methodsFor: 'compiling' stamp: 'cwp 10/17/2004 23:33'!nodeFor: aSelector	^ callback value: aSelector! !!O2MethodDefinition methodsFor: '*o2-refactory' stamp: 'DavidRoethlisberger 9/8/2009 23:57'!prettyPrint: aString	^ source := self theClass formatterClass format: aString in: theClass notifying: nil! !!O2MethodDefinition methodsFor: 'callbacks' stamp: 'cwp 10/17/2004 23:16'!redefineSource: aText selector: newSelector	newSelector = self selector 		ifTrue: [source := aText]		ifFalse: [(self methodNodeFor: newSelector) signalSelection].! !!O2MethodDefinition methodsFor: 'callbacks'!selectedClass	^ self theClass! !!O2MethodDefinition methodsFor: 'callbacks'!selection	^ selection ifNil: [1 to: (source ifNil: [self text size] ifNotNil: [0])]! !!O2MethodDefinition methodsFor: 'accessing'!selector	^ source ifNotNil: [Parser new parseSelector: source]! !!O2MethodDefinition methodsFor: 'confirming'!selectorAlreadyDefined: aSelector	^ self theClass selectors includes: aSelector! !!O2MethodDefinition methodsFor: 'initializing' stamp: 'scg 8/24/2009 10:45'!setClass: aClass category: aString source: aText selection: anInterval 	theClass := aClass.	category := aString.	source := aText.	selection := anInterval.	callback := 	[ :sel | 	O2MethodNode 		on: sel		inClass: theClass ]! !!O2MethodDefinition methodsFor: 'callbacks' stamp: 'cwp 11/29/2004 21:21'!text	^ source 		ifNotNil: [source asText makeSelectorBold]		ifNil: [self theClass sourceCodeTemplate]! !!O2MethodDefinition methodsFor: 'accessing'!theClass	^ theClass! !!O2MethodDefinition methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!validateMethodOfUsedTrait	| messageLocation |		messageLocation := self compileClass traitOrClassOfSelector: self compileSelector.	self compileClass = messageLocation ifTrue: [^ true]. "it is local message"	messageLocation isTrait ifTrue: 		[^ self confirmCompileLocalyOrInUsedTrait: messageLocation ].	^ true! !!O2OrganizationDefinition commentStamp: 'cwp 1/8/2005 13:31' prior: 35455167!OBOrganizationDefinition knows how to display and edit the organization of classes or methods by a Categorizer.!!O2OrganizationDefinition class methodsFor: 'as yet unclassified' stamp: 'cwp 9/22/2004 21:20'!on: anOrganizer	^ self new organizer: anOrganizer! !!O2OrganizationDefinition methodsFor: 'as yet unclassified' stamp: 'cwp 9/22/2004 21:21'!organizer: anOrganizer	organizer := anOrganizer! !!O2OrganizationDefinition methodsFor: 'callbacks' stamp: 'cwp 9/22/2004 21:18'!text	^ organizer asString! !!O2OrganizationDefinition methodsFor: 'callbacks' stamp: 'scg 8/24/2009 10:45'!text: aText 	organizer changeFromString: aText asString.	O2Announcer current announce: O2RefreshRequired.	^ true! !!O2ReadOnlyDefinition methodsFor: 'callbacks' stamp: 'dc 6/18/2007 19:31'!setText: aText	text := aText! !!O2ReadOnlyDefinition methodsFor: 'callbacks' stamp: 'dc 6/18/2007 19:14'!text	^ text! !!O2TextDefinition class methodsFor: 'instance creation' stamp: 'dc 3/13/2008 21:49'!text: aText	^ self new		setText: aText;		yourself! !!O2TextDefinition methodsFor: 'initialize-release' stamp: 'dc 3/13/2008 21:51'!setText: aText	text := aText ! !!O2TextDefinition methodsFor: 'accessing' stamp: 'dc 3/13/2008 21:51'!text	^ text! !!OR2RewriterDefinition methodsFor: 'configuration' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!createRuleFor: aMatcher 	^ OR2PluggableRewriteRule new		rewriteRule: aMatcher;		yourself! !!OR2RewriterDefinition methodsFor: 'configuration' stamp: 'lr 3/1/2008 20:45'!template	^ 'ParseTreeRewriter new	replace: ''`@object'' with: ''`@object'';	replace: ''`@object'' with: ''`@object'' when: [ :node | true ];	replace: ''`@object'' withValueFrom: [ :node | node ];	replace: ''`@object'' withValueFrom: [ :node | node ] when: [ :node | true ];	replaceMethod: ''`@method: `@args | `@temps | `@.statements'' with: ''`@method: `@args | `@temps | `@.statements'';	replaceMethod: ''`@method: `@args | `@temps | `@.statements'' with: ''`@method: `@args | `@temps | `@.statements'' when: [ :node | true ];	replaceMethod: ''`@method: `@args | `@temps | `@.statements'' withValueFrom: [ :node | node ];	replaceMethod: ''`@method: `@args | `@temps | `@.statements'' withValueFrom: [ :node | node ] when: [ :node | true ];	yourself'! !!OR2SearcherDefinition class methodsFor: 'instance-creation' stamp: 'lr 3/1/2008 18:14'!on: anEnvironment	^ self new initializeOn: anEnvironment! !!OR2SearcherDefinition methodsFor: 'accessing' stamp: 'lr 11/9/2008 16:29'!accept: aText notifying: aController	| rule |	text := aText asString.	rule := self createRuleFor: (self class		evaluatorClass			evaluate: text			for: self			notifying: aController			logged: false).	OBWaitRequest block: [		rule runOnEnvironment: environment ].	rule problemCount = 0		ifTrue: [ OBInformRequest message: 'No matches found.' ]		ifFalse: [ rule browserInstance open ].	^ rule problemCount > 0! !!OR2SearcherDefinition methodsFor: 'configuration' stamp: 'DavidRoethlisberger 9/8/2009 23:44'!createRuleFor: aMatcher 	^ OR2PluggableSearchRule new		matcher: aMatcher;		yourself! !!OR2SearcherDefinition methodsFor: 'initialization' stamp: 'lr 3/1/2008 18:15'!initializeOn: anEnvironment	environment := anEnvironment! !!OR2SearcherDefinition methodsFor: 'configuration' stamp: 'lr 3/1/2008 20:38'!template	^ 'ParseTreeSearcher new	matches: ''`@object'' do: [ :node :answer | node ];	matchesMethod: ''`@method: `@args | `@temps | `@.statements'' do: [ :node :answer | node ];	yourself'! !!OR2SearcherDefinition methodsFor: 'accessing' stamp: 'lr 3/1/2008 18:16'!text	^ text ifNil: [ text := self template ]! !!O2DummyPackage commentStamp: 'dr 7/16/2007 10:42' prior: 35455341!I am a dummy for a Monticello package. I am used for class categories existing in the image that are not contained in any Monticello package. I list all these ownerless class categories in alphabetical order. !!O2DummyPackage class methodsFor: 'instance creation' stamp: 'dr 7/22/2007 12:00'!categories: aCollection    ^self new categories: aCollection! !!O2DummyPackage class methodsFor: 'instance creation' stamp: 'dr 7/11/2008 10:56'!packageName: aString    ^self new packageName: aString; yourself! !!O2DummyPackage methodsFor: 'converting' stamp: 'scg 8/24/2009 11:29'!asO2Node	^ O2MonticelloPackageNode new workingCopy: self! !!O2DummyPackage methodsFor: 'accessing' stamp: 'dr 6/18/2007 17:10'!categories    ^categories! !!O2DummyPackage methodsFor: 'accessing' stamp: 'dr 6/18/2007 17:09'!categories: aCollection    categories := aCollection! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 6/18/2007 17:09'!classes    ^(self categories gather: 		[:cat |		(SystemOrganization listAtCategoryNamed: cat)			collect: [:className | Smalltalk at: className]])				sortBy: [:a :b | a className <= b className]! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 6/18/2007 17:10'!extensionClasses    ^OrderedCollection new! !!O2DummyPackage methodsFor: 'testing' stamp: 'dr 10/24/2008 11:00'!includesCategoryWithName: aString    ^self categories includes: aString! !!O2DummyPackage methodsFor: 'initializing' stamp: 'dr 7/11/2008 10:56'!initialize    categories := OrderedCollection new.! !!O2DummyPackage methodsFor: 'testing' stamp: 'dr 4/16/2009 19:37'!isDummy    ^true! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 6/18/2007 16:57'!modified    ^false! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 6/18/2007 17:08'!packageInfo    ^self! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'DavidRoethlisberger 10/17/2009 11:46'!packageName    packageName ifNotNil: [^packageName].    ^self unpackagedName ! !!O2DummyPackage methodsFor: 'accessing' stamp: 'dr 7/11/2008 10:55'!packageName: aString    packageName := aString! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 7/11/2008 11:00'!possiblyNewerVersionsIn: repository    ^#()! !!O2DummyPackage methodsFor: 'accessing' stamp: 'dr 10/24/2008 10:27'!removeCategory: aString    ^self categories remove: aString! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 6/18/2007 16:57'!repositories    ^OrderedCollection new! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 7/3/2008 17:35'!repositoryGroup    ^MCRepositoryGroup new! !!O2DummyPackage methodsFor: 'dummy accessors' stamp: 'dr 9/2/2008 15:13'!systemCategoryPrefix    ^''! !!O2DummyPackage methodsFor: 'configuration' stamp: 'DavidRoethlisberger 10/17/2009 11:46'!unpackagedName	^'Unpackaged'! !!O2DynamicProtocols commentStamp: 'dc 9/17/2006 14:31' prior: 35455617!A dynamic protocol is a category (displayed in the 3rd pane of your browser) whose content is computed dynamically based on the currently selected class. If a dynamic protocol is empty then it is not shown.This system is based on an idea of Nathanael Shärli and Andrew P. Black (see 'A Browser For Incremental Programming')Here is a small list of possible dynamic protocols:- HaltUsage: displays all methods containing a call to #halt- Override: contains methods that are defined in the superclasses and redefined in the current class- RecentlyModified, SuperSend...A preference system has been set to permit the selection of desired dynamic protocols. After having browsed at least one class using OmniBrowser, you can set your preferred protocols using the Preference Browser in the category 'dynamic protocols'.!!O2DynamicProtocols class methodsFor: 'accessing' stamp: 'dc 3/28/2007 18:20'!activationPreferenceName	^ #dynamicProtocolActivation! !!O2DynamicProtocols class methodsFor: 'events' stamp: 'dc 9/22/2006 14:56'!addedMethodEvent: anEvent	"Send the event to all activated protocols"	self allActivatedProtocols do: [:protocol | protocol theMethodNamed: anEvent itemSelector hasBeenAddedIn: anEvent itemClass]! !!O2DynamicProtocols class methodsFor: 'accessing' stamp: 'dc 9/17/2006 13:08'!allActivatedProtocols	"Returns all dynamic protocol classes the user activated (using Preference Browser)."	^ self allAvailableProtocols select: [:dpClass | dpClass isActivated]! !!O2DynamicProtocols class methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!allAvailableProtocols	"Return all non abstract dynamic protocol classes in the system."	^ O2DPAbstract withAllSubclasses select: [ :dpClass | dpClass isAbstract not ]! !!O2DynamicProtocols class methodsFor: 'testing' stamp: 'dc 3/28/2007 18:24'!areDynamicProtocolsActivated	| preference |	preference := Preferences				preferenceAt: self activationPreferenceName 				ifAbsent: [self setActivationPreference.					Preferences preferenceAt: self activationPreferenceName].	^ preference preferenceValue! !!O2DynamicProtocols class methodsFor: 'accessing' stamp: 'dc 8/24/2007 15:48'!collectAllProtocolsOnClass: aClass 	"Returns a collection of all dynamic protocols that should be displayed for the current class.	Only non-empty protocols are returned."	^ self areDynamicProtocolsActivated		ifFalse: [Array new]		ifTrue: [self privateCollectAllProtocolsOnClass: aClass]! !!O2DynamicProtocols class methodsFor: 'initialization' stamp: 'za 2/14/2009 14:47'!initializePreferences	"Install a preference for all existing protocols. Calling this method is optional because each protocol will automatically set his preference on first use. However, you can still call it to initialize everything automatically."	self allAvailableProtocols do: [:protocol | protocol initializePreferences].	self setActivationPreference ! !!O2DynamicProtocols class methodsFor: 'caching' stamp: 'dc 9/22/2006 15:12'!invalidateCache	self allAvailableProtocols do: [:protocol | protocol invalidateCache]! !!O2DynamicProtocols class methodsFor: 'caching' stamp: 'dc 9/22/2006 15:10'!invalidateCacheFor: aClass	self allAvailableProtocols do: [:protocol | protocol invalidateCacheFor: aClass]! !!O2DynamicProtocols class methodsFor: 'events' stamp: 'dc 9/22/2006 14:56'!modifiedMethodEvent: anEvent	"Send the event to all activated protocols"	self allActivatedProtocols do: [:protocol | protocol theMethodNamed: anEvent itemSelector hasChangedIn: anEvent itemClass]! !!O2DynamicProtocols class methodsFor: 'private' stamp: 'za 8/16/2008 21:07'!privateCollectAllProtocolsOnClass: aClass	"Returns a collection of all dynamic protocols that should be displayed for the current class.	Only non-empty protocols are returned."	|protocols|	protocols := self allActivatedProtocols.	^ protocols 		collect: [:dpClass | dpClass on: aClass]		thenSelect: [:dp | dp isDeferred or: [dp methodReferences isEmpty not]]! !!O2DynamicProtocols class methodsFor: 'events' stamp: 'za 7/25/2008 12:23'!removedClassEvent: anEvent	anEvent itemClass withAllSubclassesDo: 		[:eachClass |		self invalidateCacheFor: eachClass]! !!O2DynamicProtocols class methodsFor: 'events' stamp: 'dc 9/22/2006 14:56'!removedMethodEvent: anEvent	"Send the event to all activated protocols"	self allActivatedProtocols do: [:protocol | protocol theMethodNamed: anEvent itemSelector hasBeenRemovedIn: anEvent itemClass]! !!O2DynamicProtocols class methodsFor: 'accessing' stamp: 'dc 3/28/2007 18:25'!setActivationPreference	Preferences		addBooleanPreference: self activationPreferenceName 		categories: {#'dynamic protocols'}		default: true		balloonHelp: 'Activates the dymamic protocol system'.! !!O2EnhancementFan methodsFor: 'accessing' stamp: 'dr 1/29/2009 10:56'!lastNode	^lastNode! !!O2EnhancementFan methodsFor: 'selecting' stamp: 'dr 2/25/2008 10:52'!removeAutoSelection    lastNode := nil! !!O2EnhancementFan methodsFor: 'accessing' stamp: 'dr 10/21/2008 21:51'!setLastNode: aNode	(aNode notNil and: [aNode isMethodNode]) ifTrue: [lastNode := aNode]! !!O2EnhancementFan methodsFor: 'testing' stamp: 'dr 1/28/2009 15:42'!shouldUpdateOnAutoSelect    ^parent metaNode autoSelect ifNotNilDo: [:autoSelect | autoSelect metaNode shouldUpdateOnAutoSelect]                                                        ifNil: [false].! !!O2Fan class methodsFor: '*o2-enhancements' stamp: 'TestRunner 11/6/2009 11:10'!defaultParent: aNode	^ self parent: aNode children: aNode childNodesWithinTree! !!O2Fan class methodsFor: 'instance creation' stamp: 'cwp 8/16/2007 12:02'!parent: aNode	^ self new setParent: aNode! !!O2Fan class methodsFor: 'instance creation' stamp: 'cwp 8/16/2007 11:50'!parent: aNode children: aCollection 	^ self new setParent: aNode children: aCollection! !!O2Fan class methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!treeParent: aNode	^ self parent: aNode children: aNode childNodesWithinTree! !!O2Fan methodsFor: 'accessing' stamp: 'cwp 8/20/2007 00:27'!allChildren	^ parent metaNode allChildrenForNode: parent.! !!O2Fan methodsFor: 'selecting' stamp: 'dr 10/22/2008 11:09'!ancestorOf: aNode from: aCollection in: aBlock	aCollection doWithIndex:		[:node :index | 		(node isAncestorOf: aNode using: node metaNode ancestrySelector)			ifTrue: [aBlock value: index. ^ node]].	^ nil! !!O2Fan methodsFor: 'selecting' stamp: 'cwp 8/20/2007 15:59'!ancestorOf: aNode in: aBlock 	| ancestor |	ancestor := self ancestorOf: aNode from: children in: aBlock.	ancestor ifNil: 		[ancestor := parent childAncestorOf: aNode indexIn: aBlock.		self refresh].	ancestor ifNil: [aBlock value: 0].	^ancestor! !!O2Fan methodsFor: 'navigation' stamp: 'jk 3/28/2008 13:07'!anyNavigation	^ self parent anyNavigation! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!asEnhancedFan	^ O2EnhancementFan new		setParent: parent			children: children;		yourself! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!asTreeFan	^ O2TreeNodeMediator fan: self! !!O2Fan methodsFor: 'accessing' stamp: 'dr 1/29/2009 10:55'!autoSelection	| auto |	auto := parent ifNotNilDo: [:node | node metaNode autoSelect]. 	^auto ifNotNil: [auto fan: self. auto autoSelection]! !!O2Fan methodsFor: 'accessing' stamp: 'dr 10/31/2008 16:12'!backgroundColorAt: anInteger	^(self children at: anInteger ifAbsent: [^nil]) backgroundColor! !!O2Fan methodsFor: 'accessing' stamp: 'dr 9/17/2008 12:13'!childAt: index	^ self children at: index ifAbsent: [nil]! !!O2Fan methodsFor: 'accessing' stamp: 'cwp 8/16/2007 12:12'!children	^ children ifNil: [#()]! !!O2Fan methodsFor: 'accessing' stamp: 'jk 4/7/2008 10:29'!childrenAt: index	^ self children! !!O2Fan methodsFor: 'column' stamp: 'dr 10/19/2008 10:28'!columnAfter: aColumn selection: anInteger 	^ (self childAt: anInteger) 	       ifNil: [nil] 	       ifNotNilDo: [:node | node columnAfter: aColumn withFan: self selection: anInteger]! !!O2Fan methodsFor: 'selecting' stamp: 'jk 3/23/2008 11:13'!displayStringForChild: aNode	^ self parent displayStringForChild: aNode! !!O2Fan methodsFor: 'selecting' stamp: 'jk 3/23/2008 11:14'!displayStringForChildAt: index	^ self displayStringForChild: (self children at: index ifAbsent: [^''])! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!fan    ^self! !!O2Fan methodsFor: 'accessing' stamp: 'dr 9/17/2008 11:21'!iconAt: index	^ (self children at: index ifAbsent: [^nil]) icon! !!O2Fan methodsFor: 'testing' stamp: 'jk 3/26/2008 12:27'!includesNode: aNode	^ self children includes: aNode! !!O2Fan methodsFor: 'selecting' stamp: 'cwp 8/16/2007 21:50'!indexOf: aNode 	| index |	index := children indexOf: aNode.	index = 0 ifTrue: 		[index := self children indexOf: 			(self children 				detect: [:ea | ea name = aNode name] 				ifNone: [nil])].	^index! !!O2Fan methodsFor: 'testing' stamp: 'jk 3/23/2008 10:55'!isEmpty	^ self parent isNil! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!lastNode    ^nil! !!O2Fan methodsFor: 'selecting' stamp: 'jk 3/23/2008 11:12'!list	^ self children collect: [ :e | self displayStringForChild: e ]! !!O2Fan methodsFor: 'accessing' stamp: 'jk 3/23/2008 11:05'!listSize	^ self children ifNil: [0] ifNotNil: [self children size]! !!O2Fan methodsFor: 'accessing' stamp: 'jk 3/23/2008 11:08'!nodeAt: index	^ self children at: index ifAbsent: []! !!O2Fan methodsFor: 'accessing' stamp: 'dr 9/17/2008 12:05'!nodeForItem: aString	^ self children		detect: [ :child | (self parent displayStringForChild: child) = aString ]		ifNone: [ aString ]! !!O2Fan methodsFor: 'selecting' stamp: 'jk 3/23/2008 11:28'!noteChild: aNode	self parent noteChild: aNode! !!O2Fan methodsFor: 'accessing' stamp: 'cwp 8/16/2007 11:56'!parent	^ parent! !!O2Fan methodsFor: 'accessing' stamp: 'jk 4/7/2008 10:25'!parentAt: index	^ self parent! !!O2Fan methodsFor: 'printing' stamp: 'jk 4/2/2008 12:44'!printOn: aStream	aStream		nextPutAll: 'Fan<'.	self parent name printOn: aStream.	aStream nextPutAll: ', '.	self children size printOn: aStream.	aStream		nextPut: $>! !!O2Fan methodsFor: 'accessing' stamp: 'dr 9/17/2008 11:36'!refresh	| oldChildren |	oldChildren := children.	children := parent defaultChildNodes.	^ children ~= oldChildren! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!removeAutoSelection! !!O2Fan methodsFor: 'navigation' stamp: 'jk 3/28/2008 12:47'!restrictToNavigation: navigation 	children := (self children select: [ :e | e navigation = navigation ])! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!restrictToTreeChildrenAndAdjustSelection: anInteger	| child |	anInteger = 0 ifFalse: [child := self childAt: anInteger].	children := (self children select: [ :e | e isTreeNavigation ]).	^ anInteger = 0 		ifFalse: [self children identityIndexOf: child ifAbsent: [0]]		ifTrue: [0]! !!O2Fan methodsFor: 'initialize-release' stamp: 'jk 4/7/2008 11:30'!setDefaultParent: aNode 	self setParent: aNode children: aNode defaultChildNodes.! !!O2Fan methodsFor: 'initialize-release' stamp: 'dr 9/15/2008 16:21'!setParent: aNode	self setParent: aNode children: aNode childNodes.! !!O2Fan methodsFor: 'initialize-release' stamp: 'dr 9/17/2008 10:55'!setParent: aNode children: aCollection	parent := aNode.	children := aCollection.! !!O2Fan methodsFor: 'accessing' stamp: 'cwp 8/16/2007 21:37'!switchFilter	^ parent metaNode switchFilter! !!O2Fan methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!treeChildren	"Returns children with tree navigation." 	^ self children select: [ :e | e isTreeNavigation ]! !!O2Filter commentStamp: 'cwp 3/4/2004 21:53' prior: 35456499!A browser's metagraph defines the way in which the user may traverse the graph of objects which make up the browser's domain. But it's not always desirable to have all the nodes made available by the metagraph to be visible in the browser. An filter provides a strategy for filtering out some of the nodes from the display. OBFilter provides a "null" filter - one that does no filtering at all - and serves as a superclass for other filters. !!O2ClassHierarchyFilter class methodsFor: 'instance creation' stamp: 'dr 2/25/2008 16:43'!columnPanel: aColumnPanel    ^self new columnPanel: aColumnPanel; yourself! !!O2ClassHierarchyFilter methodsFor: 'accessing' stamp: 'dr 2/25/2008 16:43'!columnPanel: aColumnPanel    columnPanel := aColumnPanel! !!O2ClassHierarchyFilter methodsFor: 'filtering' stamp: 'dr 3/12/2008 14:20'!displayString: aStringOrText forParent: pNode child: cNode	^ columnPanel root theNonMetaClass = cNode theNonMetaClass ifTrue: [aStringOrText asText addAttribute: TextEmphasis bold; yourself] ifFalse: [aStringOrText]! !!O2ClassInheritanceFilter methodsFor: 'filtering' stamp: 'scg 8/24/2009 11:44'!icon: aSymbol forNode: aNode 	| theClass passed failed ratio testMethods |	theClass := aNode theNonMetaClass.	theClass o2BrowserIcon ifNotNilDo: [ :icon | ^ icon ].	testMethods := aNode methods select: [ :ref | ref selector beginsWith: 'test' ].	(((theClass inheritsFrom: TestCase) and: [ testMethods notEmpty ]) and: [ TestCase class includesSelector: #methodProgressed: ]) ifTrue: 		[ passed := theClass methodsPassed.		failed := theClass methodsFailed.		(failed isEmpty and: [ passed isEmpty ]) ifTrue: [ ^ #testNotRun ].		passed size = testMethods size ifTrue: [ ^ #testGreen ].		passed ifEmpty: [ ^ #testRed ].		failed size = 0 			ifTrue: [ ratio := 1 ]			ifFalse: [ ratio := passed size / failed size ].		^ ratio > 0.6 			ifTrue: [ #testMorePassed ]			ifFalse: 				[ ratio < 0.4 					ifTrue: [ #testMoreFailed ]					ifFalse: [ #testEqualPassedFailed ] ] ].	(theClass inheritsFrom: Exception) ifTrue: [ ^ #exception ].	^ #blank! !!O2ClassSortFilter methodsFor: 'private' stamp: 'dr 9/23/2008 17:14'!buildIndentIndex	indents := "Identity"Dictionary new.	order do: [:assoc | indents at: assoc value put: assoc key size - 1].! !!O2ClassSortFilter methodsFor: 'private' stamp: 'dr 10/23/2008 10:51'!buildIndentIndexFor: sortedNodes	indents := "Identity"Dictionary new.	sortedNodes do: [:node | indents at: node put: node theNonMetaClass allSuperclasses size].! !!O2ClassSortFilter methodsFor: 'private' stamp: 'cwp 5/20/2007 02:20'!collectSortedNodes	^order asArray collect: [:assoc | assoc value]! !!O2ClassSortFilter methodsFor: 'filtering' stamp: 'dr 9/17/2008 14:02'!displayString: aStringOrText forParent: pNode child: cNode    | count indented |     count := (indents at: cNode ifAbsent: [^ aStringOrText]) * 2.    indented := String new: count + aStringOrText size.    1 to: count do: [:i | indented at: i put: $ ].    indented replaceFrom: count + 1 to: indented size with: aStringOrText.    aStringOrText isText ifTrue: [        aStringOrText setString: indented setRuns: aStringOrText runs.        ^aStringOrText    ].    ^indented ! !!O2ClassSortFilter methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!indents    ^indents! !!O2ClassSortFilter methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!initialize    super initialize.    indents := Dictionary new.! !!O2ClassSortFilter methodsFor: 'private' stamp: 'cwp 5/20/2007 02:20'!initializeResults	| i chain2 chain1 result max |	order := SortedCollection sortBlock: 					[:assoc1 :assoc2 | 					result := nil.					chain1 := assoc1 key.					chain2 := assoc2 key.					max := chain1 size min: chain2 size.					i := 1.					[result isNil and: [i <= max]] whileTrue: 							[(chain1 at: i) = (chain2 at: i) 								ifTrue: [i := i + 1]								ifFalse: [result := (chain1 at: i) name < (chain2 at: i) name]].					result isNil ifTrue: [chain1 size < chain2 size] ifFalse: [result]]! !!O2ClassSortFilter methodsFor: 'filtering' stamp: 'DavidRoethlisberger 10/18/2009 15:36'!nodesFrom: nodes forNode: parent 	"Sort nodes according to their position in the class hierarchy"	| classes classNodes sortedNodes classInCenter supersChain |	classNodes := nodes select: [ :ea | ea respondsTo: #theClass ].	classNodes ifEmpty: [ ^ nodes ].	classes := (classNodes collect: [ :classNode | classNode theClass ]) asOrderedCollection.		((parent name beginsWith: 'Kernel') not and: 		[ nodes anySatisfy: 			[ :ea | 			(ea respondsTo: #theClass) and: [ ea theClass = ProtoObject and: [ ea isPackage not ] ] ] ]) ifTrue: 		[ classInCenter := (parent isKindOf: O2ClassNode) 			ifTrue: [ parent ]			ifFalse: [ ProtoObject asO2Node ].		sortedNodes := (classInCenter surroundingHierarchy collect: 			[ :class | 			nodes 				at: (nodes findFirst: [ :node | node theClass = class ])				ifAbsent: [ nil ] ]) select: [ :e | e notNil ].		self buildIndentIndexFor: sortedNodes.		^ sortedNodes ].	self initializeResults.	classNodes do: 		[ :classNode | 		supersChain := classNode theClass withAllSuperclasses reversed.		supersChain removeAllSuchThat: [ :cl | (classes includes: cl) not ].		order add: supersChain contents -> classNode ].	self buildIndentIndex.	^ self collectSortedNodes! !!O2QueryingClassSortFilter methodsFor: 'filtering' stamp: 'dr 9/25/2008 11:12'!displayString: aStringOrText forParent: pNode child: cNode   (pNode isSmartAlias and: [pNode node isSearch and: [pNode node isFrequencySearch]]) ifFalse: [       ^super displayString: aStringOrText forParent: pNode child: cNode.   ].   ^aStringOrText! !!O2QueryingClassSortFilter methodsFor: 'filtering' stamp: 'dr 12/10/2008 10:40'!icon: aSymbol forNode: aNode 	aNode isDummy ifTrue: [^#blank].	aNode moreRecentOnServer ifTrue: [^#moreRecentOnServer]. 	^aNode modified ifTrue: [#dirtyPackage] 	                    ifFalse: [#package]! !!O2QueryingClassSortFilter methodsFor: 'filtering' stamp: 'dr 10/23/2008 10:25'!nodesFrom: nodes forNode: pNode    (pNode isSmartAlias and: [pNode node isSearch and: [pNode node isFrequencySearch]]) ifFalse: [       ^super nodesFrom: nodes forNode: pNode.   ].   ^nodes! !!O2Filter methodsFor: 'user interface' stamp: 'cwp 10/24/2006 10:18'!buildOn: aBuilder	! !!O2Filter methodsFor: 'filtering' stamp: 'cwp 5/20/2007 01:56'!displayString: aString forNode: aNode	^ aString! !!O2Filter methodsFor: 'filtering' stamp: 'cwp 5/20/2007 20:05'!displayString: aString forParent: pNode child: cNode	^ aString! !!O2Filter methodsFor: 'filtering' stamp: 'cwp 5/6/2007 01:53'!edgesFrom: aCollection forNode: aNode	^ aCollection! !!O2Filter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:08'!icon: aSymbol forNode: aNode	^ aSymbol! !!O2Filter methodsFor: 'callbacks' stamp: 'dr 3/23/2009 15:39'!longDescriptionsForNode: aNode	^#()! !!O2Filter methodsFor: 'accessing' stamp: 'cwp 2/11/2004 23:48'!metaNode	^ metaNode! !!O2Filter methodsFor: 'filtering' stamp: 'cwp 5/6/2007 01:53'!nodesFrom: aCollection forNode: aNode	^ aCollection! !!O2Filter methodsFor: 'filtering' stamp: 'cwp 5/8/2007 00:10'!noteParent: pNode child: cNode! !!O2Filter methodsFor: 'initalizing' stamp: 'DamienCassou 12/23/2009 16:36'!setMetaNode: aMetaNode	metaNode := aMetaNode! !!O2Filter methodsFor: 'testing' stamp: 'cwp 2/9/2004 21:06'!wantsButton	^ false! !!O2Filter methodsFor: 'testing' stamp: 'cwp 5/17/2007 23:07'!wantsSwitch	^ false! !!O2EnhancementInheritanceFilter methodsFor: 'filtering' stamp: 'TestRunner 11/10/2009 23:50'!icon: aSymbol forNode: aNode 	| method |	method := aNode theClass lookupSelector: aNode selector.	method ifNil: [ ^ #blank ].	"icons for test methods"	((aNode theClass inheritsFrom: TestCase) and: 		[ (aNode theClass allTestSelectors includes: aNode selector) and: [aNode selector isUnary and: [ TestCase class includesSelector: #methodProgressed: ]]]) ifTrue: 		[ (aNode theClass hasMethodBeenRun: aNode selector) ifFalse: [ ^ #testNotRun ].		(aNode theClass methodProgressed: aNode selector) ifTrue: [ ^ #arrowUp ].		(aNode theClass methodRegressed: aNode selector) ifTrue: [ ^ #abstractWithOverride ].		(aNode theClass methodPassed: aNode selector) ifTrue: [ ^ #testGreen ].		(aNode theClass methodFailed: aNode selector) ifTrue: [ ^ #testYellow ].		(aNode theClass methodRaisedError: aNode selector) ifTrue: [ ^ #testRed ].			^ #blank ].	method class = CompiledMethod ifFalse: [ method := method compiledMethod ].	method isSubclassResponsibility ifTrue: 		[ ^ aNode isOverridden 			ifTrue: [ #abstractWithOverride ]			ifFalse: [ #abstractWithoutOverride ] ].	method sendsToSuper ifTrue: 		[ | icon | 		   	icon := aNode isOverridden 			 	ifTrue: ['superSendWithOverride']			 	ifFalse: ['superSendWithoutOverride'].			icon := (method sendsSelector: aNode selector) 				ifFalse: [icon, 'OtherSelector'] 				ifTrue: [aNode isOverride ifFalse: [icon, 'NoSuperMethod'] ifTrue: [icon]].			^icon asSymbol				 ].	method literals do: 		[ :literal | 		(#(#halt #haltIfNil #haltIf: #haltOnce) includes: literal) ifTrue: [ ^ #breakpoint ]. 		(#(#flag: #needsWork) includes: literal) ifTrue: [ ^ #needsWork ] ].	^ aNode isOverride 		ifTrue: 			[ aNode isOverridden 				ifTrue: [ #overriddenAndOverrides ]				ifFalse: [ #overrides ] ]		ifFalse: 			[ aNode isOverridden 				ifTrue: [ #overridden ]				ifFalse: [ #blank ] ]! !!O2InheritanceFilter methodsFor: 'filtering' stamp: 'dr 11/20/2008 09:33'!icon: aSymbol forNode: aNode 	| method |	method := aNode theClass lookupSelector: aNode selector.	method ifNil: [ ^ #blank ].	method literals do: 		[ :literal | 		(literal == #halt or: 			[ literal == #haltIfNil or: [ literal == #haltIf: or: [ literal == #haltOnce ] ] ]) ifTrue: [ ^ #breakpoint ].		(literal == #flag: or: [ literal == #needsWork ]) ifTrue: [ ^ #needsWork ] ].	^ aNode isOverride 		ifTrue: 			[ aNode isOverridden 				ifTrue: [ #overriddenAndOverrides ]				ifFalse: [ #overrides ] ]		ifFalse: 			[ aNode isOverridden 				ifTrue: [ #overridden ]				ifFalse: [ #blank ] ]! !!O2LimitProtocolFilter class methodsFor: 'instance creation' stamp: 'DM 5/23/2007 14:37'!on: aClass	^ self new forClass: aClass.! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'PDC 6/28/2007 07:37'!defaultLimitClass	"it's too bad that this needs to be duplicated between the ProtocolBrowser and here'"	^ (theClass = theClass theMetaClass)		ifTrue: [Object class]		ifFalse: [Object]! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'scg 8/24/2009 10:45'!displayString: aString forNode: aNode 	(aNode isKindOf: O2MethodNode) ifFalse: [ ^ aString ].	^ aNode theClass = theClass 		ifTrue: [ aString asText addAttribute: TextEmphasis bold ]		ifFalse: [ aString ]! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'DM 5/23/2007 01:42'!filterMethods: methods onClasses: allClasses forNode: aNode	^ methods		select: [:m | allClasses anySatisfy: [:c | c includesSelector: m selector]]! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'DM 5/23/2007 01:44'!filterProtocols: protocols onClasses: allClasses forNode: aNode 	^ protocols allButFirst "the first is the synthetic --all-- category"		select: [:p | allClasses anySatisfy: [:c | c organization categories includes: p name]]! !!O2LimitProtocolFilter methodsFor: 'updating' stamp: 'DM 5/23/2007 14:37'!forClass: aClass	theClass := aClass! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'DM 5/23/2007 01:17'!limitClass: aClass	limitClass := aClass.! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'DM 5/23/2007 01:36'!limitClassFor: aNode 	^ limitClass ifNil: [self defaultLimitClass ] ifNotNil: [limitClass]! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'scg 8/24/2009 10:45'!nodesFrom: nodes forNode: aNode 	| allClasses limit |	nodes ifEmpty: [ ^ nodes ].	limit := self limitClassFor: aNode.	allClasses := aNode theClass withAllSuperclasses copyUpTo: limit.	allClasses add: limit.	^ (nodes first isKindOf: O2MethodCategoryNode) 		ifTrue: 			[ self 				filterProtocols: nodes				onClasses: allClasses				forNode: aNode ]		ifFalse: 			[ self 				filterMethods: nodes				onClasses: allClasses				forNode: aNode ]! !!O2LimitProtocolFilter methodsFor: 'filtering' stamp: 'DM 5/23/2007 14:35'!setMetaNode: aMetaNode	super setMetaNode: aMetaNode.	aMetaNode children do: [ :each |		(each filters includes: self)			ifFalse: [ each addFilter: self ] ].! !!O2MethodCategoryFilter methodsFor: 'filtering' stamp: 'dr 11/24/2008 15:45'!displayString: aStringOrText forParent: pNode child: cNode    | category |    ((cNode reference actualClass includesSelector: cNode reference methodSymbol)         and: [cNode reference compiledMethod literals includes: #deprecated:])           ifTrue: [^aStringOrText asText addAttribute: TextEmphasis struckOut].    category := cNode category.    (category beginsWith: '*') ifTrue: [	    ^(category includesSubString: '-overrides') 	        ifTrue: [aStringOrText asText addAttribute: TextEmphasis italic; addAttribute: TextColor red]		        ifFalse: [aStringOrText asText addAttribute: TextEmphasis italic]].    ^aStringOrText ! !!O2MethodCategoryFilter methodsFor: 'filtering' stamp: 'damiencassou 4/17/2009 15:37'!icon: aSymbol forNode: aNode 	| theClass methodReferences |	theClass := aNode theNonMetaClass.	methodReferences := aNode methodReferences.		((theClass inheritsFrom: TestCase) and: [TestCase class includesSelector: #methodProgressed:]) ifTrue: [		(methodReferences anySatisfy: [:ref | ref methodSymbol beginsWith: 'test']) ifTrue: [ | passed failed  ratio |			passed := theClass methodsPassed reject: [:symbol | methodReferences noneSatisfy: [:ref | ref methodSymbol = symbol]].			failed := theClass methodsFailed reject: [:symbol | methodReferences noneSatisfy: [:ref | ref methodSymbol = symbol]].			(failed isEmpty and: [passed isEmpty]) ifTrue: [^ #testNotRun].			failed ifEmpty: [^ #testGreen].			passed ifEmpty: [^ #testRed].					ratio := passed size / failed size.			^ratio > 1.2 ifTrue: [#testMorePassed] ifFalse: [ratio < 0.8 ifTrue: [#testMoreFailed] ifFalse: [#testEqualPassedFailed]].					] ifFalse: [^#blank]].	(Smalltalk hasClassNamed: #HODataBase) ifFalse: [^ nil].	^ (methodReferences anySatisfy:		[ :methodRef | 		(Smalltalk at: #HODataBase) default isInstrumentedMethod: methodRef ]) 		ifTrue: [ #flag ]		ifFalse: [ #blank ]! !!O2ModalFilter commentStamp: 'cwp 1/7/2005 23:39' prior: 35457005!OBModalFilter is used to implement the 'instance/?/class' buttons in a standard class browser. In functional terms it filters the nodes of a column according to the edge of the metagraph that they correspond to. OBModalFilter displays an OBRadioButtonBar in its column's pane, with one button per edge. Only nodes from the currently selected edge are allowed in the column.iVars:selection	- the currently selected edge!!O2ModalFilter methodsFor: 'callbacks' stamp: 'cwp 5/17/2007 22:57'!activate	! !!O2ModalFilter methodsFor: 'filtering' stamp: 'dr 9/15/2008 15:17'!edgesFrom: aCollection forNode: aNode  	^ Array with: (aCollection at: self selection)! !!O2ModalFilter methodsFor: 'callbacks' stamp: 'dr 7/7/2009 14:10'!isDropEdge: aString	| edge |	edge := 	metaNode defaultEdges detect: [:e | e label = aString] ifNone: [nil].	edge ifNotNil: [^edge isDropEdge].	^false! !!O2ModalFilter methodsFor: 'callbacks' stamp: 'dr 9/15/2008 15:18'!list	^ metaNode defaultEdges collect: [:edge | edge label]! !!O2ModalFilter methodsFor: 'callbacks' stamp: 'cwp 7/14/2007 10:32'!listForNode: aNode	^ self list! !!O2ModalFilter methodsFor: 'filtering' stamp: 'lr 11/13/2008 13:38'!noteParent: pNode child: cNode 	pNode metaNode defaultEdges keysAndValuesDo: 		[ :index :edge | 		cNode metaNode = edge metaNode ifTrue: [ selection := index ] ]! !!O2ModalFilter methodsFor: 'callbacks' stamp: 'DamienCassou 12/23/2009 16:36'!selection	^ selection ifNil: [selection := 1]! !!O2ModalFilter methodsFor: 'callbacks' stamp: 'dr 10/19/2008 10:47'!selection: anInteger	selection := anInteger.	self changed: #selection.	! !!O2ModalFilter methodsFor: 'queries' stamp: 'cwp 2/9/2004 21:08'!wantsButton	^ true! !!O2ModalFilter methodsFor: 'testing' stamp: 'cwp 5/17/2007 23:07'!wantsSwitch	^ true! !!O2PluggableFilter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:05'!displayString: aString forNode: aNode	^ nodeDisplay 		ifNil: [super displayString: aString forNode: aNode]		ifNotNil: [nodeDisplay value: aString value: aNode]! !!O2PluggableFilter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:06'!displayString: aString forParent: pNode child: cNode	^ parentDisplay		ifNil: [super displayString: aString forParent: pNode child: cNode]		ifNotNil: [parentDisplay value: aString value: pNode value: cNode]! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 01:02'!edges	^ edges! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 01:02'!edges: anObject	edges := anObject! !!O2PluggableFilter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:06'!edgesFrom: aCollection forNode: aNode	^ edges 		ifNil: [super edgesFrom: aCollection forNode: aNode]		ifNotNil: [edges value: aCollection value: aNode]! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:58'!icon	^ icon! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!icon: aBlock	icon := aBlock! !!O2PluggableFilter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:07'!icon: aSymbol forNode: aNode	^ icon		ifNil: [super icon: aSymbol forNode: aNode]		ifNotNil: [icon value: aSymbol value: aNode]! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:41'!nodeDisplay	^nodeDisplay! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:41'!nodeDisplay: anObject	nodeDisplay := anObject! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:41'!nodes	^nodes! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:41'!nodes: anObject	nodes := anObject! !!O2PluggableFilter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:07'!nodesFrom: aCollection forNode: aNode	^ nodes 		ifNil: [super nodesFrom: aCollection forNode: aNode]		ifNotNil: [nodes value: aCollection value: aNode]! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:48'!note	^ note! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!note: aBlock	note := aBlock! !!O2PluggableFilter methodsFor: 'filtering' stamp: 'cwp 7/23/2007 01:08'!noteParent: pNode child: cNode	^ note 		ifNil: [super noteParent: pNode child: cNode]		ifNotNil: [note value: pNode value: cNode]! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:41'!parentDisplay	^parentDisplay! !!O2PluggableFilter methodsFor: 'accessing' stamp: 'cwp 7/23/2007 00:41'!parentDisplay: anObject	parentDisplay := anObject! !!O2RescueFilter methodsFor: 'filtering' stamp: 'DamienCassou 12/23/2009 16:36'!cache: aCollection for: aNode	| cached missing inclusionSet |	cached := cache at: aNode ifAbsent: [^ self initCache: aCollection for: aNode].	cache at: aNode put: aCollection.	missing := rescued at: aNode ifAbsent: [Set new].	inclusionSet := aCollection asSet.	missing removeAllSuchThat: [:ea | inclusionSet includes: ea].	cached do: [:ea | (inclusionSet includes: ea) ifFalse: [missing add: ea]].	missing isEmpty ifFalse: [rescued at: aNode put: missing].	^ missing asArray! !!O2RescueFilter methodsFor: 'filtering' stamp: 'cwp 7/17/2007 02:20'!displayString: aString forParent: pNode child: cNode	^ ((rescued at: pNode ifAbsent: [#()]) includes: cNode)		ifTrue: [aString asText addAttribute: TextEmphasis struckOut]		ifFalse: [aString]! !!O2RescueFilter methodsFor: 'filtering' stamp: 'cwp 7/19/2007 01:06'!initCache: aCollection for: aNode	cache at: aNode put: aCollection.	^ #()! !!O2RescueFilter methodsFor: 'private' stamp: 'DamienCassou 12/23/2009 16:36'!initialize	cache := Dictionary new.	rescued := Dictionary new.! !!O2RescueFilter methodsFor: 'filtering' stamp: 'cwp 7/17/2007 01:58'!nodesFrom: aCollection forNode: aNode	^ aCollection, (self cache: aCollection for: aNode)! !!O2RescueFilter methodsFor: 'private' stamp: 'DamienCassou 12/23/2009 16:36'!rescue: aCollection for: aNode	| previous |	previous := rescued at: aNode ifAbsent: [#()].	^ rescued at: aNode put: previous, aCollection.! !!O2SearchQueryFilter class methodsFor: 'instance creation' stamp: 'dr 5/14/2008 14:24'!on: aSearchNode    ^self new setSearchNode: aSearchNode! !!O2SearchQueryFilter methodsFor: 'filtering' stamp: 'dr 5/14/2008 16:19'!displayString: aString forNode: aNode     (searchNode methodSatisfiesQuery: aNode reference) ifTrue: [^aString asText addAttribute: TextColor red].     ^aString! !!O2SearchQueryFilter methodsFor: 'accessing' stamp: 'dr 5/14/2008 14:24'!setSearchNode: aSearchNode    searchNode := aSearchNode! !!O2TraitConflictMethodFilter methodsFor: 'filtering' stamp: 'jk 8/29/2007 11:41'!displayString: aString forNode: aNode	^ aNode isConflict 		ifTrue: [aString asText addAttribute: TextColor red] 		ifFalse: [aString]! !!O2TraitRequiredMethodFilter methodsFor: 'filtering' stamp: 'jk 8/30/2007 10:36'!displayString: aString forNode: aNode	^ aNode isRequired 		ifTrue: [aString asText addAttribute: TextColor blue] 		ifFalse: [aString]! !!O2TraitSortFilter methodsFor: 'filtering' stamp: 'jk 8/20/2007 15:37'!displayString: aString forParent: pNode child: cNode	^ (String new: cNode numberOfPredecessors withAll: $ ), aString! !!OR2EnvironmentFilter class methodsFor: 'instance-creation' stamp: 'lr 2/9/2008 12:42'!on: anEnvironment	^ self new setEnvironment: anEnvironment! !!OR2EnvironmentFilter methodsFor: 'accessing' stamp: 'lr 2/9/2008 11:25'!environment	^ environment! !!OR2EnvironmentFilter methodsFor: 'initalizing' stamp: 'lr 2/9/2008 12:42'!setEnvironment: anEnvironment	environment := anEnvironment! !!OR2HideEnvironmentFilter methodsFor: 'filtering' stamp: 'lr 2/9/2008 12:24'!nodesFrom: aCollection forNode: aNode	^ aCollection select: [ :each | each withinBrowserEnvironment: environment ]! !!OR2HightlightEnvironmentFilter methodsFor: 'filtering' stamp: 'lr 10/13/2008 10:40'!displayString: aString forParent: aParentNode child: aNode	^ (aNode withinBrowserEnvironment: environment)		ifFalse: [ aString asText addAttribute: TextEmphasis italic ]		ifTrue: [ aString ]! !!OR2LintResultFilter methodsFor: 'filtering' stamp: 'lr 10/22/2008 13:59'!displayString: aString forNode: aNode	| problemCount |	problemCount := aNode problemCount.	problemCount = 0 ifTrue: [ ^ aString ].	^ (aString , ' (' , problemCount asString , ')')		asText addAttribute: TextEmphasis bold! !!OR2SortingFilter methodsFor: 'filtering' stamp: 'lr 2/9/2008 17:26'!nodesFrom: nodes forNode: parent	^ nodes asSortedCollection: [ :a :b | a name < b name ]! !!O2List class methodsFor: 'instance creation' stamp: 'dr 9/12/2008 10:40'!column: aFan    ^self new column: aFan! !!O2List class methodsFor: 'instance creation' stamp: 'dr 9/12/2008 10:34'!fan: aFan    ^self new fan: aFan! !!O2List methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!at: anInteger putFan: aFan	self fan		at: self treeSelection		putFan: aFan.	self extendTreeSelection: anInteger.! !!O2List methodsFor: 'nodes' stamp: 'dr 5/8/2009 14:51'!autoSelection	^ self fan autoSelection! !!O2List methodsFor: 'accessing' stamp: 'dr 5/4/2009 15:39'!backgroundColorAt: anInteger	^self fan backgroundColorAt: anInteger ! !!O2List methodsFor: 'nodes' stamp: 'jk 4/7/2008 10:30'!children	^ self fan childrenAt: self selection! !!O2List methodsFor: 'selecting' stamp: 'jk 3/23/2008 10:45'!clearAll	self clearFan.	self clearSelection! !!O2List methodsFor: 'nodes' stamp: 'jk 3/22/2008 22:39'!clearFan	self fan: nil! !!O2List methodsFor: 'selecting' stamp: 'jk 3/22/2008 21:04'!clearSelection	self position clearSelection! !!O2List methodsFor: 'accessing' stamp: 'dr 9/12/2008 10:40'!column: aColumn	column := aColumn! !!O2List methodsFor: 'selecting' stamp: 'scg 8/24/2009 10:45'!defaultPosition	^ position class = O2Position 		ifTrue: [ position ]		ifFalse: [ position := O2Position new index: 1 ]! !!O2List methodsFor: 'nodes' stamp: 'jk 3/23/2008 11:14'!displayStringForChild: aNode	^ self fan displayStringForChild: aNode! !!O2List methodsFor: 'nodes' stamp: 'jk 3/23/2008 11:13'!displayStringForChildAt: index	^ self fan displayStringForChildAt: index! !!O2List methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!extendTreeSelection: anInteger 	self position extendSelection: anInteger! !!O2List methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!fan	^ fan ifNil: 		[ fan := (Smalltalk hasClassNamed: #O2EnhancementFan) 			ifTrue: [ (Smalltalk at: #O2EnhancementFan) new ]			ifFalse: [ O2Fan new ] ]! !!O2List methodsFor: 'accessing' stamp: 'dr 9/17/2008 10:24'!fan: anObject	fan := anObject! !!O2List methodsFor: 'selecting' stamp: 'dr 12/15/2008 18:48'!fan: aFan selection: index	self fan: aFan.	self selection: index! !!O2List methodsFor: 'testing' stamp: 'jk 4/6/2008 18:44'!hasSelection	^ self position hasSelection! !!O2List methodsFor: 'accessing' stamp: 'jk 3/23/2008 10:19'!iconAt: index	^ self fan iconAt: index! !!O2List methodsFor: 'nodes' stamp: 'dr 11/12/2008 10:14'!includes: aNode	^ self fan includes: aNode ! !!O2List methodsFor: 'nodes - testing' stamp: 'jk 3/22/2008 22:17'!includesNode: aNode	^ self fan includesNode: aNode! !!O2List methodsFor: 'nodes' stamp: 'jk 3/23/2008 10:17'!indexOf: aNode	^ self fan indexOf: aNode! !!O2List methodsFor: 'nodes' stamp: 'jk 3/22/2008 22:25'!isEmpty	^ self fan isEmpty! !!O2List methodsFor: 'nodes' stamp: 'dr 9/12/2008 10:42'!list	^self fan list! !!O2List methodsFor: 'nodes' stamp: 'jk 3/22/2008 22:40'!listSize	^ self fan listSize! !!O2List methodsFor: 'nodes' stamp: 'jk 3/22/2008 22:18'!nodeForItem: aString	^ self fan nodeForItem: aString! !!O2List methodsFor: 'nodes' stamp: 'jk 3/22/2008 22:23'!noteChild: aNode	self fan noteChild: aNode! !!O2List methodsFor: 'nodes' stamp: 'jk 4/7/2008 10:26'!parent	^ self fan parentAt: self selection! !!O2List methodsFor: 'nodes' stamp: 'dr 9/18/2008 16:14'!parent: aNode	aNode ifNotNil: [self fan setDefaultParent: aNode]! !!O2List methodsFor: 'accessing' stamp: 'dr 3/4/2009 15:43'!position	^ position ifNil: [ position := self defaultPosition ]! !!O2List methodsFor: 'accessing' stamp: 'jk 3/22/2008 20:37'!position: anObject	position := anObject! !!O2List methodsFor: 'nodes - testing' stamp: 'jk 3/23/2008 11:26'!refresh	^ self fan refresh! !!O2List methodsFor: 'selecting' stamp: 'jk 3/23/2008 11:03'!select: aNode	self selection: (self fan indexOf: aNode)! !!O2List methodsFor: 'selecting' stamp: 'jk 3/23/2008 11:07'!selectSilently: aNode	self selection: (self fan indexOf: aNode)! !!O2List methodsFor: 'nodes' stamp: 'jk 4/4/2008 08:57'!selectedNode	^ self fan nodeAt: self selection! !!O2List methodsFor: 'selecting' stamp: 'dr 3/4/2009 15:44'!selection	^ self position selection! !!O2List methodsFor: 'selecting' stamp: 'jk 4/7/2008 12:35'!selection: anInteger	^ self defaultPosition selection: anInteger! !!O2List methodsFor: 'nodes' stamp: 'jk 3/22/2008 22:24'!switchFilter	^ self fan switchFilter! !!O2List methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!treeSelection	^ self position treeSelection! !!O2MercuryQuery commentStamp: 'PDC 6/29/2007 07:08' prior: 35457491!OBMercuryQuery is an abstract superclass for queries made through the 'Mercury' panel in OmniBrowser based browser. The main interface is the class method, find:for:, which builds an appropriate concrete query object for the query string and calls find on it.!!O2EnhancementMercuryQuery class methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!selectClassForQuery: rawQuery 	^ rawQuery first = $# 		ifTrue: 			[ rawQuery allButFirst first isUppercase 				ifTrue: [ O2EnhancementMClassRefsQuery ]				ifFalse: [ O2EnhancementMMethodSendersQuery ] ]		ifFalse: 			[ (self isClassQuery: rawQuery) 				ifTrue: [ O2EnhancementMClassQuery ]				ifFalse: [ O2EnhancementMMethodQuery ] ]! !!O2EnhancementMercuryQuery methodsFor: 'accessing' stamp: 'dr 4/25/2008 15:16'!keyWord    ^self searchNodeClass keyWord! !!O2EnhancementMercuryQuery methodsFor: 'actions' stamp: 'dr 4/21/2008 11:00'!openSearchBrowser	^ self openSearchInSameBrowserOn: self searchNode! !!O2EnhancementMercuryQuery methodsFor: 'initialization' stamp: 'dr 4/25/2008 15:32'!setRawQuery: aString    ^aString copyFrom: self keyWord size + 1 to: aString size! !!O2MClassQuery commentStamp: 'PDC 6/29/2007 07:11' prior: 35457813!I handle mercury queries like 'Object' and 'OBNode*'. I find classes.!!O2EnhancementMClassQuery methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!openClassBrowser	| classNode |	classNode := (Smalltalk hasClassNamed: pattern first) 		ifTrue: [ O2ClassNode on: (Smalltalk at: pattern first asSymbol) ]		ifFalse: [ self searchNode classes first ].	^ self browser isClassBrowser 		ifTrue: [ self browser jumpTo: classNode ]		ifFalse: [ classNode browse ]! !!O2MClassQuery methodsFor: 'private' stamp: 'cb 7/16/2008 11:55'!find	((isWild not and: [pattern size = 1 and: [(Smalltalk hasClassNamed: pattern first)]]) or: [self searchNode classes size = 1])		ifTrue: [self openClassBrowser]		ifFalse: [self openSearchBrowser]! !!O2MClassQuery methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!openClassBrowser	| classNode |	classNode := O2ClassNode on: (Smalltalk at: pattern first asSymbol).	^ self browser isClassBrowser 		ifTrue: [ self browser jumpTo: classNode ]		ifFalse: [ classNode browse ]! !!O2MClassQuery methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!openSearchBrowserOn: searchNode 	^ (browser isKindOf: O2PackageBrowser) 		ifTrue: [ self openSearchInSameBrowserOn: searchNode ]		ifFalse: [ super openSearchBrowserOn: searchNode ]! !!O2MClassQuery methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!searchNode	^ O2ClassSearchNode on: pattern! !!O2MClassQuery methodsFor: 'as yet unclassified' stamp: 'cb 7/16/2008 12:05'!setRawQuery: aString panel: aPanel	pattern := aString findTokens: #*.	isWild := aString includes: $*.	browser := aPanel browser.	^ self! !!O2MClassRefsQuery commentStamp: 'PDC 6/29/2007 07:13' prior: 35457949!I handle mercury queries like '#Object'. I find references to classes.!!O2EnhancementMClassRefsQuery methodsFor: 'executing' stamp: 'dr 7/3/2008 11:15'!find	self searchNode hasOnlyOneResult		ifTrue: [self browser jumpTo: self searchNode methodsInFirstClass first]		ifFalse: [self openSearchInSameBrowserOn: self searchNode]! !!O2MClassRefsQuery methodsFor: 'executing' stamp: 'PDC 6/29/2007 06:18'!find	(Smalltalk classNamed: pattern) 		ifNotNil: [self openSearchBrowser]! !!O2MClassRefsQuery methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!openSearchBrowserOn: searchNode 	^ self openSearchInSameBrowserOn: searchNode ! !!O2MClassRefsQuery methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!searchNode	^ O2ClassRefSearchNode on: pattern! !!O2MMethodQuery commentStamp: 'PDC 6/29/2007 07:12' prior: 35458083!I handle queries that look like 'browse' and 'browse*'. I find method implementors.!!O2EnhancementMMethodQuery methodsFor: 'executing' stamp: 'DavidRoethlisberger 10/17/2009 12:13'!find	self searchNode hasOnlyOneResult		ifTrue: [self browser jumpTo: self searchNode methodsInFirstClass first]		ifFalse: [self openSearchInSameBrowserOn: self searchNode] ! !!O2EnhancementMMethodQuery methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!searchNode	^ O2EnhancementMethodSearchNode 		on: pattern		isWild: isWild! !!O2MMethodQuery methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!browseImplementors	| node |	node := O2SelectorNode on: pattern asSymbol.	(browser announce: (O2ShowImplementors of: node)) execute! !!O2MMethodQuery methodsFor: 'executing' stamp: 'PDC 6/29/2007 06:23'!find	isWild ifTrue: [self findMethod] ifFalse: [self browseImplementors]! !!O2MMethodQuery methodsFor: 'private' stamp: 'PDC 6/29/2007 06:28'!findMethod	self openSearchBrowser! !!O2MMethodQuery methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!searchNode	^ O2MethodSearchNode on: pattern! !!O2MMethodSendersQuery commentStamp: 'PDC 6/29/2007 07:13' prior: 35458237!I handle queries like '#browse'. I find method senders.!!O2EnhancementMMethodSendersQuery methodsFor: 'executing' stamp: 'dr 7/3/2008 11:03'!find	self searchNode hasOnlyOneResult		ifTrue: [self browser jumpTo: self searchNode methodsInFirstClass first]		ifFalse: [self openSearchInSameBrowserOn: self searchNode]! !!O2MMethodSendersQuery methodsFor: 'executing' stamp: 'scg 8/24/2009 10:45'!find	| node |	node := O2SelectorNode on: pattern asSymbol.	(browser announce: (O2ShowSenders of: node)) execute! !!O2MMethodSendersQuery methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!searchNode	^ O2SenderSearchNode on: pattern! !!O2MStringQuery commentStamp: 'PDC 6/29/2007 07:13' prior: 35458356!I handle queries that look like "'this is a string'". I find strings in methods.!!O2MStringQuery methodsFor: 'executing' stamp: 'PDC 6/29/2007 05:52'!find	self systemNavigation browseMethodsWithString: pattern.! !!O2MercuryQuery class methodsFor: 'finding' stamp: 'PDC 6/29/2007 06:44'!find: aText for: aPanel	(self from: aText panel: aPanel) find! !!O2MercuryQuery class methodsFor: 'instance creation' stamp: 'scg 8/24/2009 10:45'!from: aString 	| rawQuery |	rawQuery := aString asString withBlanksTrimmed.	rawQuery first = $' ifTrue: [ ^ O2MStringQuery new setRawQuery: rawQuery ].	^ (self selectClassForQuery: rawQuery) new setRawQuery: rawQuery! !!O2MercuryQuery class methodsFor: 'instance creation' stamp: 'scg 8/24/2009 10:45'!from: aString panel: aPanel 	| rawQuery |	rawQuery := aString asString withBlanksTrimmed.	rawQuery first = $' ifTrue: [ ^ O2MStringQuery new setRawQuery: rawQuery ].	^ (self selectClassForQuery: rawQuery) new 		setRawQuery: rawQuery		panel: aPanel! !!O2MercuryQuery class methodsFor: 'documentation' stamp: 'cb 7/19/2007 21:14'!helpMessage	^'Mercury syntaxFoo (browse class Foo)Foo*Bar* (find classes with partial name)#Foo (refs to class Foo)foo (implementors of foo)foo* (implementors of methods starting with foo)#foo (senders of foo)''foo'' (find methods containing this string)'! !!O2MercuryQuery class methodsFor: 'private' stamp: 'lr 11/13/2008 13:44'!isClassQuery: aString 	^ (aString first = $* and: [ aString size > 1 and: [ aString second ~= $* ] ]) or: [ (aString allButLast indexOf: $*) > 1 or: [ aString first isUppercase ] ]! !!O2MercuryQuery class methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!selectClassForQuery: rawQuery 	^ rawQuery first = $# 		ifTrue: 			[ rawQuery allButFirst first isUppercase 				ifTrue: [ O2MClassRefsQuery ]				ifFalse: [ O2MMethodSendersQuery ] ]		ifFalse: 			[ (self isClassQuery: rawQuery) 				ifTrue: [ O2MClassQuery ]				ifFalse: [ O2MMethodQuery ] ]! !!O2MercuryQuery methodsFor: 'executing' stamp: 'cwp 7/20/2007 00:24'!announce: anAnnouncement	^ browser announce: anAnnouncement! !!O2MercuryQuery methodsFor: 'accessing' stamp: 'PDC 6/29/2007 06:04'!browser	^browser! !!O2MercuryQuery methodsFor: 'executing' stamp: 'PDC 6/29/2007 06:32'!find	self subclassResponsibility ! !!O2MercuryQuery methodsFor: 'actions' stamp: 'PDC 6/29/2007 06:18'!openSearchBrowser	^ self openSearchBrowserOn: self searchNode! !!O2MercuryQuery methodsFor: 'actions' stamp: 'scg 8/24/2009 10:45'!openSearchBrowserOn: searchNode 	^ self browser isSearchBrowser 		ifFalse: [ (O2SearchBrowser with: searchNode) open ]		ifTrue: 			[ self browser root addChild: searchNode.			(self announce: O2AboutToChange) isVetoed 				ifTrue: [ self browser noteChanges ]				ifFalse: [ self announce: (O2SelectingNode node: searchNode) ] ]! !!O2MercuryQuery methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!openSearchInSameBrowserOn: searchNode 	^ self browser isSearchBrowser 		ifFalse: [ (O2SearchBrowser with: searchNode) open ]		ifTrue: 			[ searchNode classes ifEmpty: 				[ self inform: 'Nothing found.'.				^ self ].			self browser navigationPanel addSearchToSmartGroup: searchNode.			(self announce: O2AboutToChange) isVetoed 				ifTrue: [ self browser noteChanges ]				ifFalse: 					[ "self announce: (OBSelectingNode node: searchNode)"					 ] ]! !!O2MercuryQuery methodsFor: 'accessing' stamp: 'PDC 6/29/2007 06:32'!searchNode	self subclassResponsibility ! !!O2MercuryQuery methodsFor: 'initialization' stamp: 'PDC 6/29/2007 06:37'!setRawQuery: aString 	| tokens |	tokens := Scanner new scanTokens: aString.	pattern := tokens at: 1.	isWild := (tokens at: 2 ifAbsent: []) = #*.	^ self! !!O2MercuryQuery methodsFor: 'initialization' stamp: 'PDC 6/29/2007 06:37'!setRawQuery: aString panel: aPanel 	self setRawQuery: aString.	browser := aPanel browser.	^ self! !!O2MetaEdge commentStamp: 'cwp 1/7/2005 23:20' prior: 35458495!An OBMetaEdge is an edge in the browser's metagraph. It represents a message sent to a node to obtain further nodes. It is refered to by the "parent" metanode, and refers to the "child" metanode.iVars:label 		-  a string describing the metaNode, for filters which allow the user 			   to choose which edges to followselector	- when a node is selected by the user, this message will be 			  sent to it to obtain its childrenmetaNode 	- a MetaNode corresponding to the nodes answered by the above message		!!O2MetaEdge class methodsFor: 'as yet unclassified' stamp: 'cwp 2/7/2004 22:35'!label: aString selector: aSelector metaNode: aMetaNode	^ self new setLabel: aString selector: aSelector metaNode: aMetaNode! !!O2MetaEdge class methodsFor: 'as yet unclassified' stamp: 'cwp 5/4/2007 22:53'!selector: aSymbol	^ self selector: aSymbol metaNode: nil! !!O2MetaEdge class methodsFor: 'as yet unclassified' stamp: 'cwp 2/9/2004 22:32'!selector: aSelector metaNode: aMetaNode	^ self new setLabel: aSelector asString selector: aSelector metaNode: aMetaNode! !!O2MetaEdge methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!-> aNode	metaNode := aNode! !!O2MetaEdge methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!/ aString	label := aString! !!O2MetaEdge methodsFor: 'navigation' stamp: 'jk 3/28/2008 13:19'!isDefaultNavigation	^ self navigation isDefaultNavigation! !!O2MetaEdge methodsFor: 'drag and drop' stamp: 'dr 7/7/2009 14:24'!isDropEdge	isDropEdge ifNil: [isDropEdge := false].	^isDropEdge! !!O2MetaEdge methodsFor: 'navigation' stamp: 'dr 9/12/2008 09:55'!isTreeEdge	^ self navigation isTreeNavigation! !!O2MetaEdge methodsFor: 'accessing' stamp: 'cwp 2/7/2004 22:40'!label	^ label! !!O2MetaEdge methodsFor: 'accessing' stamp: 'cwp 2/7/2004 22:40'!metaNode	^ metaNode! !!O2MetaEdge methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!navigateTree	self navigation: O2TreeEdgeNavigation new! !!O2MetaEdge methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!navigation	^ navigation ifNil: [ navigation := O2DefaultEdgeNavigation new ]! !!O2MetaEdge methodsFor: 'accessing' stamp: 'jk 3/26/2008 12:20'!navigation: anObject	navigation := anObject! !!O2MetaEdge methodsFor: 'accessing' stamp: 'jk 3/26/2008 12:34'!nodesForParent: aNode	^ (aNode perform: selector) do: [:ea | ea metaNode: metaNode. ea navigation: self navigation]! !!O2MetaEdge methodsFor: 'printing' stamp: 'lr 11/13/2008 13:38'!printOn: aStream 	aStream		nextPutAll: selector printString;		nextPutAll: '->'.	metaNode shortPrintOn: aStream! !!O2MetaEdge methodsFor: 'accessing' stamp: 'cwp 2/7/2004 22:40'!selector	^ selector! !!O2MetaEdge methodsFor: 'drag and drop' stamp: 'dr 7/7/2009 14:20'!setIsDropEdge	isDropEdge := true! !!O2MetaEdge methodsFor: 'initializing' stamp: 'DamienCassou 12/23/2009 16:36'!setLabel: aString selector: aSelector metaNode: aMetaNode	label := aString.	selector := aSelector.	metaNode := aMetaNode! !!O2MetaNode commentStamp: 'cwp 1/7/2005 23:23' prior: 35459067!A MetaNode represents a hypothetical node in the browser's domain graph.iVars:filterClass			- the class used to filter this hypothetical node's childrencolumnClass		- the class of column used to display this node's childrenedges				- messages that could be sent to the node to obtain childrenactors				- providers of functionality for manipulating the nodedisplaySelector		- the message used to retreive a nodes display name!!O2EnhancementMetaNode methodsFor: 'searching' stamp: 'dr 5/15/2008 14:35'!addSearchNode: aSearchNode    searchNode := aSearchNode! !!O2EnhancementMetaNode methodsFor: 'double-clicking' stamp: 'dr 4/21/2008 10:16'!doubleClickCommandClass    ^doubleClickCommandClass! !!O2EnhancementMetaNode methodsFor: 'double-clicking' stamp: 'dr 9/19/2008 16:22'!doubleClickCommandClass: aCommandClass    doubleClickCommandClass := aCommandClass! !!O2EnhancementMetaNode methodsFor: 'searching' stamp: 'dr 5/15/2008 14:36'!methodSatisfiesQuery: methodRef    searchNode ifNil: [^false].    ^searchNode methodSatisfiesQuery: methodRef! !!O2EnhancementMetaNode methodsFor: 'auto-selecting' stamp: 'dr 2/13/2008 16:15'!shouldUpdateOnAutoSelect    updateOnAutoSelect ifNotNil: [^updateOnAutoSelect].    ^false    ! !!O2EnhancementMetaNode methodsFor: 'auto-selecting' stamp: 'dr 2/13/2008 15:48'!updateOnAutoSelect    updateOnAutoSelect := true    ! !!O2MetaNode class methodsFor: 'instance creation' stamp: 'cwp 3/6/2004 21:06'!named: aString	^ self new name: aString! !!O2MetaNode class methodsFor: 'instance creation' stamp: 'cwp 3/3/2004 23:08'!new	^ self basicNew initialize! !!O2MetaNode methodsFor: 'children' stamp: 'scg 8/24/2009 10:45'!- aSelector 	^ edges add: (O2MetaEdge selector: aSelector)! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!addEdge: anEdge    edges add: anEdge! !!O2MetaNode methodsFor: 'accessing' stamp: 'cwp 5/18/2007 00:20'!addFilter: aFilter	aFilter setMetaNode: self.	filters add: aFilter! !!O2MetaNode methodsFor: 'nodes' stamp: 'cwp 5/7/2007 23:01'!allChildrenForNode: aNode	^ edges gather: [:edge | edge nodesForParent: aNode]! !!O2MetaNode methodsFor: 'accessing' stamp: 'cwp 5/11/2007 00:40'!ancestrySelector	^ ancestrySelector ifNil: [#isDescendantOf:]! !!O2MetaNode methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!ancestrySelector: anObject	ancestrySelector := anObject! !!O2MetaNode methodsFor: 'navigation' stamp: 'scg 8/24/2009 10:45'!anyNavigation	^ self hasDefaultNavigationEdge 		ifTrue: [ O2DefaultEdgeNavigation new ]		ifFalse: [ (self edges at: 1) navigation ]! !!O2MetaNode methodsFor: 'accessing' stamp: 'dr 1/28/2009 15:39'!autoSelect	^ autoSelect! !!O2MetaNode methodsFor: 'accessing' stamp: 'dr 1/28/2009 15:11'!autoSelect: anAutoSelection	autoSelect := anAutoSelection! !!O2MetaNode methodsFor: 'children' stamp: 'scg 8/24/2009 10:45'!childAt: aSelector labeled: aString put: aMetaNode 	^ edges add: (O2MetaEdge 			label: aString			selector: aSelector			metaNode: aMetaNode)! !!O2MetaNode methodsFor: 'children' stamp: 'scg 8/24/2009 10:45'!childAt: aSelector put: aMetaNode 	^ edges add: (O2MetaEdge 			selector: aSelector			metaNode: aMetaNode)! !!O2MetaNode methodsFor: 'nodes' stamp: 'damiencassou 4/17/2009 15:36'!childOf: parent ancestorOf: descendant indexIn: aBlock 	(self childsPerEdgeFor: parent) do: 		[ :childsPerEdge | 			childsPerEdge doWithIndex: 				[ :node :index |					(node isAncestorOf: descendant using: node metaNode ancestrySelector)						ifTrue: [ filters do: [ :f | f noteParent: parent child: node ].					aBlock value: index.				 ^ node ] ] ].	^ nil! !!O2MetaNode methodsFor: 'children' stamp: 'cwp 2/7/2004 22:44'!children	^ edges collect: [:edge | edge metaNode]! !!O2MetaNode methodsFor: 'nodes' stamp: 'dr 3/5/2008 14:11'!childrenForNode: aNode	| chosenEdges | 	chosenEdges := self edgesForNode: aNode.	^ chosenEdges gather: 		[:edge | 		filters 			inject: (edge nodesForParent: aNode)			into: [:list :filter | filter nodesFrom: list forNode: aNode]].! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!childrenFromEdges: aCollection forNode: aNode	^ aCollection gather: 		[:edge | 		filters 			inject: (edge nodesForParent: aNode)			into: [:list :filter | filter nodesFrom: list forNode: aNode]].! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!childrenWithinTreeForNode: aNode 	| chosenEdges |	chosenEdges := self edgesWithTreeNavigationForNode: aNode.	^ self childrenFromEdges: chosenEdges forNode: aNode! !!O2MetaNode methodsFor: 'children' stamp: 'dc 12/15/2007 16:08'!childsPerEdgeFor: aNode 	"collects all childs and returns an array with one list of childs per edge.	all filters are applied to the child lists."	^ edges		collect: [:edge | filters							inject: (edge nodesForParent: aNode)							into: [:list :filter | filter nodesFrom: list forNode: aNode]].! !!O2MetaNode methodsFor: 'nodes' stamp: 'dr 9/17/2008 13:38'!defaultChildrenForNode: aNode 	| chosenEdges |	chosenEdges := self defaultEdgesForNode: aNode.	^ chosenEdges gather: 		[:edge | 		filters 			inject: (edge nodesForParent: aNode)			into: [:list :filter | filter nodesFrom: list forNode: aNode]].! !!O2MetaNode methodsFor: 'metagraph' stamp: 'jk 4/7/2008 11:37'!defaultEdges	^ self edges select: [ :e | e isDefaultNavigation ]! !!O2MetaNode methodsFor: 'accessing' stamp: 'jk 4/7/2008 11:36'!defaultEdgesForNode: aNode 	^ filters 		inject: self defaultEdges		into: [:list :filter | filter edgesFrom: list forNode: aNode].! !!O2MetaNode methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!displaySelector	^ displaySelector ifNil: [displaySelector := #name]! !!O2MetaNode methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!displaySelector: aSelector	displaySelector := aSelector! !!O2MetaNode methodsFor: 'filtering' stamp: 'cwp 5/20/2007 01:51'!displayStringForNode: aNode	^ filters		inject: (aNode perform: self displaySelector)		into: [:string :filter | filter displayString: string forNode: aNode]! !!O2MetaNode methodsFor: 'filtering' stamp: 'cwp 5/20/2007 20:05'!displayStringForParent: pNode child: cNode	^ filters		inject: cNode displayString		into: [:string :filter | filter displayString: string forParent: pNode child: cNode]! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!doubleClickCommandClass    ^nil! !!O2MetaNode methodsFor: 'accessing' stamp: 'dr 5/14/2008 15:16'!edges    ^edges! !!O2MetaNode methodsFor: 'accessing' stamp: 'dr 9/18/2008 11:12'!edgesForNode: aNode      "do not filter tree edges for the moment"	^(edges select: [:ea | ea isTreeEdge]), (filters 		inject: (edges reject: [:ea | ea isTreeEdge]) 		into: [:list :filter | filter edgesFrom: list forNode: aNode]).! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!edgesWithDefaultNavigationForNode: aNode 	| chosenEdges |	chosenEdges := self edgesForNode: aNode.	^chosenEdges select: [:chosenEdge | chosenEdge isDefaultNavigation].! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!edgesWithTreeNavigationForNode: aNode 	| chosenEdges |	chosenEdges := self edgesForNode: aNode.	chosenEdges := chosenEdges select: [:chosenEdge | chosenEdge isTreeEdge].	^ chosenEdges! !!O2MetaNode methodsFor: 'accessing' stamp: 'lr 5/21/2007 13:24'!filters	^ filters! !!O2MetaNode methodsFor: 'children' stamp: 'cwp 2/7/2004 22:38'!hasChildren	^ edges isEmpty not! !!O2MetaNode methodsFor: 'testing' stamp: 'jk 3/26/2008 13:17'!hasDefaultNavigationEdge	^ self edges contains: [ :e | e isDefaultNavigation ]! !!O2MetaNode methodsFor: 'filtering' stamp: 'dr 6/27/2008 14:53'!iconForNode: aNode	^ filters inject: nil into: [:icon :filter | filter icon: icon forNode: aNode]! !!O2MetaNode methodsFor: 'initializing' stamp: 'DamienCassou 12/23/2009 16:36'!initialize	filters := OrderedCollection new.	edges := OrderedCollection new.! !!O2MetaNode methodsFor: 'filtering' stamp: 'cwp 2/9/2004 21:00'!metaNode	^ self! !!O2MetaNode methodsFor: 'accessing' stamp: 'cwp 3/6/2004 21:54'!name	^ name ifNil: ['MetaNode']! !!O2MetaNode methodsFor: 'accessing' stamp: 'DamienCassou 12/23/2009 16:36'!name: aString	name := aString! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!next    ^self edges ifNotEmpty: [(self edges reject: [:edge | edge isTreeEdge]) first metaNode] ifEmpty: [nil]! !!O2MetaNode methodsFor: 'nodes' stamp: 'cwp 3/3/2004 00:22'!nodesForParent: aNode	^ edges gather: [:edge | edge nodesForParent: aNode]! !!O2MetaNode methodsFor: 'nodes' stamp: 'cwp 5/8/2007 00:14'!noteParent: pNode child: cNode	filters do: [:ea | ea noteParent: pNode child: cNode]! !!O2MetaNode methodsFor: 'printing' stamp: 'dvf 8/16/2005 10:01'!printOn: aStream	aStream nextPutAll: self name;cr.	edges do: [:e | e printOn: aStream. aStream cr].! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!removeChildAt: aSymbol    | edge |    edge := edges detect: [:ea | ea name = aSymbol] ifNone: [nil].    edge ifNotNil: [edges remove: edge]! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!removeFilter: aFilter    filters removeAllSuchThat: [:filter | filter class = aFilter class]! !!O2MetaNode methodsFor: 'printing' stamp: 'dvf 8/16/2005 10:01'!shortPrintOn: aStream	aStream nextPutAll: self name.! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!shouldUpdateOnAutoSelect    ^false! !!O2MetaNode methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!supportsDoubleClick    ^self doubleClickCommandClass notNil! !!O2MetaNode methodsFor: 'filtering' stamp: 'cwp 5/18/2007 20:23'!switchFilter	^ filters 		detect: [:ea | ea wantsSwitch]		ifNone: [nil]! !!O2MetaNode methodsFor: '*o2-refactory' stamp: 'DavidRoethlisberger 9/8/2009 23:59'!withAllChildrenDo: aBlock	self withAllChildrenDo: aBlock seen: IdentitySet new! !!O2MetaNode methodsFor: '*o2-refactory' stamp: 'DavidRoethlisberger 9/8/2009 23:59'!withAllChildrenDo: aBlock seen: aSet	(aSet includes: self) ifTrue: [ ^ self ].	aSet add: self.	aBlock value: self.	self edges do: [ :each | each metaNode withAllChildrenDo: aBlock seen: aSet ]! !!O2EnhancementMetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'scg 8/24/2009 10:45'!classMetaNode	^ self metaNodes 		at: #Class		ifAbsentPut: [ O2EnhancementMetaNode named: #Class ]! !!O2EnhancementMetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'scg 8/24/2009 10:45'!lastSelectionMetaNode	^ (self metaNodes 		at: #LastSelection		ifAbsentPut: [ O2EnhancementMetaNode named: #LastSelection ]) updateOnAutoSelect! !!O2EnhancementMetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'scg 8/24/2009 10:45'!metaclassMetaNode	^ self metaNodes 		at: #Metaclass		ifAbsentPut: [ O2EnhancementMetaNode named: #Metaclass ]! !!O2EnhancementMetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'scg 8/24/2009 10:45'!methodMetaNode	^ self metaNodes 		at: #Method		ifAbsentPut: [ O2EnhancementMetaNode named: #Method ]! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateAllMethodCategoryNode	super populateAllMethodCategoryNode.	self allMethodCategoryMetaNode		childAt: #lastSelection			put: self lastSelectionMetaNode;		autoSelect: (O2PreviousWithSingleAutoSelection on: self lastSelectionMetaNode);		addFilter: O2MethodCategoryFilter new! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateClassCommentNode	self classCommentMetaNode		ancestrySelector: #isDescendantOfClass:;		addFilter: O2ClassInheritanceFilter new! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateClassNode	super populateClassNode.	self classMetaNode addFilter: O2ClassInheritanceFilter new! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateMetaclassNode	super populateMetaclassNode.	self metaclassMetaNode addFilter: O2ClassInheritanceFilter new! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateMethodCategoryNode	super populateMethodCategoryNode.	self methodCategoryMetaNode		addFilter: O2MethodCategoryFilter new;		autoSelect: (O2PreviousWithSingleAutoSelection on: self lastSelectionMetaNode);		displaySelector: #fullName! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateMethodNode	self methodMetaNode		ancestrySelector: #isDescendantOfMethod:;		addFilter: O2EnhancementInheritanceFilter new! !!O2EnhancementMetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateRoot	super populateRoot.	self root		removeFilter: O2ClassSortFilter new;		addFilter: O2QueryingClassSortFilter new! !!O2MetagraphBuilder class methodsFor: 'as yet unclassified' stamp: 'PDC 6/27/2007 08:03'!on: root class: classSel comment: commentSel metaclass: metaclassSel	^self new setRoot: root classSel: classSel commentSel: commentSel metaclassSel: metaclassSel! !!O2MetagraphBuilder methodsFor: 'accessing' stamp: 'dc 9/7/2007 11:55'!addMetaNode: aMetaNode	^ self metaNodes		at: aMetaNode name		put: aMetaNode! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:53'!allMethodCategoryMetaNode	^ self metaNode: #AllMethodCategory! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:53'!classCommentMetaNode	^ self metaNode: #ClassComment! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:53'!classMetaNode	^ self metaNode: #Class! !!O2MetagraphBuilder methodsFor: 'accessing - selectors' stamp: 'jk 8/26/2007 18:05'!classSelector	^ self selectorAt: #classSel! !!O2MetagraphBuilder methodsFor: 'accessing - selectors' stamp: 'jk 8/26/2007 18:05'!classSelector: aSelector	^ self selectorAt: #classSel put: aSelector! !!O2MetagraphBuilder methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!classWithUsedTraitsMetaNode	^ self metaNode: 'ClassWithUsedTraits'! !!O2MetagraphBuilder methodsFor: 'accessing - selectors' stamp: 'jk 8/26/2007 18:05'!commentSelector	^ self selectorAt: #commentSel! !!O2MetagraphBuilder methodsFor: 'accessing - selectors' stamp: 'jk 8/26/2007 18:06'!commentSelector: aSelector	^ self selectorAt: #commentSel put: aSelector! !!O2MetagraphBuilder methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!doubleClickCommand    ^nil! !!O2MetagraphBuilder methodsFor: '*o2-enhancements-dynamicprotocols' stamp: 'scg 8/24/2009 10:28'!dynamicProtocolMetaNode	^ self metaNode: 'DynamicProtocols'.! !!O2MetagraphBuilder methodsFor: 'execution' stamp: 'jk 8/26/2007 18:08'!execute	((self class allSelectors select: [:ea | ea beginsWith: 'populate']) asSortedArray)		do: [:selector | self perform: selector].	^ self root! !!O2MetagraphBuilder methodsFor: 'accessing' stamp: 'scg 8/24/2009 10:45'!metaNode: aMetaNodeName 	^ self metaNodes 		at: aMetaNodeName		ifAbsentPut: [ O2MetaNode named: aMetaNodeName ]! !!O2MetagraphBuilder methodsFor: 'accessing' stamp: 'dc 9/7/2007 11:56'!metaNodes	^ metaNodes ifNil: [ metaNodes := IdentityDictionary new]! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:53'!metaclassMetaNode	^ self metaNode: #Metaclass! !!O2MetagraphBuilder methodsFor: 'accessing - selectors' stamp: 'jk 8/26/2007 18:06'!metaclassSelector	^ self selectorAt: #metaclassSel! !!O2MetagraphBuilder methodsFor: 'accessing - selectors' stamp: 'jk 8/26/2007 18:06'!metaclassSelector: aSelector	^ self selectorAt: #metaclassSel put: aSelector! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:53'!methodCategoryMetaNode	^ self metaNode: #MethodCategory! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:53'!methodMetaNode	^ self metaNode: #Method! !!O2MetagraphBuilder methodsFor: 'private' stamp: 'jk 8/26/2007 17:12'!populateAllMethodCategoryNode	self allMethodCategoryMetaNode childAt: #methods put: self methodMetaNode! !!O2MetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateClassNode	self classMetaNode		ancestrySelector: #isDescendantOfClass:;		childAt: #allCategory			put: self allMethodCategoryMetaNode;		childAt: #categories			put: self methodCategoryMetaNode;		autoSelect: (O2AutoSelection on: self allMethodCategoryMetaNode)! !!O2MetagraphBuilder methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!populateConflictMethodFilter	self methodMetaNode addFilter: O2TraitConflictMethodFilter new! !!O2MetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateMetaclassNode	self metaclassMetaNode		ancestrySelector: #isDescendantOfClass:;		childAt: #allCategory			put: self allMethodCategoryMetaNode;		childAt: #categories			put: self methodCategoryMetaNode;		autoSelect: (O2AutoSelection on: self allMethodCategoryMetaNode)! !!O2MetagraphBuilder methodsFor: 'private' stamp: 'jk 8/26/2007 17:13'!populateMethodCategoryNode	self methodCategoryMetaNode 		ancestrySelector: #isDescendantOfMethodCat:;		childAt: #methods put: self methodMetaNode! !!O2MetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateMethodNode	self methodMetaNode		ancestrySelector: #isDescendantOfMethod:;		addFilter: O2InheritanceFilter new! !!O2MetagraphBuilder methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!populateRequiredMethodFilter	self methodMetaNode addFilter: O2TraitRequiredMethodFilter new! !!O2MetagraphBuilder methodsFor: 'private' stamp: 'scg 8/24/2009 10:45'!populateRoot	self root		childAt: self classSelector			labeled: 'instance'			put: self classMetaNode;		childAt: self commentSelector			labeled: '?'			put: self classCommentMetaNode;		childAt: self metaclassSelector			labeled: 'class'			put: self metaclassMetaNode;		addFilter: O2ModalFilter new;		addFilter: O2ClassSortFilter new! !!O2MetagraphBuilder methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:45'!populateTraitFilter	self root 		childAt: self classSelector		labeled: 'traits'		put: self classWithUsedTraitsMetaNode.	self classWithUsedTraitsMetaNode		childAt: #usedTraits			labeled: 'instance'			put: self classMetaNode;		childAt: #commentsOfUsedTraits			labeled: '?'			put: self classCommentMetaNode;		childAt: #metaclassesOfUsedTraits			labeled: 'class'			put: self metaclassMetaNode;		addFilter: O2ModalFilter new;		addFilter: O2TraitSortFilter new! !!O2MetagraphBuilder methodsFor: '*o2-enhancements-dynamicprotocols' stamp: 'scg 8/24/2009 10:45'!populateZDynamicProtocols	O2DynamicProtocols areDynamicProtocolsActivated ifTrue: 		[ | protocols |		protocols := self dynamicProtocolMetaNode.		self classMetaNode 			childAt: #dynamicProtocols			put: protocols.		self metaclassMetaNode 			childAt: #dynamicProtocols			put: protocols.		protocols 			childAt: #methods			put: self methodMetaNode ]! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'jk 8/26/2007 16:54'!root	^ root! !!O2MetagraphBuilder methodsFor: 'accessing - metanodes' stamp: 'dc 9/7/2007 11:56'!root: rootMetaNode 	root := rootMetaNode.	self addMetaNode: rootMetaNode! !!O2MetagraphBuilder methodsFor: 'accessing' stamp: 'jk 8/26/2007 17:58'!selectorAt: aSelector 	^ self selectors at: aSelector! !!O2MetagraphBuilder methodsFor: 'accessing' stamp: 'jk 8/26/2007 17:59'!selectorAt: aKey put: aValue	^ self selectors at: aKey put: aValue! !!O2MetagraphBuilder methodsFor: 'accessing' stamp: 'jk 8/26/2007 17:49'!selectors	^ selectors ifNil: [ selectors := Dictionary new.]! !!O2MetagraphBuilder methodsFor: 'initialization' stamp: 'jk 8/26/2007 18:02'!setRoot: rootNode classSel: classSelector commentSel: commentSelector metaclassSel: metaclassSelector 	self root: rootNode.	self classSelector: classSelector.	self commentSelector: commentSelector.	self metaclassSelector: metaclassSelector.	^ self! !!O2MethodVersion commentStamp: 'cwp 1/8/2005 13:25' prior: 35459563!OBMethodVerison represents a version of a method found in the .sources or .changes files. It provides methods for parsing the method definition referenced by a source pointer, and for filing in the source to replace the current version of the method.!!O2MethodVersion class methodsFor: 'instance creation'!fromSources: sources andPointer: pointer	^ self new setSources: sources pointer: pointer! !!O2MethodVersion class methodsFor: 'scanning' stamp: 'PDC 6/29/2007 06:55'!scan: sources from: pointer 	| versions current |		versions := OrderedCollection new.	current := self fromSources: sources andPointer: pointer.	[current notNil]		whileTrue: [versions add: current.					current := current previous].	^ versions! !!O2MethodVersion class methodsFor: 'scanning'!versionsOfMethod: methodReference 	| class selector |	class := methodReference actualClass.	selector := methodReference methodSymbol.	^ self scan: SourceFiles from: (class compiledMethodAt: selector) sourcePointer! !!O2MethodVersion methodsFor: 'comparing' stamp: 'cwp 10/17/2004 23:45'!= other	^ self species = other species and: [self pointer = other pointer]! !!O2MethodVersion methodsFor: 'accessing'!category	^ category! !!O2MethodVersion methodsFor: 'accessing'!classSymbol	^ classRef name! !!O2MethodVersion methodsFor: 'compiling'!fileIn	(self theClass) ifNotNilDo: [:class | class						 				compile: self source 										classified: self category 										withStamp: self stamp 										notifying: nil]												! !!O2MethodVersion methodsFor: 'comparing' stamp: 'cwp 10/17/2004 23:45'!hash	^ pointer hash! !!O2MethodVersion methodsFor: 'accessing' stamp: 'cwp 10/17/2004 23:51'!latest	^ self class 			fromSources: sources 			andPointer: (classRef theClass compiledMethodAt: selector) sourcePointer! !!O2MethodVersion methodsFor: 'initializing' stamp: 'scg 8/24/2009 10:45'!parseChunk: aString 	| tokens |	tokens := Scanner new scanTokens: aString.	classRef := O2ClassReference named: tokens first.	tokens second = #class 		ifTrue: 			[ classRef beMeta.			category := tokens fourth.			stamp := tokens sixth ]		ifFalse: 			[ category := tokens third.			tokens size > 3 ifTrue: [ stamp := tokens fifth ] ].	tokens size > 6 ifTrue: [ prior := tokens last ]! !!O2MethodVersion methodsFor: 'initializing' stamp: 'PDC 6/25/2007 21:58'!parseSource	| file position chunk |	file := sources at: (sources fileIndexFromSourcePointer: pointer).	position := sources filePositionFromSourcePointer: pointer.	chunk := ''.	position > file size ifTrue: [self error: 'Invalid source pointer'].		file position: (0 max: position-150).  	"Skip back to before the preamble"		[file position < (position-1)]  	"then pick it up from the front"			whileTrue: [chunk := file nextChunk].		self parseChunk: chunk.! !!O2MethodVersion methodsFor: 'accessing' stamp: 'cwp 10/17/2004 23:42'!pointer	^ pointer! !!O2MethodVersion methodsFor: 'initializing' stamp: 'dr 12/13/2008 17:37'!previous	^(prior notNil and: [prior > 0]) ifTrue: [self class fromSources: sources andPointer: prior]! !!O2MethodVersion methodsFor: 'accessing'!selector	^ selector ifNil: [self setSelector]! !!O2MethodVersion methodsFor: 'initializing'!setSelector	| file |	file := sources at: (sources fileIndexFromSourcePointer: pointer).	file position: (sources filePositionFromSourcePointer: pointer).	^ selector := Parser new parseSelector: file nextChunk.! !!O2MethodVersion methodsFor: 'initializing'!setSources: aSourceFileArray pointer: aSourcePointer	sources := aSourceFileArray.	pointer := aSourcePointer.	self parseSource.! !!O2MethodVersion methodsFor: 'accessing'!source	| file |	file := sources at: (sources fileIndexFromSourcePointer: pointer).	file position: (sources filePositionFromSourcePointer: pointer).	^ file nextChunk asText makeSelectorBold! !!O2MethodVersion methodsFor: 'accessing'!stamp	^ stamp! !!O2MethodVersion methodsFor: 'accessing'!theClass	^ classRef theClass! !!O2MethodVersion methodsFor: 'accessing'!theClassName	^ classRef name! !!O2MorphicIcons commentStamp: 'lr 7/10/2009 11:12' prior: 35459876!Most of these icons come from http://www.famfamfam.com/lab/icons. They are licensed under the Creative Commons Attribution 3.0 License by Mark James.!!O2MorphicIcons class methodsFor: 'as yet unclassified' stamp: 'dr 9/4/2008 16:34'!default   Instance ifNil: [Instance := self new].   ^Instance! !!O2MorphicIcons class methodsFor: 'as yet unclassified' stamp: 'dr 9/4/2008 16:35'!iconActionNamed: aSymbol    | selector |     selector := (aSymbol, 'Action') asSymbol.	^(self default respondsTo: selector) ifTrue: [self default perform: selector] ifFalse: [nil]! !!O2MorphicIcons class methodsFor: 'configuration' stamp: 'dr 9/4/2008 16:16'!iconHeight    ^12! !!O2MorphicIcons class methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!iconImporter    | image stream |    image := ColorForm fromFileNamed: '/Users/davidroethlisberger/Pictures/roethlis/icons/samuel/overriddenAndSuperNoSuperMethod.png'.    stream := WriteStream with: String new.    image storeOn: stream.    stream contents.! !!O2MorphicIcons class methodsFor: 'as yet unclassified' stamp: 'dr 9/4/2008 16:35'!iconLabelNamed: aSymbol	^ IconLabels at: aSymbol ifAbsentPut: [self default perform: (aSymbol, 'Label') asSymbol]! !!O2MorphicIcons class methodsFor: 'as yet unclassified' stamp: 'dr 9/4/2008 16:35'!iconNamed: aSymbol	^ Icons at: aSymbol ifAbsentPut: [self default perform: aSymbol]! !!O2MorphicIcons class methodsFor: 'configuration' stamp: 'dr 9/4/2008 16:16'!iconWidth    ^12! !!O2MorphicIcons class methodsFor: 'as yet unclassified' stamp: 'dr 9/4/2008 16:33'!initialize	Icons := IdentityDictionary new.	IconLabels := IdentityDictionary new.! !!O2MorphicIcons methodsFor: 'icons' stamp: 'dr 9/25/2008 16:22'!abstractWithOverride	^(Form	extent: 10@7	depth: 32	fromArray: #( 16777215 620793087 4177563391 4227894783 4244671999 4261449215 4278226175 4261448959 738233599 16777215 16777215 134253823 4009791999 4278251007 4278255615 4278255615 4278251775 4060123647 184585471 16777215 16777215 16777215 1979748351 4093686783 4278255615 4278255615 4127242495 2181075199 16777215 16777215 16777215 16777215 184585471 4043346431 4278251775 4278252799 4093678079 268471551 16777215 16777215 16777215 16777215 16777215 2130743551 4127241983 4160798463 2399179263 16777215 16777215 16777215 16777215 16777215 16777215 251694335 4093678079 4110455295 369134847 16777215 16777215 16777215 16777215 16777215 16777215 16777215 1879086079 2130744831 16777215 16777215 16777215 16777215)	offset: 0@0)! !!O2MorphicIcons methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!abstractWithOverrideAction	^self overridd