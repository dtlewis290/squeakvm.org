7 4294935040 4294950656 4294950656 4294935040 4294960327 4294960327 4294935040 4294950656 4294950656 4294935040 4294960844 4294835709 4294835709 4294835709 4294944570 4294939648 4294939648 4294944570 4294901502 4294944568 4294939904 4294957312 4294957312 4294939904 4294945601 4294901502 4294769916 4294769916 4294960584 4294935040 4294935040 4294967295 4294960326 4294935040 4294950656 4294957312 4294957312 4294950656 4294935040 4294961358 4294769916 4294769916 4294769916 4294946378 4294946121 4294967295 4294944310 4294939904 4294957312 4294957312 4294957312 4294957312 4294939904 4294945602 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294935040 4294950400 4294956800 4294956800 4294956800 4294956800 4294950400 4294935040 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294935040 4294935040 4294935040 4294935040 4294935040 4294935040 4294935040 4294935040 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295)	offset: 0@0)! !!O2MorphicIcons methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 11:29'!overriddenAndOverridesAction	^ 	[ :node :column | 	| superclasses subclasses class subFilter superFilter values labels |	superclasses := O2ClassAwareNode sortHierarchicallyOptimized: node findOverriddenClasses.	subclasses := O2ClassAwareNode sortHierarchicallyOptimized: node findOverriddingClasses.	values := (OrderedCollection with: nil)		addAll: superclasses;		add: nil;		add: nil;		addAll: subclasses;		yourself.	superFilter := O2ClassSortFilter new		nodesFrom: superclasses			forNode: nil;		yourself.	subFilter := O2ClassSortFilter new		nodesFrom: subclasses			forNode: nil;		yourself.	labels := OrderedCollection with: 'Overridden Classes:'.	superclasses collect: 		[ :ea | 		labels add: (superFilter 				displayString: ea name				forParent: nil				child: ea) ].	labels		add: ' ';		add: 'Overridding Classes:'.	subclasses collect: 		[ :ea | 		labels add: (subFilter 				displayString: ea name				forParent: nil				child: ea) ].	class := O2ChoiceRequest 		prompt: 'Open method in...'		labels: labels		values: values		lines: {  1. (superclasses size + 3)  }.	class ifNotNil: 		[ column panel jumpTo: (MethodReference 				class: class				selector: node selector) asO2Node ] ]! !!O2MorphicIcons methodsFor: 'icons' stamp: 'dr 9/1/2008 16:02'!overriddenAndOverridesLabel	^'Method overrides and is overridden'! !!O2MorphicIcons methodsFor: 'icons' stamp: 'dr 9/1/2008 16:02'!overriddenLabel	^'Method is overridden in subclasses'! !!O2MorphicIcons methodsFor: 'icons' stamp: 'dr 12/1/2008 10:29'!overrides	^(Form	extent: 14@14	depth: 32	fromArray: #( 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294967295 4294769916 4294769916 4294769916 4294769916 4294946378 4294946121 4294769916 4294769916 4294769916 4294769916 4294967295 4294967295 4294967295 4294967295 4294769916 4294769916 4294769916 4294960584 4294935040 4294935040 4294960843 4294769916 4294769916 4294769916 4294967295 4294967295 4294967295 4294967295 4294835709 4294835709 4294835709 4294944570 4294939648 4294939648 4294945087 4294835709 4294835709 4294835709 4294967295 4294967295 4294967295 4294967295 4294835709 4294835709 4294960327 4294935040 4294950656 4294950656 4294935040 4294960844 4294835709 4294835709 4294967295 4294967295 4294967295 4294967295 4294901502 4294901502 4294944568 4294939904 4294957312 4294957312 4294939904 4294945601 4294901502 4294901502 4294967295 4294967295 429496729