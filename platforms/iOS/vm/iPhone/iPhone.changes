! !!O2CmdBrowseHierarchy methodsFor: 'accessing' stamp: 'dc. 12/15/2007 15:46'!keystroke	^ $h! !!O2CmdBrowseHierarchy methodsFor: 'accessing' stamp: 'cwp 10/11/2006 00:05'!label	^ 'browse hierarchy'! !!O2CmdBrowseHierarchy methodsFor: 'accessing' stamp: 'dc 8/26/2008 17:49'!longDescription  ^ 'browse the hierarchy of the class'! !!O2EnhancementCmdBrowseHierarchy methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| browserClass |	browserClass := O2CodeBrowser defaultHierarchyBrowserClass.	target isMethodNode 		ifTrue: 			[ browserClass 				openOnClass: target theClass				selector: target selector ]		ifFalse: [ browserClass openOnClass: target theClass ]! !!O2CmdBrowseImplementorsOfIt class methodsFor: 'as yet unclassified' stamp: 'cwp 10/16/2006 22:13'!takesNodes	^ false! !!O2CmdBrowseImplementorsOfIt class methodsFor: 'as yet unclassified' stamp: 'cwp 10/16/2006 22:01'!takesText	^ true! !!O2CmdBrowseImplementorsOfIt methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| node |	node := O2SelectorNode on: target selector.	(requestor announce: (O2ShowImplementors of: node)) execute! !!O2CmdBrowseImplementorsOfIt methodsFor: 'testing' stamp: 'cwp 10/16/2006 21:32'!isActive	^ true! !!O2CmdBrowseImplementorsOfIt methodsFor: 'testing' stamp: 'cwp 10/16/2006 23:14'!isEnabled	^ target hasSelector! !!O2CmdBrowseImplementorsOfIt methodsFor: 'accessing' stamp: 'cwp 3/11/2007 19:53'!keystroke	^ $m! !!O2CmdBrowseImplementorsOfIt methodsFor: 'accessing' stamp: 'cwp 3/11/2007 19:52'!label	^ 'implementors'! !!O2CmdBrowseInheritance methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!cluster	^#browse! !!O2CmdBrowseInheritance methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	O2InheritanceBrowser 		openRoot: target inheritanceRoot		selection: target! !!O2CmdBrowseInheritance methodsFor: 'accessing' stamp: 'cwp 10/17/2006 21:30'!group	^ #navigation! !!O2CmdBrowseInheritance methodsFor: 'testing' 