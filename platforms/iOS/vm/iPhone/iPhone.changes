		[updateNumberString := UIManager default						request: 'Error: ', localFileName, ' has no valid Latest Update number in its header. Please enter the estimated update number (e.g. 4332).' translated.		(updateNumberString isEmptyOrNil or:	[updateNumberString asInteger isNil])			ifTrue: [^ self canceledConflictChecking.]].	updateNumber := updateNumberString asInteger.	imageUpdateNumber := SystemVersion current highestUpdate.	updateNumber > imageUpdateNumber ifTrue:		[(self confirm: 'Warning: The update number for this file (#', updateNumberString, ')is greater than the highest update number for this image (#', imageUpdateNumber asString, ').This probably means you need to update your image.Should we proceed anyway as if the file update number is #', imageUpdateNumber asString, '?')			ifTrue:				[updateNumber := imageUpdateNumber.				updateNumberString := imageUpdateNumber asString]			ifFalse: [^ self canceledConflictChecking]].	updateNumberChangeSet := self findUpdateChangeSetMatching: updateNumber.	updateNumberChangeSet ifNil: [^ self canceledConflictChecking: 'No update set found matching ',updateNumber asString].	self currentWorld findATranscript: self currentEvent.	self class logCr; logCr; log: 'Checking ', localFileName, ' (#', updateNumberString, ') for method conflicts with changesets after ', updateNumberChangeSet name, ' ...'.	conflicts := OrderedCollection new.	self classes values do: [:pseudoClass |		(Array with: pseudoClass with: pseudoClass metaClass) do: [:classOrMeta |			classOrMeta selectors do: [:selector | | conflict |				conflict := self							checkForMoreRecentUpdateThanChangeSet: updateNumberChangeSet							pseudoClass: classOrMeta							selector: selector.				conflict ifNotNil: [conflicts add: conflict].			].		].	].	self class logCr; log: conflicts size asString, (' conflict' asPluralBasedOn: conflicts), ' found.'; logCr.	self class closeLog.	^ conflicts! !!TraitTest methodsFor: 'testing' stamp: 'AdrianLienhard 11/3/2009 21:34' prior: 31519669!testLocalMethodWithSameCodeInTrait	"Test whether there are no unintentional overridden traits methods"	SystemNavigation default allBehaviorsDo: [ :each |		each hasTraitComposition ifTrue: [			each methodDict keys do: [ :selector |				(each includesLocalSelector: selector) ifTrue: [					(each traitComposition traitProvidingSelector: selector) ifNotNil: [ :trait |						(trait selectors includes: selector) ifTrue: [							self deny: (trait >> selector = (each >> selector)) ] ] ] ] ] ]! !StandardSystemFontsTest removeSelector: #testRestoreDefaultFonts!LocaleTest removeSelector: #testIsFontAvailable!TestIndenting removeSelector: #testSetUp!TestIndenting removeSelector: #testNewLineStartsIndentedWhenWrapped!ObjectFinalizerTests removeSelector: #expectedFailures!FontTest removeSelector: #testResetAfterEmphasized!FontTest removeSelector: #testParagraphFallback!FontTest removeSelector: #testFallback!"System-FilePackage"!"Tests"!"Postscript:Leave the line above, and replace the rest of this comment by a useful one.Executable statements should follow this comment, and shouldbe separated by periods, with no exclamation points (!!).Be sure to put any further comments in double-quotes, like this one."|repository|repository := MCHttpRepository                location: 'http://www.squeaksource.com/Pharo/'                user: ''                password: ''.(repository loadVersionFromFileNamed:'ScriptLoader-AdrianLienhard.1131.mcz') load.ScriptLoader new update10493.!----End fileIn of a stream----!!ScriptLoader methodsFor: 'public' stamp: 'AdrianLienhard 11/6/2009 21:09' prior: 33587160!commentForCurrentUpdate	^'- Issue 1408:	SharedQueue2 doesNotUnderstand: #flushAllSuchThat:- Issue 1409:	update gofer	- Issue 1379:	Sometimes my author names ends up being "TestRunner"- Issue 1345:	Revert Number class>>readFrom: (was integrated with issue 1258): also make the tests reflect the original semantics