t selectorAndMessages.	messagesSent size = 1 		ifFalse: 			[ messageNode := O2ChoiceRequest 				prompt: nil				labels: (messagesSent collect: [ :ea | ea name ])				values: messagesSent				lines: #(1 ).			messageNode ifNil: [ ^ self ] ]		ifTrue: [ messageNode := messagesSent first ].	(requestor announce: (self announcementClass of: messageNode unifySelectors)) execute! !!O2CmdBrowseList methodsFor: 'command' stamp: 'dr 7/2/2007 15:12'!group	^ #navigation! !!O2CmdBrowseList methodsFor: '*o2-enhancements' stamp: 'scg 8/24/2009 10:28'!implementorsSelector    ^#implementorsOf:! !!O2CmdBrowseList methodsFor: 'command' stamp: 'dr 7/2/2007 15:15'!isActive	^ target hasSelector and: [requestor isSelected: target]! !!O2CmdBrowseSenders methodsFor: 'configuration' stamp: 'scg 8/24/2009 10:45'!announcementClass	^ O2ShowSenders! !!O2CmdBrowseSenders methodsFor: 'command' stamp: 'cwp 10/11/2006 20:35'!keystroke	^ $n! !!O2CmdBrowseSenders methodsFor: 'accessing' stamp: 'cwp 10/11/2006 20:32'!label	^ 'senders'! !!O2CmdBrowseSenders methodsFor: 'accessing' stamp: 'dc 8/26/2008 17:52'!longDescription  ^ 'browse senders of...'! !!O2CmdBrowseMethodImplementor methodsFor: 'accessing' stamp: 'dr 4/27/2009 16:24'!cluster	^#browse! !!O2CmdBrowseMethodImplementor methodsFor: 'execution' stamp: 'scg 8/24/2009 10:45'!execute	| class |	class := target theClass traitOrClassOfSelector: target selector.	(O2MethodNode 		on: target selector		inClass: class) browse! !!O2CmdBrowseMethodImplementor methodsFor: 'accessing' stamp: 'jk 6/20/2007 16:34'!group	^ #navigation! !!O2CmdBrowseMethodImplementor methodsFor: 'testing' stamp: 'scg 8/24/2009 10:45'!isActive	^ (target isKindOf: O2MethodNode) and: [ requestor isSelected: target ]! !!O2CmdBrowseMethodImplementor methodsFor: 'accessing' stamp: 'jk 6/20/2007 16:38'!keystroke	^ $M! !!O2CmdBrowseMethodImplementor methodsFor: 'accessing' stamp: 'jk 6/20/2007 16:27'!label	^ 'browse method implementor'! !!O